generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  // URL is configured in prisma.config.ts (Prisma 7 — not in schema.prisma)
  // To switch to PostgreSQL: see docs/architecture/POSTGRES_MIGRATION.md
}

// ── Auth Wall (Auth.js v5 + Prisma Adapter) ─────────────────────────────────
//
// Standard Auth.js models + custom fields (hashedPassword, role).
// Session strategy is JWT so the Session model is only needed if we later
// switch to database sessions (e.g. for OAuth providers).

model User {
  id             String    @id @default(cuid())
  name           String?
  email          String    @unique
  emailVerified  DateTime?
  image          String?
  hashedPassword String?
  role           String    @default("estimator") // admin | estimator | pm
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  accounts Account[]
  sessions Session[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Trade {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  costCode    String?
  csiCode     String?
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  bidTrades            BidTrade[]
  subTrades            SubcontractorTrade[]
  scopeItems           ScopeItem[]
  tradeAssignments     ScopeTradeAssignment[]
  preferredSubs        PreferredSub[]
  levelingRows         LevelingRow[]
  specSections         SpecSection[]          @relation("SpecSectionTrade")
  matchedSpecSections  SpecSection[]          @relation("MatchedSpecSection")
  drawingSheets        DrawingSheet[]         @relation("DrawingSheetTrade")
  matchedDrawingSheets DrawingSheet[]         @relation("MatchedDrawingSheet")
}

model Bid {
  id                  Int         @id @default(autoincrement())
  projectName         String
  location            String?
  description         String?
  scope               String      @default("")
  status              String      @default("draft")
  workflowType        String      @default("BID") // "BID" | "PROJECT"
  projectType         ProjectType @default(PRIVATE)
  dueDate             DateTime?
  complianceChecklist String?
  createdById         String? // Auth Wall — nullable, backfill to user 1 when multi-tenant
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt

  // Module INT1 — Job Intake (Wing 1 project context capture)
  // String fields validated in API layer rather than enum (SQLite-friendly).
  // Valid deliveryMethod: HARD_BID, DESIGN_BUILD, CM_AT_RISK, NEGOTIATED
  // Valid ownerType:      PUBLIC_ENTITY, PRIVATE_OWNER, DEVELOPER, INSTITUTIONAL
  deliveryMethod     String?
  ownerType          String?
  buildingType       String?
  approxSqft         Int?
  stories            Int?
  ldAmountPerDay     Float?
  ldCapAmount        Float?
  occupiedSpace      Boolean @default(false)
  phasingRequired    Boolean @default(false)
  siteConstraints    String?
  estimatorNotes     String?
  scopeBoundaryNotes String?
  veInterest         Boolean @default(false)
  dbeGoalPercent     Float?

  // Module H4 — Schedule Seed
  constructionStartDate DateTime?
  projectDurationDays   Int?

  // Module H6 — Budget Creation
  // JSON: Array<{ label: string; costCode: string; amount: number }>
  budgetGcLines String?

  // Tier F F2 — Procore REST API
  procoreProjectId String?

  bidTrades             BidTrade[]
  selections            BidInviteSelection[]
  exportBatches         ExportBatch[]
  scopeItems            ScopeItem[]
  aiExportBatches       AiExportBatch[]
  gapFindings           AiGapFinding[]
  outreachLogs          OutreachLog[]
  estimateUploads       EstimateUpload[]
  levelingSession       LevelingSession?
  generatedQuestions    GeneratedQuestion[]
  specBooks             SpecBook[]
  drawingUploads        DrawingUpload[]
  addendums             AddendumUpload[]
  intelligenceBrief     BidIntelligenceBrief?
  submission            BidSubmission?
  buyoutItems           BuyoutItem[]
  submittalItems        SubmittalItem[]
  submittalPackages     SubmittalPackage[]
  distributionTemplates SubmittalDistributionTemplate[]
  projectContacts       ProjectContact[]
  scheduleActivities    ScheduleActivity[]
  schedules             Schedule[]
  meetings              Meeting[]
  meetingActionItems    MeetingActionItem[]
  decisions             BidDecision[]
  procorePushes         ProcorePush[]
  rfiItems              RfiItem[]
  backgroundJobs        BackgroundJob[]
  marketLeads           MarketLead[]
}

model BidSubmission {
  id           Int      @id @default(autoincrement())
  bidId        Int      @unique
  submittedAt  DateTime @default(now())
  submittedBy  String?
  ourBidAmount Float?
  notes        String?

  // Frozen snapshots (JSON)
  briefSnapshot        String?
  questionSnapshot     String?
  complianceSnapshot   String?
  spreadSnapshot       String?
  gateSnapshot         String?
  intelligenceSnapshot String?

  // Outcome fields (D2)
  outcome          String?
  outcomeAt        DateTime?
  winningBidAmount Float?
  ourRank          Int?
  totalBidders     Int?
  lostReason       String?
  lostReasonNote   String?
  lessonsLearned   String?
  outcomeNotes     String?

  bid Bid @relation(fields: [bidId], references: [id])
}

model BidTrade {
  id               Int       @id @default(autoincrement())
  bidId            Int
  tradeId          Int
  scopeNotes       String?
  tier             String    @default("TIER2")
  leadTimeDays     Int?
  rfqSentAt        DateTime?
  quotesReceivedAt DateTime?
  rfqNotes         String?

  bid                   Bid                             @relation(fields: [bidId], references: [id])
  trade                 Trade                           @relation(fields: [tradeId], references: [id])
  buyoutItem            BuyoutItem?
  submittalItems        SubmittalItem[]
  submittalPackages     SubmittalPackage[]
  distributionTemplates SubmittalDistributionTemplate[]
  scheduleActivities    ScheduleActivity[]

  @@unique([bidId, tradeId])
}

// Module H2 — Buyout Tracker
// One BuyoutItem per BidTrade. Auto-created on first read of the buyout
// endpoint, then updated via PATCH as the estimator works through buyout.
// contractStatus values (validated in API, not enum for SQLite friendliness):
//   PENDING | LOI_SENT | CONTRACT_SENT | CONTRACT_SIGNED | PO_ISSUED | ACTIVE | CLOSED
model BuyoutItem {
  id              Int  @id @default(autoincrement())
  bidId           Int
  bidTradeId      Int  @unique
  subcontractorId Int?

  // Commitment
  committedAmount   Float?
  originalBidAmount Float?

  // Contract lifecycle
  contractStatus   String    @default("PENDING")
  loiSentAt        DateTime?
  contractSentAt   DateTime?
  contractSignedAt DateTime?
  poNumber         String?
  poIssuedAt       DateTime?

  // Financial tracking
  changeOrderAmount Float? @default(0)
  paidToDate        Float? @default(0)
  retainagePercent  Float? @default(5)

  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  bid           Bid            @relation(fields: [bidId], references: [id], onDelete: Cascade)
  bidTrade      BidTrade       @relation(fields: [bidTradeId], references: [id], onDelete: Cascade)
  subcontractor Subcontractor? @relation(fields: [subcontractorId], references: [id])

  @@index([bidId])
  @@index([subcontractorId])
}

model Subcontractor {
  id        Int      @id @default(autoincrement())
  company   String
  office    String?
  status    String   @default("active")
  notes     String?
  isUnion   Boolean  @default(false)
  isMWBE    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tier           String    @default("new")
  projectTypes   String    @default("")
  region         String?
  lastBidDate    DateTime?
  internalNotes  String?
  doNotUse       Boolean   @default(false)
  doNotUseReason String?

  // INTERNAL ONLY — never expose in AI prompts, recipient exports, or sub-facing artifacts
  isPreferred     Boolean @default(false)
  // External system reference (Procore vendor id) — used for re-import dedup
  procoreVendorId String? @unique

  contacts           Contact[]
  subTrades          SubcontractorTrade[]
  selections         BidInviteSelection[]
  outreachLogs       OutreachLog[]
  preferredForTrades PreferredSub[]
  estimateUploads    EstimateUpload[]
  buyoutItems        BuyoutItem[]
  submittalItems     SubmittalItem[]
}

model SubcontractorTrade {
  id              Int @id @default(autoincrement())
  subcontractorId Int
  tradeId         Int

  subcontractor Subcontractor @relation(fields: [subcontractorId], references: [id])
  trade         Trade         @relation(fields: [tradeId], references: [id])

  @@unique([subcontractorId, tradeId])
}

model Contact {
  id              Int      @id @default(autoincrement())
  subcontractorId Int
  name            String
  email           String?
  phone           String?
  title           String?
  isPrimary       Boolean  @default(false)
  createdAt       DateTime @default(now())

  subcontractor Subcontractor @relation(fields: [subcontractorId], references: [id])
  outreachLogs  OutreachLog[]
}

model BidInviteSelection {
  id              Int      @id @default(autoincrement())
  bidId           Int
  subcontractorId Int
  tradeId         Int?
  notes           String?
  createdAt       DateTime @default(now())

  rfqStatus          String    @default("no_response")
  invitedAt          DateTime?
  estimateReceivedAt DateTime?
  estimateFileName   String?
  followUpCount      Int       @default(0)
  selectionNotes     String?

  bid           Bid           @relation(fields: [bidId], references: [id])
  subcontractor Subcontractor @relation(fields: [subcontractorId], references: [id])
}

model PreferredSub {
  id              Int      @id @default(autoincrement())
  tradeId         Int
  subcontractorId Int
  createdAt       DateTime @default(now())

  trade         Trade         @relation(fields: [tradeId], references: [id])
  subcontractor Subcontractor @relation(fields: [subcontractorId], references: [id])

  @@unique([tradeId, subcontractorId])
}

model ScopeItem {
  id          Int      @id @default(autoincrement())
  bidId       Int
  tradeId     Int?
  description String
  inclusion   Boolean  @default(true)
  specSection String?
  drawingRef  String?
  notes       String?
  riskFlag    Boolean  @default(false)
  restricted  Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  bid              Bid                    @relation(fields: [bidId], references: [id])
  trade            Trade?                 @relation(fields: [tradeId], references: [id])
  tradeAssignments ScopeTradeAssignment[]
}

model ScopeTradeAssignment {
  id          Int      @id @default(autoincrement())
  scopeItemId Int
  tradeId     Int
  isPrimary   Boolean  @default(false)
  notes       String?
  createdAt   DateTime @default(now())

  scopeItem ScopeItem @relation(fields: [scopeItemId], references: [id])
  trade     Trade     @relation(fields: [tradeId], references: [id])

  @@unique([scopeItemId, tradeId])
}

model ExportBatch {
  id         Int      @id @default(autoincrement())
  bidId      Int
  exportedAt DateTime @default(now())
  rowCount   Int
  fileName   String

  bid Bid @relation(fields: [bidId], references: [id])
}

model AiExportBatch {
  id              Int       @id @default(autoincrement())
  bidId           Int
  exportedBy      String?
  approvedBy      String?
  approvedAt      DateTime?
  restrictedCount Int       @default(0)
  status          String    @default("complete")
  createdAt       DateTime  @default(now())

  bid         Bid            @relation(fields: [bidId], references: [id])
  gapFindings AiGapFinding[]
}

model AiGapFinding {
  id              Int      @id @default(autoincrement())
  bidId           Int
  aiExportBatchId Int?
  tradeName       String?
  title           String?
  findingText     String
  sourceRef       String?
  confidence      String?
  severity        String?
  sourceDocument  String?
  status          String   @default("pending_review")
  reviewNotes     String?
  createdAt       DateTime @default(now())

  bid                Bid                 @relation(fields: [bidId], references: [id])
  aiExportBatch      AiExportBatch?      @relation(fields: [aiExportBatchId], references: [id])
  generatedQuestions GeneratedQuestion[]
}

model GeneratedQuestion {
  id            Int         @id @default(autoincrement())
  rfiNumber     Int?
  gapFindingId  Int?
  bidId         Int?
  levelingRowId Int?
  tradeName     String?
  questionText  String
  isInternal    Boolean     @default(true)
  status        RfiStatus   @default(OPEN)
  priority      RfiPriority @default(MEDIUM)
  approvedAt    DateTime?
  sentAt        DateTime?
  responseText  String?
  respondedAt   DateTime?
  respondedBy   String?
  impactFlag    Boolean     @default(false)
  impactNote    String?
  sourceRef     String?
  dueDate       DateTime?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  gapFinding   AiGapFinding? @relation(fields: [gapFindingId], references: [id])
  bid          Bid?          @relation(fields: [bidId], references: [id])
  levelingRow  LevelingRow?  @relation(fields: [levelingRowId], references: [id])
  outreachLogs OutreachLog[]
}

model OutreachLog {
  id              Int       @id @default(autoincrement())
  bidId           Int
  subcontractorId Int?
  contactId       Int?
  questionId      Int?
  channel         String?
  status          String    @default("exported")
  sentAt          DateTime?
  respondedAt     DateTime?
  responseNotes   String?
  followUpDue     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // Module H8 — plain-string recipient for notifications where the FK
  // target isn't a sub Contact (e.g. ProjectContact rows for internal notifications).
  recipientEmail String?

  // Email delivery tracking (Module RFQ1)
  // deliveryStatus values (validated in API): QUEUED, SENT, DELIVERED, OPENED, BOUNCED, FAILED
  emailMessageId String?
  deliveryStatus String?
  openedAt       DateTime?
  bouncedAt      DateTime?
  bounceReason   String?

  bid           Bid                @relation(fields: [bidId], references: [id])
  subcontractor Subcontractor?     @relation(fields: [subcontractorId], references: [id])
  contact       Contact?           @relation(fields: [contactId], references: [id])
  question      GeneratedQuestion? @relation(fields: [questionId], references: [id])

  @@index([emailMessageId])
}

enum ProjectType {
  PUBLIC
  PRIVATE
  NEGOTIATED
}

enum RfiStatus {
  OPEN
  SENT
  ANSWERED
  CLOSED
  NO_RESPONSE
}

enum RfiPriority {
  CRITICAL
  HIGH
  MEDIUM
  LOW
}

enum ParseStatus {
  pending
  processing
  complete
  failed
}

model EstimateUpload {
  id                 Int         @id @default(autoincrement())
  bidId              Int
  subcontractorId    Int
  fileName           String
  fileType           String
  fileSize           Int
  rawFilePath        String
  scopeLines         String      @default("")
  pricingData        String      @default("")
  parseStatus        ParseStatus @default(pending)
  parseError         String?
  sanitizedText      String?
  sanitizationStatus String?
  redactionCount     Int?
  flaggedLines       String?
  subToken           String?
  approvedForAi      Boolean     @default(false)
  parsedTotal        Float?
  parsedLineCount    Int?
  uploadedAt         DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  bid           Bid           @relation(fields: [bidId], references: [id])
  subcontractor Subcontractor @relation(fields: [subcontractorId], references: [id])
  levelingRows  LevelingRow[]

  @@unique([bidId, subcontractorId])
}

model LevelingSession {
  id        Int      @id @default(autoincrement())
  bidId     Int      @unique
  status    String   @default("active")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  bid  Bid           @relation(fields: [bidId], references: [id])
  rows LevelingRow[]
}

model LevelingRow {
  id               Int      @id @default(autoincrement())
  sessionId        Int
  estimateUploadId Int
  tradeId          Int?
  division         String   @default("")
  scopeText        String
  scopeHash        String
  status           String   @default("unreviewed")
  note             String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  session        LevelingSession     @relation(fields: [sessionId], references: [id])
  estimateUpload EstimateUpload      @relation(fields: [estimateUploadId], references: [id])
  trade          Trade?              @relation(fields: [tradeId], references: [id])
  questions      GeneratedQuestion[]

  @@unique([estimateUploadId, scopeHash])
}

model SpecBook {
  id         Int      @id @default(autoincrement())
  bidId      Int
  fileName   String
  filePath   String
  uploadedAt DateTime @default(now())
  status     String   @default("processing")

  bid      Bid           @relation(fields: [bidId], references: [id])
  sections SpecSection[]
}

model SpecSection {
  id                Int      @id @default(autoincrement())
  csiCanonicalTitle String? // enriched from CsiMasterformat on split
  specBookId        Int
  csiNumber         String
  csiTitle          String
  rawText           String   @default("")
  tradeId           Int?
  matchedTradeId    Int?
  source            String?
  covered           Boolean  @default(false)
  createdAt         DateTime @default(now())

  // Phase 5A: AI extraction results (JSON blob from Claude analysis)
  // Contains: submittals, warranties, training, testing, closeout, products, performance
  aiExtractions String?

  // Phase 5A: per-section PDF split (Procore-style)
  // Each section extracted as its own PDF file for download/preview/AI analysis
  pdfPath     String? // Server path to the split PDF
  pdfFileName String? // Display filename (e.g., "03_30_00_cast_in_place_concrete.pdf")
  pageStart   Int? // 1-indexed start page in original spec book
  pageEnd     Int? // 1-indexed end page
  pageCount   Int?

  specBook       SpecBook        @relation(fields: [specBookId], references: [id], onDelete: Cascade)
  trade          Trade?          @relation("SpecSectionTrade", fields: [tradeId], references: [id])
  matchedTrade   Trade?          @relation("MatchedSpecSection", fields: [matchedTradeId], references: [id])
  submittalItems SubmittalItem[]
}

// Drawing uploads support two modes:
//   FULLSET  — one PDF containing all disciplines (legacy behavior)
//   Per-discipline — one PDF per discipline (ARCH, CIVIL, STRUCT, MECH, ELEC, PLUMB, INTERIOR, FP, GENERAL)
// Multiple uploads per bid are allowed. Re-uploading the same discipline replaces it.
model DrawingUpload {
  id         Int      @id @default(autoincrement())
  bidId      Int
  fileName   String
  filePath   String
  uploadedAt DateTime @default(now())
  status     String   @default("processing")

  // Discipline tag: FULLSET | GENERAL | CIVIL | ARCH | STRUCT | MECH | ELEC | PLUMB | INTERIOR | FP
  // Validated in API, not enum for SQLite friendliness.
  discipline String @default("FULLSET")

  // AI analysis fields
  analysisStatus      String? // "processing" | "ready" | "error"
  analysisTier        Int? // 1 | 2 | 3
  analysisModel       String? // "haiku" | "sonnet" | "opus"
  analysisJson        String? // JSON result blob
  analysisGeneratedAt DateTime?

  bid    Bid            @relation(fields: [bidId], references: [id])
  sheets DrawingSheet[]

  @@index([bidId, discipline])
}

model AddendumUpload {
  id               Int       @id @default(autoincrement())
  bidId            Int
  addendumNumber   Int
  addendumDate     DateTime?
  fileName         String
  uploadedAt       DateTime  @default(now())
  status           String    @default("processing")
  extractedText    String?
  deltaJson        String?
  deltaGeneratedAt DateTime?
  summary          String?
  // Relative BlobStore key for the durably-stored original PDF (added by the
  // artifact-durability work). Nullable — historic rows written before this
  // column existed have no on-disk reference at all (see
  // lib/services/addendums/storagePath.ts's module doc) and are left null,
  // never guessed at.
  storageKey       String?

  bid Bid @relation(fields: [bidId], references: [id])
}

model BidIntelligenceBrief {
  id                   Int      @id @default(autoincrement())
  bidId                Int      @unique
  generatedAt          DateTime @default(now())
  status               String   @default("generating")
  whatIsThisJob        String?
  howItGetsBuilt       String?
  riskFlags            String?
  assumptionsToResolve String?
  addendumSummary      String?
  addendumCount        Int      @default(0)
  isStale              Boolean  @default(false)
  sourceContext        String?
  triggeredBy          String?
  addendumDeltas       String?

  bid Bid @relation(fields: [bidId], references: [id])
}

model DrawingSheet {
  id              Int      @id @default(autoincrement())
  drawingUploadId Int
  sheetNumber     String
  sheetTitle      String?
  discipline      String?
  matchedTradeId  Int?
  tradeId         Int?
  createdAt       DateTime @default(now())

  drawingUpload DrawingUpload @relation(fields: [drawingUploadId], references: [id], onDelete: Cascade)
  trade         Trade?        @relation("DrawingSheetTrade", fields: [tradeId], references: [id])
  matchedTrade  Trade?        @relation("MatchedDrawingSheet", fields: [matchedTradeId], references: [id])
}

// Module H3 — Submittal Register
// One SubmittalItem per required submittal. Seeded from SpecSection.rawText
// via regex extraction, then manually managed through the lifecycle.
//
// Valid type values (validated in API, not enum for SQLite friendliness):
//   PRODUCT_DATA | SHOP_DRAWING | SAMPLE | MOCKUP | WARRANTY | O_AND_M | LEED | CERT | OTHER
// Valid status values:
//   PENDING | REQUESTED | RECEIVED | UNDER_REVIEW | APPROVED | APPROVED_AS_NOTED | REJECTED | RESUBMIT
// Phase 5G-3.5 — Submittal Package (Procore-compatible container)
//
// Groups SubmittalItems — maps 1:1 to Procore's "Submittal Package" field on
// CSV import/export. Typically one package per trade (Concrete, Masonry,
// Electrical). Auto-created when AI generator runs; user can rename/merge.
model SubmittalPackage {
  id            Int    @id @default(autoincrement())
  bidId         Int
  packageNumber String // "PKG-01", "PKG-02" — unique per bid
  name          String // "Concrete", "Electrical", "HVAC Closeout"
  status        String @default("DRAFT") // DRAFT | OPEN | CLOSED

  // Optional 1:1 link to a bid trade (most packages mirror trades)
  bidTradeId Int?

  // Package-level defaults (items in package inherit unless overridden)
  responsibleContractor String?
  submittalManager      String?
  defaultReviewers      String? // JSON array: ["GC PM", "Architect"]
  defaultDistribution   String? // JSON array: ["Owner Rep", "Inspector"]

  // Orchestrator — timing defaults inherited by items lacking individual overrides
  defaultLeadTimeDays       Int?
  defaultReviewBufferDays   Int?
  defaultResubmitBufferDays Int?

  // Orchestrator — schedule linkage + risk + export readiness
  linkedActivityId   String?
  riskStatus         String    @default("NONE") // NONE | AT_RISK | BLOCKED
  readyForExport     Boolean   @default(false)
  releasePhase       String? // Preconstruction | Early Construction | Mid Construction | Closeout
  targetIssueDate    DateTime? // when GC plans to issue the package to sub
  requiredReturnDate DateTime? // when GC needs it back from sub/AOR

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  bid            Bid                 @relation(fields: [bidId], references: [id], onDelete: Cascade)
  bidTrade       BidTrade?           @relation(fields: [bidTradeId], references: [id])
  linkedActivity ScheduleActivityV2? @relation(fields: [linkedActivityId], references: [id], onDelete: SetNull)
  items          SubmittalItem[]

  @@unique([bidId, packageNumber])
  @@index([bidId])
  @@index([linkedActivityId])
}

// Module CSI1 — Canonical CSI MasterFormat 2020 reference
//
// Seeded from prisma/seed/data/CSI_MasterFormat_2020.xlsx (Level 3 only).
// Used by the spec splitter and AI pipeline to validate/reconcile parsed
// section titles against the official MasterFormat naming.
model CsiMasterformat {
  id             Int    @id @default(autoincrement())
  csiNumber      String @unique // "03 30 00"
  canonicalTitle String // "Cast-in-Place Concrete"
  division       String // "03"

  @@index([division])
}

model SubmittalItem {
  id            Int  @id @default(autoincrement())
  bidId         Int
  bidTradeId    Int?
  specSectionId Int?
  packageId     Int? // Phase 5G-3.5 — optional FK to SubmittalPackage

  submittalNumber String?
  title           String
  description     String?
  type            String  @default("OTHER")

  // Provenance — "manual" | "regex_seed" | "ai_extraction" | "csi_baseline"
  // | "ai_organized" | "drawing_analysis". Any non-"manual" value is
  // wipeable by a later AI regeneration/organize pass; updateSubmittal()
  // promotes a row to "manual" the moment a user edits it, so a corrected
  // auto row is never silently replaced.
  source String @default("manual")

  // Lifecycle
  status      String    @default("PENDING")
  requiredBy  DateTime?
  requestedAt DateTime?
  receivedAt  DateTime?
  reviewedAt  DateTime?
  approvedAt  DateTime?
  reviewRound Int       @default(1)

  // Attribution
  responsibleSubId Int?
  reviewer         String?

  notes String?

  // AI Organizer — set by organizeSubmittalsWithAi()
  priority     String? // HIGH | MEDIUM | LOW
  releasePhase String? // Preconstruction | Early Construction | Mid Construction | Closeout

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // GWX-006 — Audit attribution: which BackgroundJob created this item.
  // Null for manually-created items. Set by generateSubmittalsFromAiAnalysis
  // when called from the sidecar webhook callback.
  sourceJobId String?

  // Phase 5G-2 — Schedule-tied due dates
  // Backward math: submitByDate = linkedActivity.startDate - leadTimeDays - reviewBufferDays - resubmitBufferDays
  linkedActivityId   String? // FK to ScheduleActivityV2
  leadTimeDays       Int       @default(0) // mfr delivery lead time (working days)
  reviewBufferDays   Int       @default(21) // A/E review window per AIA A201 §4.2.7
  resubmitBufferDays Int       @default(7) // one resubmission cycle buffer
  requiredOnSiteDate DateTime? // derived: linkedActivity.startDate - leadTimeDays
  submitByDate       DateTime? // derived: requiredOnSiteDate - reviewBuffer - resubmitBuffer

  bid            Bid                 @relation(fields: [bidId], references: [id], onDelete: Cascade)
  bidTrade       BidTrade?           @relation(fields: [bidTradeId], references: [id])
  specSection    SpecSection?        @relation(fields: [specSectionId], references: [id])
  responsibleSub Subcontractor?      @relation(fields: [responsibleSubId], references: [id])
  package        SubmittalPackage?   @relation(fields: [packageId], references: [id], onDelete: SetNull)
  linkedActivity ScheduleActivityV2? @relation(fields: [linkedActivityId], references: [id], onDelete: SetNull)
  sourceJob      BackgroundJob?      @relation(fields: [sourceJobId], references: [id], onDelete: SetNull)

  @@index([bidId])
  @@index([specSectionId])
  @@index([status])
  @@index([packageId])
  @@index([linkedActivityId])
  @@index([sourceJobId])
}

// Phase 5G-3 — Per-trade submittal routing template
//
// One row per (bid, trade). Stores the default contractor, submittal manager,
// reviewer chain, and distribution list for submittals belonging to that trade.
// Auto-applied to packages when AI generation runs; user edits via the
// Routing panel on the Submittals tab. Override per submittal is via the
// item's own reviewer field or the package's responsibleContractor field.
model SubmittalDistributionTemplate {
  id         Int  @id @default(autoincrement())
  bidId      Int
  bidTradeId Int? // null = bid-wide fallback

  responsibleContractor String? // default sub/vendor responsible for submittals
  submittalManager      String? // GC role/person who manages the package
  reviewers             String  @default("[]") // JSON: ["Architect", "MEP Eng"]
  distribution          String  @default("[]") // JSON: ["Owner Rep", "Inspector"]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  bid      Bid       @relation(fields: [bidId], references: [id], onDelete: Cascade)
  bidTrade BidTrade? @relation(fields: [bidTradeId], references: [id], onDelete: Cascade)

  @@unique([bidId, bidTradeId])
  @@index([bidId])
}

// Module H1 — Project Contacts (owner / architect / engineer / internal team)
//
// Replaces the deferred contacts placeholder in the H1 Handoff Packet. One row
// per contact, parented to a Bid. Manageable on the Overview and Handoff tabs.
//
// Valid role values (validated in API, not enum for SQLite friendliness):
//   OWNER | OWNER_REP | ARCHITECT | ENGINEER |
//   INTERNAL_PM | INTERNAL_ESTIMATOR | INTERNAL_SUPER | OTHER
model ProjectContact {
  id    Int @id @default(autoincrement())
  bidId Int

  role String @default("OTHER")

  name    String
  company String?
  title   String?
  email   String?
  phone   String?
  notes   String?

  // Within a role, primary contacts sort first. Multiple primaries allowed.
  isPrimary Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  bid                 Bid                  @relation(fields: [bidId], references: [id], onDelete: Cascade)
  meetingParticipants MeetingParticipant[]

  @@index([bidId])
  @@index([bidId, role])
}

// Module H4 — Schedule Seed
// One ScheduleActivity per BidTrade (plus 2 milestones). Seeded from the
// bid's trade list in canonical CSI order, then manually refined. MS Project
// CSV export is the primary delivery.
//
// Valid kind values (validated in API, not enum for SQLite friendliness):
//   CONSTRUCTION | MILESTONE
//
// predecessorIds is a comma-separated list of activityId strings (Primavera
// style — e.g. "A1010,A1020"). Only Finish-to-Start is supported in v1.
model ScheduleActivity {
  id         Int  @id @default(autoincrement())
  bidId      Int
  bidTradeId Int?

  activityId String // "A1010" style
  name       String
  kind       String @default("CONSTRUCTION")
  sequence   Int    @default(0)

  durationDays   Int       @default(5)
  startDate      DateTime?
  finishDate     DateTime?
  predecessorIds String?

  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  bid      Bid       @relation(fields: [bidId], references: [id], onDelete: Cascade)
  bidTrade BidTrade? @relation(fields: [bidTradeId], references: [id])

  @@index([bidId])
  @@index([bidId, sequence])
}

// ── Phase 5C — Schedule V2 ───────────────────────────────────────────────────
//
// New data model for the full-featured schedule editor. The old ScheduleActivity
// (H4) is preserved until migration is complete (Phase 11+).
//
// weatherMode: BUFFER | CONTRACTUAL | TRACK_ONLY
// activeLayers: JSON array of active layer keys, e.g. ["weather_a201","procurement"]
//
model Schedule {
  id              String    @id @default(cuid())
  bidId           Int
  bid             Bid       @relation(fields: [bidId], references: [id], onDelete: Cascade)
  name            String    @default("Baseline Schedule")
  startDate       DateTime
  isBaseline      Boolean   @default(false)
  baselinedAt     DateTime?
  weatherMode     String    @default("BUFFER")
  weatherStation  String?
  weatherBaseline String? // JSON: { stationId, annualDays, monthlyDays[] }
  activeLayers    String    @default("[]") // JSON: string[]
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  activities ScheduleActivityV2[]
  versions   ScheduleVersion[]

  @@index([bidId])
}

// Valid status values: not_started | in_progress | complete | on_hold
// Valid weatherCode: WS-0 through WS-5 (impact tiers defined in Phase 5C docs)
// outlineLevel: 1=phase summary, 2=category summary, 3=task
model ScheduleActivityV2 {
  id                 String    @id @default(cuid())
  scheduleId         String
  schedule           Schedule  @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  activityCode       String
  wbsId              String    @default("")
  outlineLevel       Int       @default(3)
  sortOrder          Int       @default(0)
  name               String
  duration           Int       @default(5)
  isSummary          Boolean   @default(false)
  isMilestone        Boolean   @default(false)
  csiCode            String?
  trade              String?
  weatherCode        String    @default("WS-0")
  requiresInspection Boolean   @default(false)
  notes              String    @default("")
  aiGenerated        Boolean   @default(false)
  aiConfidence       String?
  layerSource        String?
  status             String    @default("not_started")
  percentComplete    Float     @default(0)
  actualStart        DateTime?
  actualFinish       DateTime?
  remainingDuration  Int?
  delayReason        String?
  startDate          DateTime?
  finishDate         DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  predecessors      ScheduleDependency[] @relation("SuccessorActivity")
  successors        ScheduleDependency[] @relation("PredecessorActivity")
  submittals        SubmittalItem[]
  submittalPackages SubmittalPackage[]

  @@index([scheduleId])
  @@index([scheduleId, sortOrder])
}

// type: FS (Finish-to-Start) | SS (Start-to-Start) | FF (Finish-to-Finish) | SF (Start-to-Finish)
// lag: positive = lag days, negative = lead days (working days)
model ScheduleDependency {
  id            String @id @default(cuid())
  predecessorId String
  successorId   String
  type          String @default("FS")
  lag           Int    @default(0)

  predecessor ScheduleActivityV2 @relation("PredecessorActivity", fields: [predecessorId], references: [id], onDelete: Cascade)
  successor   ScheduleActivityV2 @relation("SuccessorActivity", fields: [successorId], references: [id], onDelete: Cascade)

  @@unique([predecessorId, successorId, type])
  @@index([successorId])
}

// Versioned snapshots: baseline, what-if, issued-for-review, etc.
// snapshot is a JSON string of { activities, dependencies } at save time.
model ScheduleVersion {
  id          String   @id @default(cuid())
  scheduleId  String
  schedule    Schedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  versionName String
  snapshot    String // JSON
  createdAt   DateTime @default(now())

  @@index([scheduleId])
}

// Per-AI-call max_tokens overrides. If a row exists for a callKey, that value
// overrides the hardcoded default in lib/services/ai/aiTokenConfig.ts.
model AiTokenConfig {
  id        Int      @id @default(autoincrement())
  callKey   String   @unique
  maxTokens Int
  updatedAt DateTime @updatedAt
}

// Module SET1 — App Settings (key/value)
//
// Hot-applied settings stored in DB. Reads are cached in-process and the
// cache is invalidated on every write. Designed for credentials + config that
// the user can change from the /settings UI without restarting the dev server.
//
// Conventions:
// - Secret values (keys marked secret:true in SETTING_DEFINITIONS) are encrypted
//   at rest using AES-256-GCM when SETTINGS_ENCRYPTION_KEY is set in the env.
//   Stored format: "enc:v1:<iv_hex>:<auth_tag_hex>:<ciphertext_hex>"
// - Without SETTINGS_ENCRYPTION_KEY, secrets are stored plaintext (same as before).
// - Service code reads via getSetting(key) — decryption is transparent.
// - The UI masks secret values to last-4 display.
model AppSetting {
  id        Int      @id @default(autoincrement())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt
}

// Module SET1 — AI Usage Log
//
// One row per Anthropic API call. Powers the Usage subsection on the AI
// settings card and the cost estimator's calibration data.
//
// callKey aligns with AI_CALL_DEFINITIONS in aiTokenConfig.ts.
model AiUsageLog {
  id           Int      @id @default(autoincrement())
  callKey      String
  model        String
  inputTokens  Int
  outputTokens Int
  costUsd      Float
  bidId        Int?
  status       String   @default("ok") // "ok" (real success) | "error" (real failure) | "stub" (no provider call attempted — see lib/services/ai/aiUsageLog.ts module doc)
  errorMessage String?  // ONLY a bounded AiFailureClass value when status="error" — never raw provider error text (see classifyAiFailure())
  createdAt    DateTime @default(now())

  @@index([callKey])
  @@index([createdAt])
  @@index([bidId])
}

// ── Phase 5D — Meeting Intelligence Pipeline ────────────────────────────────
//
// Three-model stack: Meeting → MeetingParticipant → MeetingActionItem
//
// meetingType values (validated in API):
//   GENERAL | OAC | SUBCONTRACTOR | PRECONSTRUCTION | SAFETY | KICKOFF
//
// status values (FSM):
//   PENDING → UPLOADING → TRANSCRIBING → ANALYZING → READY | FAILED
//
// transcriptionSource values:
//   ASSEMBLYAI | WHISPERX | MANUAL | HYBRID
//
// processingMode values:
//   AUTO | MANUAL | VTT_ONLY | AUDIO_ONLY | HYBRID
//
// status values (hybrid adds AWAITING_NAMES between TRANSCRIBING and READY):
//   PENDING | UPLOADING | TRANSCRIBING | AWAITING_NAMES | ANALYZING | READY | FAILED

model Meeting {
  id                  Int       @id @default(autoincrement())
  bidId               Int
  title               String
  meetingDate         DateTime
  meetingType         String    @default("GENERAL")
  location            String?
  status              String    @default("PENDING")
  audioFileName       String?
  // Relative BlobStore key for the durably-stored hybrid-upload audio file
  // (added by the artifact-durability work). Nullable — historic rows
  // written before this column existed keep resolving via the existing
  // naming-convention reconstruction (process.cwd()/uploads/meetings/{id}/
  // {audioFileName}) in source-mapping/route.ts; this column is only
  // populated going forward and only consulted when non-null.
  audioStorageKey     String?
  durationSeconds     Int?
  transcriptionSource String?
  transcriptionJobId  String? // AssemblyAI transcript_id or WhisperX job id
  rawTranscript       String? // full JSON blob from transcription service
  transcript          String? // speaker-labeled formatted text for display + Claude
  processingMode      String    @default("AUTO") // AUTO | MANUAL | VTT_ONLY | AUDIO_ONLY | HYBRID
  speakerMapping      String? // JSON: { clusters: [...], mapping: {} } — populated after diarization
  vttContent          String? // Teams VTT text stored during HYBRID processing; cleared after merge
  summary             String? // Claude-generated 2-3 sentence overview (§3)
  keyDecisions        String    @default("[]") // JSON: string[]                       (§4)
  risks               String    @default("[]") // JSON: { description, severity }[]    (legacy)
  followUpItems       String    @default("[]") // JSON: string[]                       (legacy)
  // ── 8-section analysis output fields ──────────────────────────────────────
  openIssues          String    @default("[]") // JSON: MeetingOpenIssue[]             (§6)
  redFlags            String    @default("[]") // JSON: MeetingRedFlag[]               (§7)
  reviewStatus        String    @default("DRAFT") // "DRAFT" | "IN_REVIEW" | "PUBLISHED"
  publishedAt         DateTime?
  analysisVersion     Int       @default(0) // increments on each re-analysis
  uploadedAt          DateTime?
  analyzedAt          DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  bid          Bid                  @relation(fields: [bidId], references: [id], onDelete: Cascade)
  actionItems  MeetingActionItem[]
  participants MeetingParticipant[]

  @@index([bidId])
  @@index([bidId, meetingDate])
}

// Persistent speaker roster per meeting. Speaker labels from diarization
// (SPEAKER_A, SPEAKER_B) are resolved to real names by the user post-upload.
// Optionally linked to a ProjectContact for cross-meeting context.
model MeetingParticipant {
  id               Int     @id @default(autoincrement())
  meetingId        Int
  name             String
  role             String?
  company          String?
  speakerLabel     String? // "SPEAKER_A" / "ROOM_SPK_1" from diarization
  speakerType      String? // "REMOTE" | "IN_ROOM" | "UNKNOWN"
  confidence       Float? // 0.0–1.0 identity confidence from AI inference
  isGcTeam         Boolean @default(false) // GC team member — drives §8 bold + filter
  projectContactId Int?

  meeting        Meeting             @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  projectContact ProjectContact?     @relation(fields: [projectContactId], references: [id], onDelete: SetNull)
  actionItems    MeetingActionItem[]

  @@index([meetingId])
}

// Action items extracted from meeting transcripts by Claude (and manually added).
//
// priority values: LOW | MEDIUM | HIGH | CRITICAL
// status values:   OPEN | IN_PROGRESS | CLOSED | DEFERRED
model MeetingActionItem {
  id              Int       @id @default(autoincrement())
  bidId           Int
  meetingId       Int? // null for manually created tasks
  source          String    @default("meeting") // "meeting" | "manual"
  description     String
  assignedToId    Int? // FK to MeetingParticipant
  assignedToName  String? // denormalized — survives participant edits
  dueDate         DateTime?
  priority        String    @default("MEDIUM")
  status          String    @default("OPEN")
  sourceText      String? // paraphrased evidence excerpt from transcript
  isGcTask        Boolean   @default(false) // GC team task — populates §8
  carriedFromDate String? // ISO date of meeting where this first appeared
  closedAt        DateTime?
  notes           String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  bid        Bid                 @relation(fields: [bidId], references: [id], onDelete: Cascade)
  meeting    Meeting?            @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  assignedTo MeetingParticipant? @relation(fields: [assignedToId], references: [id], onDelete: SetNull)

  @@index([bidId])
  @@index([meetingId])
  @@index([status])
  @@index([source])
}

model BidDecision {
  id        Int       @id @default(autoincrement())
  bidId     Int
  category  String
  decision  String
  rationale String?
  madeBy    String?
  madeAt    DateTime?
  impact    String?
  status    String    @default("OPEN")
  source    String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  bid Bid @relation(fields: [bidId], references: [id], onDelete: Cascade)

  @@index([bidId])
}

// ── Tier F F2 — Procore REST API push history ───────────────────────────────
//
// One row per push operation. Tracks created/updated/skipped counts and any
// partial errors. Multiple rows per bid+pushType accumulate as history;
// the UI shows the most recent row per type.
//
// pushType values: "vendors" | "contacts" | "submittals" | "budget"
//
// errors is a JSON array of short error strings (one per failed item, max 50).

model ProcorePush {
  id       Int      @id @default(autoincrement())
  bidId    Int
  pushType String
  pushedAt DateTime @default(now())
  created  Int      @default(0)
  updated  Int      @default(0)
  skipped  Int      @default(0)
  errors   String?

  bid Bid @relation(fields: [bidId], references: [id], onDelete: Cascade)

  @@index([bidId])
  @@index([bidId, pushType])
}

// ── Tier F F3 — RFI items pulled from Procore ───────────────────────────────
//
// One row per RFI in the linked Procore project. procoreRfiId is the Procore
// numeric ID; the unique index prevents duplicate pulls on re-sync.
// syncedAt tracks when this record was last pulled from Procore.

model RfiItem {
  id           Int       @id @default(autoincrement())
  bidId        Int
  procoreRfiId Int?
  number       String
  title        String
  question     String?
  answer       String?
  status       String    @default("open")
  priority     String?
  assigneeName String?
  dueDate      DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  syncedAt     DateTime?

  bid Bid @relation(fields: [bidId], references: [id], onDelete: Cascade)

  @@unique([bidId, procoreRfiId])
  @@index([bidId])
}

// ── GWX-003 — Durable Background Job Record ─────────────────────────────────
//
// One row per background/async work unit. Replaces process-memory job state as
// the authoritative source of truth for overnight work and long-running analysis.
//
// jobType values: "spec_analysis" | "drawing_analysis" | "meeting_transcription"
// | "brief_refresh" | "submittal_generation" | "market_scrape"
//
// status FSM: queued → running → complete | failed | cancelled
//
// externalJobId — the sidecar's in-memory job_id for active polling while the
//   sidecar is alive. Stored here so it survives the browser being closed.
//
// triggerSource: "user" | "automation" | "webhook"
model BackgroundJob {
  id      String @id @default(cuid())
  jobType String
  status  String @default("queued")

  // Context — which bid/document this job is about
  bidId     Int?
  relatedId String? // specBookId, drawingUploadId, meetingId as string

  // Sidecar reference — external job_id for progress polling while sidecar lives
  externalJobId String?

  // Input metadata (lightweight summary, not full payload)
  inputSummary String? // e.g. "32 sections, tier 2"

  // Optional cross-bid/source duplicate key. Market scrape jobs use this because
  // they are keyed by MarketSource.relatedId rather than bidId.
  dedupeKey String?

  // Result metadata (set on complete)
  resultSummary String? // e.g. "32 sections saved, $1.42"
  artifactType  String? // "spec_sections" | "drawing_sheets" etc.

  // Error detail (set on failed)
  errorMessage String?

  // Lifecycle timestamps
  createdAt   DateTime  @default(now())
  startedAt   DateTime?
  completedAt DateTime?

  // Operational metadata
  retryCount    Int    @default(0)
  triggerSource String @default("user")

  // Off-peak queueing — worker only picks up jobs where runAfter <= now()
  runAfter DateTime?

  // GWX-005.1 — Atomic duplicate prevention
  // Active (queued/running) jobs hold activeSlot=1; terminal jobs clear it to null.
  // The @@unique below enforces at most one active job per (bidId, jobType) at the
  // DB level. SQLite treats NULLs as distinct in unique indexes, so terminal rows
  // (activeSlot=null) never conflict with each other.
  activeSlot Int? @default(1)

  bid            Bid?            @relation(fields: [bidId], references: [id], onDelete: SetNull)
  submittalItems SubmittalItem[]

  @@unique([bidId, jobType, activeSlot])
  @@unique([dedupeKey, activeSlot])
  @@index([bidId])
  @@index([dedupeKey])
  @@index([jobType, status])
  @@index([status, createdAt])
  @@index([externalJobId])
  @@index([runAfter])
}

// ── Tier F F3 — Procore webhook event log ───────────────────────────────────
//
// Stores incoming Procore webhook events. Unprocessed events (processed=false)
// are handled by the webhook receiver after storing. The payload column holds
// the raw JSON body for replay/debugging.

model ProcoreWebhookEvent {
  id           Int       @id @default(autoincrement())
  receivedAt   DateTime  @default(now())
  eventType    String
  resourceType String
  resourceId   Int?
  projectId    Int?
  companyId    Int?
  payload      String
  processed    Boolean   @default(false)
  processedAt  DateTime?
  error        String?

  @@index([resourceType, resourceId])
  @@index([processed])
}

// ── Phase 2 — Market Intelligence Desk ──────────────────────────────────────
//
// Three-model stack: MarketLead ← MarketSignal, RelationshipEdge (standalone)
//
// MarketLead: a detected or manually-entered opportunity worth tracking.
//   leadType: PERMIT | MEETING_MINUTE | PLAN_ROOM | LAND_ACQUISITION | BROKER | RELATIONSHIP | MANUAL
//   status:   NEW | REVIEWING | QUALIFIED | PURSUING | ARCHIVED | DISMISSED
//   confidence: LOW | MEDIUM | HIGH
model MarketLead {
  id              String    @id @default(cuid())
  title           String
  leadType        String    @default("MANUAL")
  source          String? // "beeline" | "city_hall" | "blue_book" | "county_records" | "manual"
  sourceUrl       String?
  sourceDocId     String? // FK to MarketSourceDoc when auto-detected
  status          String    @default("NEW")
  confidence      String    @default("MEDIUM")
  aiScore         Int? // 0–100 overall signal strength
  location        String?
  jurisdiction    String? // city or county
  projectType     String? // building use / type
  estimatedValue  Float?
  rawText         String? // original scraped content
  aiSummary       String? // Claude-generated one-paragraph brief
  aiInsights      String? // JSON: { strengths: string[], risks: string[], angle: string }
  detectedAt      DateTime  @default(now())
  promotedToBidId Int? // set when user promotes this lead to an active pursuit
  promotedAt      DateTime?
  notes           String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  signals     MarketSignal[]
  promotedBid Bid?             @relation(fields: [promotedToBidId], references: [id], onDelete: SetNull)
  sourceDoc   MarketSourceDoc? @relation(fields: [sourceDocId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([leadType])
  @@index([detectedAt])
  @@index([promotedToBidId])
  @@index([sourceDocId])
}

// MarketSignal: a raw piece of market evidence (permit filing, plan room posting,
// meeting minute entry, land transaction, broker listing). Many signals can
// reference one lead, or exist unassigned (leadId = null).
//
// signalType: PERMIT | MEETING_MINUTE | PLAN_ROOM_JOB | PLAN_ROOM_VIEW |
//             LAND_ACQUISITION | BROKER_LISTING | ARCHITECT_PROJECT | MANUAL
model MarketSignal {
  id               String    @id @default(cuid())
  leadId           String?
  sourceDocId      String? // FK to MarketSourceDoc when auto-detected
  signalType       String // PERMIT | MEETING_MINUTE | PLAN_ROOM_* | ...
  signalSubtype    String? // SUP_CUP | REZONING | PLAT | VARIANCE | SITE_PLAN | ... (P&Z item types)
  source           String?
  sourceUrl        String?
  sourceDate       DateTime?
  headline         String
  rawText          String?
  metadata         String? // JSON: source-specific fields (permit no., parcel id, etc.)
  aiRelevanceScore Int? // 0–100
  nextMeetingDate  DateTime? // Set when status=CONTINUED — watch the next agenda
  // ── Phase O2.2 PR3 — heuristic classifier output (signalHeuristics.ts) ───
  // Populated when persistSidecarPayload runs the deterministic classifier.
  // Null when skipHeuristics was true OR when the row pre-dates PR3.
  // SUPPRESSED is NEVER persisted (heuristicsClassification ∈ {HIGH_EMERGENCE,
  // MEDIUM_EMERGENCE, LOW_EMERGENCE} or null).
  heuristicsJson           String? // JSON array of HeuristicFactor
  heuristicsVersion        String? // e.g. "v1"
  heuristicsScore          Float?  // clamped [0, 1]
  heuristicsClassification String?
  createdAt        DateTime  @default(now())

  lead      MarketLead?      @relation(fields: [leadId], references: [id], onDelete: SetNull)
  sourceDoc MarketSourceDoc? @relation(fields: [sourceDocId], references: [id], onDelete: SetNull)

  @@index([leadId])
  @@index([signalType])
  @@index([signalSubtype])
  @@index([createdAt])
  @@index([sourceDocId])
  @@index([nextMeetingDate])
  @@index([heuristicsClassification])
}

// MarketSource: a configured ingestion endpoint (city council minutes page,
// permit feed listing, planning commission agenda archive). The scraper
// crawls this URL on demand and emits new MarketSourceDoc rows per document.
//
// sourceType: city_council | planning_commission | permit_feed | rss
model MarketSource {
  id                     String    @id @default(cuid())
  name                   String
  jurisdiction           String
  url                    String
  sourceType             String    @default("city_council")
  isActive               Boolean   @default(true)
  lastScannedAt          DateTime?
  docsProcessed          Int       @default(0)
  // Tuning knobs — applied per-source during scrape persist
  dateFrom               DateTime? // skip docs older than this
  dateTo                 DateTime? // skip docs newer than this
  minRelevanceScore      Int       @default(60) // drop signals below this score
  minEstimatedValue      Float? // drop leads below this value (null = no floor)
  projectTypeAllowlist   String? // CSV: commercial,industrial,institutional (null = all)
  // Ollama prefilter (cost control) — runs local LLM on the GPU PC first to
  // strip boilerplate before Claude. Modes: off | large | always.
  // "large" triggers when extracted doc length exceeds prefilterCharThreshold.
  prefilterMode          String    @default("off")
  prefilterCharThreshold Int       @default(30000)
  prefilterModel         String? // null = use sidecar OLLAMA_MODEL default
  // Publish-cadence learning + smart polling
  publishCadenceDays     Int? // median days between consecutive docs
  cadenceConfidence      String? // LOW (<5 samples) | MEDIUM (5-15) | HIGH (>15)
  cadenceSampleSize      Int? // number of date-deltas the cadence is derived from
  lastDocSeenAt          DateTime? // documentDate of the most recent doc on file
  nextExpectedAt         DateTime? // when smart polling should fire next
  backfillYears          Int? // how far back we've intentionally backfilled
  backfillCompletedAt    DateTime? // null = no backfill done yet
  // ── Phase O2.2 PR2 — cadence intelligence governance ─────────────────────
  // publishStatus: HEALTHY (default) | STALE_PUBLISH (N consecutive empty
  // runs past expected publish) | OPERATOR_REVIEW (manual hold). The runner
  // skips non-HEALTHY sources except on explicit operator force.
  publishStatus          String    @default("HEALTHY")
  consecutiveEmptyRuns   Int       @default(0)
  lastEmptyRunAt         DateTime?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  docs           MarketSourceDoc[]
  cadenceSamples MarketSourceCadenceSample[]

  @@index([sourceType])
  @@index([isActive])
  @@index([nextExpectedAt])
  @@index([publishStatus])
}

// Phase O2.2 PR2 — rolling sample of doc dates per source used to estimate
// publishCadenceDays + cadenceConfidence. Kept small (caller caps at last
// 20 per source) to avoid bloat. New samples are appended on every scrape
// that finds new docs; pruning happens in lib/services/marketIntelligence/
// sourceCadence.ts after the median is recomputed.
model MarketSourceCadenceSample {
  id         String   @id @default(cuid())
  sourceId   String
  docDate    DateTime
  observedAt DateTime @default(now())

  source MarketSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@index([sourceId, docDate])
}

// MarketSourceDoc: per-document dedup record. Each row is one document URL
// the scraper has processed under a given source — prevents re-scanning the
// same minutes/agenda PDF on subsequent runs.
model MarketSourceDoc {
  id           String    @id @default(cuid())
  sourceId     String
  docUrl       String // canonical URL (query string stripped) — dedup key
  docUrlFull   String? // original URL incl. query string, kept for re-fetch
  title        String? // link text from listing page (e.g. "April 13 P&Z Minutes")
  scannedAt    DateTime  @default(now())
  signalsFound Int       @default(0)
  jurisdiction String?
  documentDate DateTime?
  rawText      String? // full extracted text — for traceability + future re-analysis
  charCount    Int       @default(0)
  costUsd      Float     @default(0)
  error        String?

  source   MarketSource        @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  leads    MarketLead[]
  signals  MarketSignal[]
  analyses MarketDocAnalysis[]

  @@unique([sourceId, docUrl])
  @@index([sourceId])
  @@index([scannedAt])
  @@index([documentDate])
}

// MarketDocAnalysis: one row per on-demand engine analysis of a scraped doc.
// Lets the user fire Claude AND Ollama (or repeat either) against the same
// document and compare results. Distinct from the auto-extraction at scrape
// time, which writes into MarketSignal/MarketLead directly.
model MarketDocAnalysis {
  id              String    @id @default(cuid())
  docId           String
  engine          String // "claude" | "ollama"
  modelName       String // e.g. "claude-sonnet-4-6" or "qwen2.5:14b"
  status          String    @default("queued") // queued | running | complete | failed
  requestedAt     DateTime  @default(now())
  startedAt       DateTime?
  completedAt     DateTime?
  durationMs      Int?
  costUsd         Float     @default(0)
  signalsCount    Int       @default(0) // number of signal items in response
  leadsCount      Int       @default(0) // number of lead items in response
  rawResponseJson String? // full JSON the engine returned (for diff/compare)
  errorMessage    String?
  triggerSource   String    @default("user") // user | automation | retry

  doc MarketSourceDoc @relation(fields: [docId], references: [id], onDelete: Cascade)

  @@index([docId])
  @@index([engine])
  @@index([requestedAt])
}

// RelationshipEdge: architect↔GC, owner↔GC, developer↔GC associations derived
// from past projects, permit history, and market scrapes.
//
// fromType / toType: GC | ARCHITECT | OWNER | DEVELOPER | ENGINEER | BROKER
// relationshipType:  DESIGNED | BUILT | PARTNERED | COMPETING | OWNED
model RelationshipEdge {
  id               String   @id @default(cuid())
  fromType         String
  fromName         String
  toType           String
  toName           String
  relationshipType String
  projectName      String?
  projectValue     Float?
  projectYear      Int?
  location         String?
  source           String?
  sourceUrl        String?
  confidence       String   @default("MEDIUM")
  notes            String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  // ── Phase MI-1 additive entity-link columns ──────────────────────────────
  // Populated by the future resolver (MI-2) and backfill (MI-3). NULL on
  // existing rows; reads must continue to work via the free-text fromName /
  // toName columns above (dual-read pattern).
  fromEntityId       String?
  toEntityId         String?
  resolverVersion    String?
  resolverConfidence String?

  @@index([fromName])
  @@index([toName])
  @@index([relationshipType])
  @@index([fromEntityId])
  @@index([toEntityId])
}

// ── Market Intelligence: Entity normalization layer (Phase MI-1) ────────────
//
// Foundation for relationship intelligence. Makes market entities first-class
// objects so signals, leads, and relationships can be resolved against a
// canonical set of organizations instead of free-text names.
//
// Schema-only in MI-1. Resolver (MI-2), backfill (MI-3), entity profile UI
// (MI-4), and dual-write ingestion (MI-5) follow in subsequent PRs.
//
// All four models are additive. No existing table is destructively altered.
// RelationshipEdge above gains four nullable columns; existing rows continue
// to function unchanged.
//
// Pseudo-enum field values (validated in app code, not in Prisma):
//   Entity.entityType:      Developer | Owner | Broker | GC | Architect |
//                           Engineer | Municipality | Tenant | Lender |
//                           Agency | Unknown
//   relationshipType:       OWNS | DEVELOPED | BUILT | DESIGNED | ENGINEERED
//                           | PARTNERED | TENANT_OF | LENT_TO |
//                           PERMIT_AUTHORITY_FOR | COMPETED_FOR | OTHER
//   reviewStatus:           AUTO | PENDING_REVIEW | VERIFIED | REJECTED
//   confidence:             LOW | MEDIUM | HIGH | VERIFIED
//
// Acceptance criteria for the MI-1→MI-5 stack live in
// docs/sources/ENTITIES_WATCHLIST.md §"Validation tests".
// ────────────────────────────────────────────────────────────────────────────

model Entity {
  id String @id @default(cuid())

  // Canonical naming. normalizedName is the dedup key: lowercased,
  // suffix-stripped ("LLC", "Inc", "Corp", "Company", "The"), whitespace
  // and punctuation removed. See lib/services/entityResolver/normalize.ts
  // (added in MI-2 PR) for the exact algorithm.
  canonicalName  String // "Hubbell Realty Company"
  normalizedName String @unique // "hubbellrealty"
  entityType     String

  // Workflow + provenance
  reviewStatus String  @default("AUTO")
  confidence   String  @default("MEDIUM")
  source       String? // "watchlist_seed" | "resolver" | "manual" | "backfill"
  notes        String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  aliases               EntityAlias[]
  outgoingRelationships EntityRelationship[] @relation("EntityRelationshipFrom")
  incomingRelationships EntityRelationship[] @relation("EntityRelationshipTo")

  // Phase MI-10 workspace back-relation.
  watchlistItems WatchlistItem[]

  @@index([entityType])
  @@index([reviewStatus])
}

model EntityAlias {
  id              String  @id @default(cuid())
  entityId        String
  alias           String // "Hubbell"
  normalizedAlias String // "hubbell" — same normalizer as Entity.normalizedName
  confidence      String  @default("MEDIUM")
  source          String? // "watchlist" | "backfill" | "manual"

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  entity Entity @relation(fields: [entityId], references: [id], onDelete: Cascade)

  @@unique([entityId, normalizedAlias])
  @@index([normalizedAlias])
  @@index([entityId])
}

model EntityRelationship {
  id               String @id @default(cuid())
  fromEntityId     String
  toEntityId       String
  relationshipType String

  // Project / lead / signal context (denormalized — no Project aggregate yet).
  // Populated where the relationship was observed in a project-scoped context.
  projectName    String?
  projectValue   Float?
  projectYear    Int?
  projectAddress String?
  jurisdiction   String?
  sourceDocId    String? // loose pointer to MarketSourceDoc.id when applicable
  leadId         String? // loose pointer to MarketLead.id when applicable
  signalId       String? // loose pointer to MarketSignal.id when applicable
  legacyEdgeId   String? // points back to RelationshipEdge.id for backfilled rows

  // Provenance + confidence + workflow
  source       String? // "permit" | "meeting_minute" | "press" | "manual" | "backfill"
  sourceUrl    String?
  confidence   String  @default("MEDIUM")
  reviewStatus String  @default("AUTO")
  notes        String?

  // Observation lifecycle — distinct from row-level created/updated. A
  // relationship may be observed multiple times before being collapsed.
  firstObservedAt DateTime @default(now())
  lastObservedAt  DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  fromEntity Entity @relation("EntityRelationshipFrom", fields: [fromEntityId], references: [id], onDelete: Cascade)
  toEntity   Entity @relation("EntityRelationshipTo", fields: [toEntityId], references: [id], onDelete: Cascade)

  @@index([fromEntityId])
  @@index([toEntityId])
  @@index([relationshipType])
  @@index([projectYear])
  @@index([sourceDocId])
  @@index([leadId])
  @@index([signalId])
  @@index([legacyEdgeId])
}

// ──────────────────────────────────────────────────────────────────────────────
//  Market Intelligence: Project Aggregate layer (Phase MI-6)
//
//  Project = temporal intelligence object. Many weak signals (rezoning,
//  broker activity, utility extension, plat review, engineer appearance,
//  shell-building rumor, franchise movement) accumulate over time into one
//  evolving aggregate that represents a single construction emergence.
//
//  Schema-only in MI-6 PR 1. Service layer in lib/services/projectAggregation
//  ships in the same PR but does not mutate ingestion paths. Backfill runner
//  + UI follow in subsequent PRs (MI-6 PR 2, MI-6 PR 3).
//
//  Pseudo-enum field values (validated in app code):
//    Project.lifecycleState:   EMERGING | EARLY_SIGNAL | PRE_ENTITLEMENT |
//                              ENTITLEMENT | SITE_PREP | PRE_CONSTRUCTION |
//                              ACTIVE_CONSTRUCTION | STALLED | ABANDONED |
//                              COMPLETED
//    Project.reviewStatus:     AUTO_AGGREGATED | PENDING_REVIEW | VERIFIED |
//                              REJECTED | MERGED
//    Project.confidence:       LOW | MEDIUM | HIGH | VERIFIED
//    ProjectSignal.signalKind: MARKET_SIGNAL | RELATIONSHIP_EDGE |
//                              MARKET_LEAD | SOURCE_DOC | MANUAL | EXTERNAL
//    ProjectEntity.role:       DEVELOPER | OWNER | GC | ARCHITECT | ENGINEER
//                              | BROKER | TENANT | LENDER | MUNICIPALITY |
//                              AGENCY | OTHER
//    ProjectTimelineEvent.eventType:
//                              SIGNAL_ATTACHED | SIGNAL_DETACHED |
//                              ENTITY_ATTACHED | ENTITY_REMOVED |
//                              PARCEL_ATTACHED | STATE_TRANSITION |
//                              PROBABILITY_UPDATE | MANUAL_NOTE |
//                              MERGE_INTO | MERGE_RECEIVED | REVIEW_ACTION
//
//  All six dependent models cascade-delete from Project so a single project
//  removal is clean. Projects themselves should be soft-deleted via
//  reviewStatus=REJECTED rather than hard-deleted.
// ──────────────────────────────────────────────────────────────────────────────

model Project {
  id String @id @default(cuid())

  workingTitle String
  jurisdiction String?

  lifecycleState       String @default("EMERGING")
  confidence           String @default("LOW")
  reviewStatus         String @default("AUTO_AGGREGATED")
  emergenceProbability Float?

  firstSignalAt       DateTime?
  lastSignalAt        DateTime?
  estimatedStart      DateTime?
  estimatedCompletion DateTime?

  estimatedValue Float?
  estimatedSqft  Int?
  projectType    String?

  source String?
  notes  String?

  mergedIntoProjectId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  signals              ProjectSignal[]
  entities             ProjectEntity[]
  timelineEvents       ProjectTimelineEvent[]
  stateTransitions     ProjectStateTransition[]
  parcels              ProjectParcel[]
  parcelEntities       ParcelProject[]
  probabilitySnapshots ProjectProbabilitySnapshot[]

  forecastSnapshots ForecastSnapshot[]
  emergenceScores   EmergenceScore[]
  trajectories      EmergenceTrajectory[]
  probabilityTrends ProbabilityTrend[]
  expectedTimelines ExpectedTimeline[]

  outcomes Outcome[]

  watchlistItems WatchlistItem[]
  alertEvents    AlertEvent[]

  mergedInto       Project?  @relation("ProjectMergeTarget", fields: [mergedIntoProjectId], references: [id], onDelete: SetNull)
  absorbedProjects Project[] @relation("ProjectMergeTarget")

  @@index([lifecycleState])
  @@index([reviewStatus])
  @@index([jurisdiction])
  @@index([lastSignalAt])
  @@index([emergenceProbability])
  @@index([mergedIntoProjectId])
}

model ProjectSignal {
  id        String @id @default(cuid())
  projectId String

  signalKind String

  sourceMarketSignalId     String?
  sourceRelationshipEdgeId String?
  sourceMarketLeadId       String?
  sourceMarketSourceDocId  String?
  sourceExternalRef        String?

  attachReason     String
  attachScore      Float
  attachConfidence String  @default("MEDIUM")
  factorJson       String?

  attachedAt     DateTime  @default(now())
  detachedAt     DateTime?
  detachedReason String?
  detachedBy     String?

  updatedAt DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([sourceMarketSignalId])
  @@index([sourceRelationshipEdgeId])
  @@index([sourceMarketLeadId])
  @@index([sourceMarketSourceDocId])
  @@index([signalKind])
  @@index([attachedAt])
}

model ProjectEntity {
  id        String @id @default(cuid())
  projectId String
  entityId  String
  role      String

  confidence   String @default("MEDIUM")
  attachReason String

  firstSeenAt DateTime @default(now())
  lastSeenAt  DateTime @default(now())

  removed       Boolean @default(false)
  removedReason String?
  removedBy     String?

  attachedAt DateTime @default(now())
  updatedAt  DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, entityId, role])
  @@index([projectId])
  @@index([entityId])
  @@index([role])
  @@index([removed])
}

model ProjectTimelineEvent {
  id        String @id @default(cuid())
  projectId String

  eventType  String
  occurredAt DateTime
  recordedAt DateTime @default(now())

  summary     String
  payloadJson String?

  sourceRefKind String?
  sourceRefId   String?

  actorUserId String?
  actorEmail  String?

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, occurredAt])
  @@index([eventType])
  @@index([sourceRefId])
}

model ProjectStateTransition {
  id        String @id @default(cuid())
  projectId String

  fromState String
  toState   String
  reason    String

  triggerSignalRefKind String?
  triggerSignalRefId   String?

  actorUserId String?
  actorEmail  String?

  occurredAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, occurredAt])
  @@index([toState])
}

model ProjectParcel {
  id        String @id @default(cuid())
  projectId String

  parcelId     String
  parcelSource String
  address      String?
  jurisdiction String?

  lat      Float?
  lng      Float?
  areaSqft Float?

  attachReason String
  confidence   String @default("MEDIUM")

  // ── Phase MI-7 additive parcel-entity link ───────────────────────────────
  // Populated by the MI-7 resolver / backfill as it resolves free-text
  // parcelId strings into canonical Parcel rows. NULL on existing rows; reads
  // continue to function via the (parcelId, parcelSource) free-text columns
  // above (dual-read pattern, mirrors MI-1's RelationshipEdge augmentation).
  canonicalParcelId        String?
  parcelResolverVersion    String?
  parcelResolverConfidence String?

  attachedAt DateTime @default(now())
  updatedAt  DateTime @updatedAt

  project         Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  canonicalParcel Parcel? @relation(fields: [canonicalParcelId], references: [id], onDelete: SetNull)

  @@unique([projectId, parcelId, parcelSource])
  @@index([projectId])
  @@index([parcelId])
  @@index([jurisdiction])
  @@index([canonicalParcelId])
}

model ProjectProbabilitySnapshot {
  id        String @id @default(cuid())
  projectId String

  probability    Float
  lifecycleState String
  factorsJson    String
  computedAt     DateTime @default(now())

  actorUserId String?
  actorEmail  String?
  reason      String?

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, computedAt])
}

model EntityWatchlistSeed {
  id String @id @default(cuid())

  // Raw + normalized form of the canonical name as it appears in the
  // immutable seed source (docs/sources/ENTITIES_WATCHLIST.md). MI-3 backfill
  // reads these rows to materialize Entity rows + EntityAlias rows.
  rawName        String // "Hubbell Realty Company"
  normalizedName String // "hubbellrealty"

  entityType String // matches Entity.entityType pseudo-enum
  category   String? // markdown section heading: "Developers / Owners",
  // "Corporates (likely repeat capital projects)",
  // "General Contractors (regional + national active in DSM)"
  seedSource String  @default("docs/sources/ENTITIES_WATCHLIST.md")

  notes String? // free-text context carried over from the markdown

  reviewStatus String @default("AUTO") // AUTO | VERIFIED | REJECTED

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([normalizedName])
  @@index([entityType])
  @@index([reviewStatus])
}

// ──────────────────────────────────────────────────────────────────────────────
//  Market Intelligence: Parcel Memory + Spatial Emergence Intelligence (MI-7)
//
//  Persistent geographic market memory. Construction emergence is fundamentally
//  geographic pressure evolving over time; the platform must model not only
//  WHO / WHAT / WHEN (entities, signals, projects, timeline) but WHERE.
//
//  Schema-only here. Services in lib/services/parcelMemory ship in the same
//  PR but do not mutate ingestion paths. Live ingestion hookup, backfill, and
//  spatial UI follow in MI-7 PR-2 and MI-7 PR-3 respectively.
//
//  All ten models are additive. The only existing-table change is the
//  augmentation of ProjectParcel with three nullable columns (canonical link,
//  resolver version, confidence) — strict dual-read; older rows untouched.
//
//  Pseudo-enum field values (validated in app code, not in Prisma):
//    Parcel.parcelKind:        ASSESSOR | LEGAL | ADDRESS_ONLY | UTILITY |
//                              CORRIDOR | UNKNOWN
//    Parcel.reviewStatus:      AUTO | AUTO_MATCHED | PENDING_REVIEW |
//                              VERIFIED | REJECTED | MERGED
//    Parcel.confidence:        LOW | MEDIUM | HIGH | VERIFIED
//    ParcelAlias.aliasKind:    LEGAL_DESCRIPTION | ASSESSOR_NAME |
//                              ADDRESS | UTILITY_REF | INFORMAL | OTHER
//    ParcelOwnershipPeriod.transferKind:
//                              SALE | INHERITANCE | FORECLOSURE |
//                              ASSEMBLAGE | SPLIT | UNKNOWN
//    ParcelAdjacency.adjacencyKind:
//                              SHARED_BOUNDARY | ACROSS_STREET | CORRIDOR |
//                              SAME_BLOCK | NEARBY | INFERRED
//    ParcelSignal.signalKind:  MARKET_SIGNAL | RELATIONSHIP_EDGE |
//                              MARKET_LEAD | SOURCE_DOC | MANUAL | EXTERNAL
//    ParcelZoningContext.zoningKind:
//                              CURRENT | PROPOSED | OVERLAY | HISTORICAL |
//                              SUBJECT_OF_REZONING
//    ParcelUtilityContext.utilityKind:
//                              WATER | SEWER | STORM | ELECTRIC | GAS |
//                              FIBER | OTHER
//    ParcelUtilityContext.availability:
//                              AVAILABLE | PROPOSED | UNDER_CONSTRUCTION |
//                              INSUFFICIENT | UNKNOWN
//
//  Cascades: ParcelAlias / ParcelOwnershipPeriod / ParcelSignal / ParcelProject /
//  ParcelAdjacency / ParcelJurisdiction / ParcelUtilityContext /
//  ParcelZoningContext / ParcelPressureSnapshot all CASCADE from Parcel.
//  Parcel itself should be soft-deleted via reviewStatus=REJECTED rather than
//  hard-deleted; merges follow MI-7 PR-3 governance.
// ──────────────────────────────────────────────────────────────────────────────

model Parcel {
  id String @id @default(cuid())

  // Canonical naming + identity. canonicalRef is the operator-facing label;
  // normalizedRef is the dedup key (lowercased alphanumeric form produced by
  // lib/services/parcelMemory/normalize.ts).
  canonicalRef  String // "Polk Co Parcel 010-12345-678" | "5301 Mills Civic Pkwy"
  normalizedRef String @unique
  parcelKind    String @default("UNKNOWN")

  // Optional canonical descriptors. May be NULL when the parcel is known only
  // by an address or by an assessor name; the resolver fills these in over
  // time as additional signals arrive.
  assessorParcelId String? // "010-12345-678"
  legalDescription String?
  primaryAddress   String?
  jurisdiction     String? // city / county / metro
  state            String? // two-letter; optional but indexed

  // Geographic centroid (when known). Avoid raw geometry storage — Turso
  // doesn't have postgis. Boundary geometry is deferred to MI-7 PR-3 maps.
  centroidLat Float?
  centroidLng Float?
  areaSqft    Float?

  // Workflow + provenance
  reviewStatus String  @default("AUTO") // AUTO | AUTO_MATCHED | PENDING_REVIEW | VERIFIED | REJECTED | MERGED
  confidence   String  @default("MEDIUM") // LOW | MEDIUM | HIGH | VERIFIED
  source       String? // "permit_feed" | "assessor" | "manual" | "backfill"
  notes        String?

  // Soft-merge target. When two Parcel rows are operator-merged, the absorbed
  // row keeps reviewStatus=MERGED and mergedIntoParcelId pointing at the
  // winner; loose pointers in ProjectParcel.canonicalParcelId continue to
  // resolve correctly via the relation walk.
  mergedIntoParcelId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  aliases             ParcelAlias[]
  ownershipPeriods    ParcelOwnershipPeriod[]
  signals             ParcelSignal[]
  projectLinks        ParcelProject[]
  outgoingAdjacencies ParcelAdjacency[]        @relation("ParcelAdjacencyFrom")
  incomingAdjacencies ParcelAdjacency[]        @relation("ParcelAdjacencyTo")
  jurisdictions       ParcelJurisdiction[]
  utilityContexts     ParcelUtilityContext[]
  zoningContexts      ParcelZoningContext[]
  pressureSnapshots   ParcelPressureSnapshot[]

  // Phase MI-8 forecasting back-relations.
  forecastSnapshots ForecastSnapshot[]
  emergenceScores   EmergenceScore[]
  trajectories      EmergenceTrajectory[]
  probabilityTrends ProbabilityTrend[]
  expectedTimelines ExpectedTimeline[]

  // Phase MI-9 outcome back-relation.
  outcomes Outcome[]

  // Phase MI-10 workspace back-relations.
  watchlistItems WatchlistItem[]
  alertEvents    AlertEvent[]

  mergedInto      Parcel?  @relation("ParcelMergeTarget", fields: [mergedIntoParcelId], references: [id], onDelete: SetNull)
  absorbedParcels Parcel[] @relation("ParcelMergeTarget")

  // Legacy ProjectParcel rows that have been resolved to this canonical parcel.
  legacyProjectParcels ProjectParcel[]

  @@index([parcelKind])
  @@index([reviewStatus])
  @@index([jurisdiction])
  @@index([state])
  @@index([assessorParcelId])
  @@index([primaryAddress])
  @@index([mergedIntoParcelId])
}

model ParcelAlias {
  id              String  @id @default(cuid())
  parcelId        String
  alias           String // raw form — "5301 Mills Civic Pkwy" | "Polk 010-12345-678"
  normalizedAlias String // dedup key (same normalizer as Parcel.normalizedRef)
  aliasKind       String  @default("INFORMAL")
  confidence      String  @default("MEDIUM")
  source          String? // "permit" | "minutes" | "assessor" | "backfill" | "manual"

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  parcel Parcel @relation(fields: [parcelId], references: [id], onDelete: Cascade)

  @@unique([parcelId, normalizedAlias])
  @@index([normalizedAlias])
  @@index([parcelId])
  @@index([aliasKind])
}

// Temporal ownership continuity. One row per (parcel, owner-entity, period).
// Periods may be open-ended (ownedTo = NULL = current). Owners are linked to
// Entity (MI-1) via ownerEntityId, but ownerNameRaw is kept for cases where
// the resolver hasn't matched yet.
model ParcelOwnershipPeriod {
  id       String @id @default(cuid())
  parcelId String

  ownerEntityId String?
  ownerNameRaw  String

  ownedFrom DateTime
  ownedTo   DateTime?

  transferKind  String  @default("UNKNOWN")
  transferValue Float? // sale price when known
  source        String? // "assessor" | "deed" | "press" | "manual"
  sourceUrl     String?
  confidence    String  @default("MEDIUM")
  notes         String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  parcel Parcel @relation(fields: [parcelId], references: [id], onDelete: Cascade)

  @@index([parcelId, ownedFrom])
  @@index([ownerEntityId])
  @@index([ownedTo])
}

// Loose attachment of any signal kind to a canonical parcel. The exact
// source row (MarketSignal / RelationshipEdge / MarketLead / etc.) is
// referenced via loose pointers so the parcel-memory layer can stay
// additive and not require an existing FK on every signal table.
model ParcelSignal {
  id       String @id @default(cuid())
  parcelId String

  signalKind String

  sourceMarketSignalId     String?
  sourceRelationshipEdgeId String?
  sourceMarketLeadId       String?
  sourceMarketSourceDocId  String?
  sourceExternalRef        String?

  // What about this signal made the system attach it to this parcel? Examples:
  // "permit metadata parcel id match" | "address normalized match" |
  // "legal description match" | "manual operator attach".
  attachReason     String
  attachScore      Float   @default(0)
  attachConfidence String  @default("MEDIUM")
  factorJson       String?

  // Recorded once per (parcel, source row) — re-observed signals advance
  // lastObservedAt instead of inserting a duplicate row.
  firstObservedAt DateTime @default(now())
  lastObservedAt  DateTime @default(now())

  // Soft-detach via timestamp — preserves source lineage. Mirrors MI-6
  // ProjectSignal pattern.
  detachedAt     DateTime?
  detachedReason String?
  detachedBy     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  parcel Parcel @relation(fields: [parcelId], references: [id], onDelete: Cascade)

  @@index([parcelId])
  @@index([signalKind])
  @@index([sourceMarketSignalId])
  @@index([sourceRelationshipEdgeId])
  @@index([sourceMarketLeadId])
  @@index([sourceMarketSourceDocId])
  @@index([firstObservedAt])
}

// Canonical Parcel ↔ Project link. Distinct from the legacy ProjectParcel
// model — that one holds free-text parcelIds attached during MI-6 aggregation
// and is preserved unchanged. ParcelProject is the MI-7 canonical link, with
// FK integrity on both sides.
model ParcelProject {
  id        String @id @default(cuid())
  parcelId  String
  projectId String

  attachReason String
  confidence   String @default("MEDIUM")
  // "primary" means this parcel is THE site for the project; secondary parcels
  // are supporting (corridor, easement, adjacent acquisition, etc.).
  role         String @default("primary")

  firstSeenAt DateTime @default(now())
  lastSeenAt  DateTime @default(now())

  detachedAt     DateTime?
  detachedReason String?
  detachedBy     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  parcel  Parcel  @relation(fields: [parcelId], references: [id], onDelete: Cascade)
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([parcelId, projectId, role])
  @@index([parcelId])
  @@index([projectId])
  @@index([role])
}

// Spatial graph of neighbor relationships. Symmetric in principle but stored
// directionally so the platform can express asymmetric relationships like
// "ACROSS_STREET from a corridor parcel onto a back-lot". inferConfidence
// reflects how strong the spatial-inference is — pixel-perfect parcel-boundary
// shares score VERIFIED, while heuristic same-block guesses score LOW.
model ParcelAdjacency {
  id            String @id @default(cuid())
  fromParcelId  String
  toParcelId    String
  adjacencyKind String @default("INFERRED")

  // Optional spatial descriptors when known.
  approxDistanceFt Float?
  bearingDegrees   Float? // 0..360, optional

  source       String? // "assessor_boundary" | "address_grid" | "manual" | "backfill"
  confidence   String  @default("LOW")
  reviewStatus String  @default("AUTO") // AUTO | VERIFIED | REJECTED
  notes        String?

  firstObservedAt DateTime @default(now())
  lastObservedAt  DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  fromParcel Parcel @relation("ParcelAdjacencyFrom", fields: [fromParcelId], references: [id], onDelete: Cascade)
  toParcel   Parcel @relation("ParcelAdjacencyTo", fields: [toParcelId], references: [id], onDelete: Cascade)

  @@unique([fromParcelId, toParcelId, adjacencyKind])
  @@index([fromParcelId])
  @@index([toParcelId])
  @@index([adjacencyKind])
}

// Jurisdiction continuity. Most parcels stay in one jurisdiction forever;
// some are annexed, deannexed, or rezoned-out. Each row is a (parcel, jur,
// period) tuple. Open-ended periods (effectiveTo = NULL) are the current
// state.
model ParcelJurisdiction {
  id       String @id @default(cuid())
  parcelId String

  jurisdiction     String // "City of West Des Moines" | "Polk County" | "Iowa DOT"
  jurisdictionKind String @default("MUNICIPALITY") // MUNICIPALITY | COUNTY | STATE | OVERLAY | UTILITY_DISTRICT

  effectiveFrom DateTime
  effectiveTo   DateTime?

  source     String? // "assessor" | "annexation" | "manual" | "backfill"
  confidence String  @default("MEDIUM")
  notes      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  parcel Parcel @relation(fields: [parcelId], references: [id], onDelete: Cascade)

  @@index([parcelId, effectiveFrom])
  @@index([jurisdiction])
  @@index([effectiveTo])
}

// Per-utility availability context. One row per (parcel, utilityKind, period).
// Periods are bounded the same way as jurisdictions; AVAILABLE → PROPOSED →
// UNDER_CONSTRUCTION → AVAILABLE state transitions are common in growth
// corridors and the row history captures that evolution.
model ParcelUtilityContext {
  id       String @id @default(cuid())
  parcelId String

  utilityKind  String // WATER | SEWER | STORM | ELECTRIC | GAS | FIBER | OTHER
  availability String  @default("UNKNOWN")
  providerName String?
  capacity     String? // free-text — "12-inch water main" | "300 amp service"

  effectiveFrom DateTime
  effectiveTo   DateTime?

  source     String?
  confidence String  @default("MEDIUM")
  notes      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  parcel Parcel @relation(fields: [parcelId], references: [id], onDelete: Cascade)

  @@index([parcelId, utilityKind, effectiveFrom])
  @@index([availability])
}

// Per-zoning context. Same period pattern. zoningKind distinguishes CURRENT
// zoning from a PROPOSED rezoning request (entitlement signal) and from
// HISTORICAL records preserved for continuity.
model ParcelZoningContext {
  id       String @id @default(cuid())
  parcelId String

  zoningCode  String // "C-2" | "M-1" | "PUD" | "MIXED_USE"
  zoningKind  String  @default("CURRENT")
  overlayCode String? // e.g. floodplain overlay, TIF district

  effectiveFrom DateTime
  effectiveTo   DateTime?

  // When this row represents a PROPOSED rezoning request, link it back to the
  // signal that introduced it for explainability.
  triggerSignalRefKind String?
  triggerSignalRefId   String?

  source     String?
  confidence String  @default("MEDIUM")
  notes      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  parcel Parcel @relation(fields: [parcelId], references: [id], onDelete: Cascade)

  @@index([parcelId, effectiveFrom])
  @@index([zoningCode])
  @@index([zoningKind])
}

// Time series of computed pressure scores. Append-only; never overwritten.
// Each row captures the full factor breakdown that produced the score so the
// system can answer "WHY is this parcel under pressure right now?" at any
// past point in time.
model ParcelPressureSnapshot {
  id       String @id @default(cuid())
  parcelId String

  pressureScore   Float // 0..1 composite
  // factorsJson is a stringified Record<factorName, score> + supporting
  // breakdown (contributing project ids, entity ids, adjacency ids, etc.).
  factorsJson     String
  // Pressure-engine version that produced this snapshot. Lets future engine
  // upgrades selectively re-evaluate historical pressure.
  pressureVersion String @default("v1")

  computedAt DateTime @default(now())
  reason     String? // "scheduled" | "signal_attached" | "manual" | "backfill"

  actorUserId String?
  actorEmail  String?

  parcel Parcel @relation(fields: [parcelId], references: [id], onDelete: Cascade)

  @@index([parcelId, computedAt])
  @@index([pressureScore])
}

// ──────────────────────────────────────────────────────────────────────────────
//  Market Intelligence: Emergence Probability Engine + Forecasting (MI-8)
//
//  Trajectory intelligence — the layer that answers "what is likely to happen
//  next?" instead of just "what has happened?". Builds on top of MI-6's
//  ProjectProbabilitySnapshot history and MI-7's ParcelPressureSnapshot
//  history. Deterministic-first: no black-box ML, no embeddings, no opaque
//  forecasting. Every forecast is replayable from its inputs and explainable
//  via per-factor reason logs.
//
//  Schema-only in MI-8 PR-1. Service layer in lib/services/emergenceProbability
//  ships in the same PR but does not mutate ingestion paths or production data.
//  Live wiring + backfill follow in subsequent PRs.
//
//  All ten models are additive. No existing table is altered.
//
//  Subject loose-pointer pattern:
//    Every forecast targets a subject identified by (subjectKind, subjectId).
//    subjectKind: PROJECT | PARCEL | CORRIDOR | JURISDICTION | DEVELOPER
//    subjectId  : the row's id in the corresponding canonical table OR
//                 (for CORRIDOR/JURISDICTION/DEVELOPER) a deterministic string
//                 key (e.g. "jurisdiction:West Des Moines" or
//                 "developer:<entityId>").
//    This keeps the engine pluggable across subject kinds without forcing
//    nine FKs on every forecast row. Where strong FKs are valuable, we still
//    declare them — e.g., ForecastSnapshot.projectId → Project (nullable).
//
//  Pseudo-enum field values (validated in app code):
//    ForecastSnapshot.subjectKind:   PROJECT | PARCEL | CORRIDOR |
//                                    JURISDICTION | DEVELOPER
//    EmergenceTrajectory.state:      EMERGING | IGNITING | ACCELERATING |
//                                    STEADY | DECELERATING | STALLED |
//                                    DECAYING | DORMANT
//    ProbabilityTrend.direction:     UP | DOWN | FLAT
//    ExpectedTimeline.milestoneKind: ENTITLEMENT_START | ENTITLEMENT_DECISION |
//                                    PERMIT_ISSUED | SITE_PREP_START |
//                                    CONSTRUCTION_START | COMPLETION
//    JurisdictionVelocity.cadenceClass: HOT | WARM | STEADY | COOLING | COLD
//    CorridorHeat.classification:    IGNITING | HOT | WARM | STEADY | COOLING
//    DevelopmentMomentum.classification:
//                                    ACCELERATING | SUSTAINED | FADING | DORMANT
//    SignalDecayProfile.curveShape:  EXPONENTIAL | LINEAR | STEP | SUSTAINED
//    ForecastSnapshot.reviewStatus:  AUTO | PENDING_REVIEW | VERIFIED |
//                                    OVERRIDDEN | SUPPRESSED
//    ForecastExplanation.factorKind: SIGNAL_CONTRIBUTION | ENTITY_INFLUENCE |
//                                    PARCEL_INFLUENCE | JURISDICTION_PATTERN |
//                                    TEMPORAL_DECAY | TRAJECTORY_SHIFT |
//                                    CORRIDOR_HEAT | OTHER
//
//  Cascades:
//    Per-subject "current state" rows (EmergenceScore, EmergenceTrajectory,
//    ExpectedTimeline) use SetNull on Project / Parcel delete — projections
//    survive cleanup. ForecastSnapshot.projectId / parcelId likewise SetNull
//    so historical lineage is preserved.
//    ForecastExplanation rows CASCADE from ForecastSnapshot (an explanation
//    is meaningless without its parent forecast).
//
//  ForecastSnapshot is the central append-only record. Everything else is
//  either configuration (SignalDecayProfile), current-state projection
//  (EmergenceScore, EmergenceTrajectory, ExpectedTimeline,
//  JurisdictionVelocity, CorridorHeat, DevelopmentMomentum), or structured
//  explanation (ForecastExplanation, ProbabilityTrend).
// ──────────────────────────────────────────────────────────────────────────────

model ForecastSnapshot {
  id String @id @default(cuid())

  subjectKind String
  subjectId   String
  projectId   String?
  parcelId    String?

  emergenceScore       Float
  accelerationIndex    Float
  momentumScore        Float
  decayScore           Float
  corridorHeatScore    Float?
  jurisdictionVelocity Float?

  trajectoryState String
  confidence      String @default("MEDIUM")

  forecastVersion String @default("v1")

  reviewStatus       String  @default("AUTO")
  overriddenByUserId String?
  overriddenByEmail  String?
  overrideReason     String?

  triggerReason String @default("scheduled")

  computedAt DateTime @default(now())
  recordedAt DateTime @default(now())

  payloadJson String

  project            Project?              @relation(fields: [projectId], references: [id], onDelete: SetNull)
  parcel             Parcel?               @relation(fields: [parcelId], references: [id], onDelete: SetNull)
  explanations       ForecastExplanation[]
  outcomeResolutions OutcomeResolution[]
  alertEvents        AlertEvent[]

  @@index([subjectKind, subjectId, computedAt])
  @@index([projectId, computedAt])
  @@index([parcelId, computedAt])
  @@index([emergenceScore])
  @@index([trajectoryState])
  @@index([reviewStatus])
  @@index([forecastVersion])
}

model EmergenceScore {
  id String @id @default(cuid())

  subjectKind String
  subjectId   String
  projectId   String?
  parcelId    String?

  score      Float
  confidence String @default("MEDIUM")

  latestSnapshotId String?
  latestComputedAt DateTime @default(now())

  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  project Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  parcel  Parcel?  @relation(fields: [parcelId], references: [id], onDelete: SetNull)

  @@unique([subjectKind, subjectId])
  @@index([projectId])
  @@index([parcelId])
  @@index([score])
  @@index([latestComputedAt])
}

model EmergenceTrajectory {
  id String @id @default(cuid())

  subjectKind String
  subjectId   String
  projectId   String?
  parcelId    String?

  state          String   @default("EMERGING")
  previousState  String?
  streakLength   Int      @default(1)
  stateEnteredAt DateTime @default(now())

  shortTermDelta Float @default(0)
  longTermDelta  Float @default(0)
  acceleration   Float @default(0)

  shiftDetected Boolean @default(false)
  shiftReason   String?

  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  project Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  parcel  Parcel?  @relation(fields: [parcelId], references: [id], onDelete: SetNull)

  @@unique([subjectKind, subjectId])
  @@index([state])
  @@index([projectId])
  @@index([parcelId])
  @@index([shiftDetected])
}

model ProbabilityTrend {
  id String @id @default(cuid())

  subjectKind String
  subjectId   String
  projectId   String?
  parcelId    String?

  previousScore Float
  currentScore  Float
  delta         Float
  direction     String
  windowDays    Int

  snapshotId String?

  recordedAt DateTime @default(now())

  project Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  parcel  Parcel?  @relation(fields: [parcelId], references: [id], onDelete: SetNull)

  @@index([subjectKind, subjectId, recordedAt])
  @@index([projectId, recordedAt])
  @@index([parcelId, recordedAt])
  @@index([direction])
  @@index([windowDays])
}

model ExpectedTimeline {
  id String @id @default(cuid())

  subjectKind String
  subjectId   String
  projectId   String?
  parcelId    String?

  milestoneKind String

  earliestEstimate DateTime?
  expectedEstimate DateTime?
  latestEstimate   DateTime?

  confidence String  @default("MEDIUM")
  rationale  String?

  latestSnapshotId String?
  latestComputedAt DateTime @default(now())

  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  project Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  parcel  Parcel?  @relation(fields: [parcelId], references: [id], onDelete: SetNull)

  @@unique([subjectKind, subjectId, milestoneKind])
  @@index([projectId])
  @@index([parcelId])
  @@index([milestoneKind])
  @@index([expectedEstimate])
}

model JurisdictionVelocity {
  id                String @id @default(cuid())
  jurisdictionKey   String @unique
  jurisdictionLabel String

  newProjectsLast30d  Int @default(0)
  newProjectsLast90d  Int @default(0)
  newProjectsLast365d Int @default(0)

  newSignalsLast30d Int @default(0)
  newSignalsLast90d Int @default(0)

  velocityScore Float  @default(0)
  cadenceClass  String @default("STEADY")

  acceleration Float @default(0)

  computedAt DateTime @default(now())
  updatedAt  DateTime @updatedAt
  createdAt  DateTime @default(now())

  @@index([cadenceClass])
  @@index([velocityScore])
  @@index([acceleration])
}

model CorridorHeat {
  id            String @id @default(cuid())
  corridorKey   String @unique
  corridorLabel String

  memberParcelIds    String
  memberSetTruncated Boolean @default(false)

  heatScore     Float
  meanPressure  Float @default(0)
  acceleration  Float @default(0)
  activeMembers Int   @default(0)

  classification String @default("STEADY")

  computedAt DateTime @default(now())
  updatedAt  DateTime @updatedAt
  createdAt  DateTime @default(now())

  @@index([classification])
  @@index([heatScore])
  @@index([acceleration])
}

model DevelopmentMomentum {
  id                 String  @id @default(cuid())
  developerEntityId  String  @unique
  developerNameCache String?

  newProjectsLast30d  Int @default(0)
  newProjectsLast90d  Int @default(0)
  newProjectsLast365d Int @default(0)
  newParcelsLast90d   Int @default(0)

  momentumScore  Float  @default(0)
  acceleration   Float  @default(0)
  classification String @default("DORMANT")

  computedAt DateTime @default(now())
  updatedAt  DateTime @updatedAt
  createdAt  DateTime @default(now())

  @@index([classification])
  @@index([momentumScore])
  @@index([acceleration])
}

model SignalDecayProfile {
  id         String @id @default(cuid())
  signalType String @unique
  curveShape String @default("EXPONENTIAL")

  halfLifeDays Int   @default(60)
  floorWeight  Float @default(0)

  baseWeight Float @default(1)

  notes  String?
  source String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([signalType])
  @@index([curveShape])
}

model ForecastExplanation {
  id         String @id @default(cuid())
  snapshotId String

  factorKind   String
  factorName   String
  factorScore  Float
  factorWeight Float
  contribution Float

  sourceRefKind String?
  sourceRefId   String?

  rationale String

  recordedAt DateTime @default(now())

  snapshot ForecastSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)

  @@index([snapshotId])
  @@index([factorKind])
  @@index([factorName])
  @@index([contribution])
}

// ──────────────────────────────────────────────────────────────────────────────
//  Market Intelligence: Outcome Tracking + Forecast Calibration (MI-9)
//
//  Feedback intelligence — the layer that teaches the platform whether its
//  predictions matched reality. Builds on top of MI-8's ForecastSnapshot
//  history. Deterministic-first: no black-box self-modifying behavior, no
//  silent forecast retrofits, no destruction of historical lineage.
//
//  Schema-only in MI-9 PR-1. Service layer in lib/services/outcomeCalibration
//  ships in the same PR but does not mutate any historical forecast row.
//  Calibration coefficients are advisory inputs to the next forecast cycle,
//  not retroactive rewrites of past forecasts.
//
//  All ten models are additive. No existing table is altered.
//
//  Outcome ontology (Outcome.outcomeKind pseudo-enum):
//    CONSTRUCTION_STARTED
//    PERMIT_ISSUED
//    BID_ISSUED
//    PROJECT_ABANDONED
//    PROJECT_STALLED
//    TIMELINE_SLIPPED
//    SHELL_REALIZED
//    FRANCHISE_ROLLOUT_CONFIRMED
//    ZONING_FAILED
//    UTILITY_EXPANSION_COMPLETED
//    CORRIDOR_ACCELERATION_CONFIRMED
//    OTHER
//
//  Subject loose-pointer pattern: every outcome targets a subject identified
//  by (subjectKind, subjectId), mirroring MI-8's pattern. Strong nullable FKs
//  to Project / Parcel are kept for relational queries.
//
//  Pseudo-enum field values (validated in app code):
//    Outcome.outcomeKind:               (see above)
//    Outcome.detectionMethod:           AUTOMATIC | OPERATOR_REPORTED |
//                                       EXTERNAL_FEED | INFERRED
//    Outcome.subjectKind:               PROJECT | PARCEL | CORRIDOR |
//                                       JURISDICTION | DEVELOPER
//    OutcomeEvidence.evidenceKind:      MARKET_SIGNAL | DOCUMENT |
//                                       PRESS_RELEASE | OPERATOR_NOTE |
//                                       EXTERNAL_FEED | PHOTO | OTHER
//    OutcomeResolution.resolutionState: PENDING | CONFIRMED | PARTIAL |
//                                       DISCONFIRMED | DISPUTED | WITHDRAWN
//    OutcomeResolution.predictionPosture: HIGH_CONF_PREDICTED |
//                                       MEDIUM_CONF_PREDICTED |
//                                       LOW_CONF_PREDICTED | UNPREDICTED
//    ForecastAccuracy.accuracyKind:     PROBABILITY | TIMELINE |
//                                       TRAJECTORY | OUTCOME_KIND |
//                                       CORRIDOR | COMPOSITE
//    TrajectoryOutcome.alignment:       ALIGNED | DIVERGED | EARLY_SHIFT |
//                                       MISSED_SHIFT | INCONCLUSIVE
//    FalsePositive.reasonClass:         OVERWEIGHTED_DEVELOPER |
//                                       OVERWEIGHTED_CONTINUANCE |
//                                       OVERWEIGHTED_UTILITY |
//                                       STALE_SIGNAL_CARRYOVER |
//                                       JURISDICTION_LAG_UNDERESTIMATED |
//                                       SHELL_CLUSTER_MISREAD | OTHER
//    FalseNegative.reasonClass:         UNDERWEIGHTED_PARCEL |
//                                       UNDERWEIGHTED_INFRASTRUCTURE |
//                                       MISSED_CORRIDOR_IGNITION |
//                                       MISSED_FRANCHISE_PATTERN |
//                                       NEW_SIGNAL_TYPE | OTHER
//    CalibrationSnapshot.scope:         GLOBAL | JURISDICTION | CORRIDOR |
//                                       SUBJECT_KIND | FACTOR
//    ForecastCalibration.scope:         GLOBAL | JURISDICTION | CORRIDOR |
//                                       SUBJECT_KIND | FACTOR
//    ForecastCalibration.adjustmentKind: WEIGHT_MULTIPLIER | DECAY_OVERRIDE |
//                                       LAG_DAYS | THRESHOLD_OVERRIDE
//
//  Cascades:
//    OutcomeEvidence CASCADE from Outcome — evidence is meaningless detached
//    from its outcome.
//    OutcomeResolution.outcomeId CASCADE from Outcome; .forecastSnapshotId
//    SetNull (a forecast deletion is unusual but must not lose outcome
//    lineage).
//    ForecastAccuracy.resolutionId CASCADE from OutcomeResolution.
//    TrajectoryOutcome.resolutionId CASCADE from OutcomeResolution.
//    TimelineAccuracy.resolutionId CASCADE from OutcomeResolution.
//    FalsePositive / FalseNegative cascade from their parent Outcome or
//    Resolution where applicable.
//
//  Append-only lineage discipline:
//    - Outcome rows are append-only; corrections create a new Outcome with
//      `supersededByOutcomeId` pointing to the replacement and
//      `resolutionState=WITHDRAWN` on the original's resolution.
//    - Past ForecastAccuracy rows are NEVER mutated. Recomputation appends
//      a new row with a fresh `evaluationVersion`.
//    - CalibrationSnapshot is strictly append-only.
//
//  Bumps to CALIBRATION_VERSION (in app code, recorded on every accuracy /
//  calibration row) flag schema-and-algorithm generations the same way
//  FORECAST_VERSION tags emergence forecasts.
// ──────────────────────────────────────────────────────────────────────────────

model Outcome {
  id String @id @default(cuid())

  // Subject identity. subjectKind + subjectId is the universal pointer;
  // strong FKs are nullable for relational query convenience.
  subjectKind String
  subjectId   String
  projectId   String?
  parcelId    String?

  // Outcome type + observation metadata.
  outcomeKind     String
  outcomeLabel    String? // operator-facing label override
  detectionMethod String  @default("AUTOMATIC")

  // When the outcome actually occurred (operator-best-knowledge), and
  // when the platform observed it. These can differ — a permit issued
  // 3 weeks ago that we discover today has observedAt = today but
  // occurredAt = 3 weeks ago.
  occurredAt DateTime
  observedAt DateTime @default(now())

  // Confidence in the outcome itself (not in any forecast).
  outcomeConfidence String @default("MEDIUM") // LOW | MEDIUM | HIGH | VERIFIED

  // Free-text rationale + optional structured payload.
  notes       String?
  payloadJson String?

  // Append-only supersede chain. When an operator corrects an Outcome
  // (wrong date, wrong subject, retraction), a NEW Outcome row is created
  // and the original gets supersededByOutcomeId pointing at it.
  supersededByOutcomeId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project        Project?            @relation(fields: [projectId], references: [id], onDelete: SetNull)
  parcel         Parcel?             @relation(fields: [parcelId], references: [id], onDelete: SetNull)
  evidence       OutcomeEvidence[]
  resolutions    OutcomeResolution[]
  falsePositives FalsePositive[]
  falseNegatives FalseNegative[]
  supersededBy   Outcome?            @relation("OutcomeSupersede", fields: [supersededByOutcomeId], references: [id], onDelete: SetNull)
  supersedes     Outcome[]           @relation("OutcomeSupersede")

  @@index([subjectKind, subjectId, occurredAt])
  @@index([outcomeKind])
  @@index([projectId])
  @@index([parcelId])
  @@index([occurredAt])
  @@index([observedAt])
  @@index([supersededByOutcomeId])
}

// Per-outcome evidence rows. Each evidence row points back to its source
// (MarketSignal, MarketSourceDoc, MarketLead, operator note, external feed)
// via loose pointer (sourceRefKind + sourceRefId) — same pattern as MI-7
// ParcelSignal.
model OutcomeEvidence {
  id        String @id @default(cuid())
  outcomeId String

  evidenceKind  String
  sourceRefKind String?
  sourceRefId   String?
  sourceUrl     String?

  capturedAt DateTime
  observedAt DateTime @default(now())

  rationale   String
  payloadJson String?

  // Optional operator vouching.
  vouchedByUserId String?
  vouchedByEmail  String?
  vouchedAt       DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  outcome Outcome @relation(fields: [outcomeId], references: [id], onDelete: Cascade)

  @@index([outcomeId])
  @@index([evidenceKind])
  @@index([capturedAt])
  @@index([sourceRefKind, sourceRefId])
}

// One row per (Outcome, ForecastSnapshot) pair. This is where the platform
// records "did this forecast predict this outcome?" — and it's the row the
// accuracy / calibration services attach to.
//
// resolutionState transitions are append-only via new rows: a DISPUTED row
// for the same (outcome, snapshot) creates a NEW OutcomeResolution row
// rather than mutating an existing one.
model OutcomeResolution {
  id                 String  @id @default(cuid())
  outcomeId          String
  // The forecast snapshot being evaluated. Null when the outcome had no
  // matching forecast (a UNPREDICTED FalseNegative case).
  forecastSnapshotId String?

  resolutionState   String @default("PENDING")
  predictionPosture String @default("UNPREDICTED")

  // Snapshot of the forecast values at prediction time, captured here for
  // cheap query without re-joining to ForecastSnapshot. Mirrors what the
  // forecast asserted; the actual outcome is on the Outcome row.
  predictedScore      Float?
  predictedTrajectory String?
  predictedAt         DateTime?

  // How long between predictedAt and Outcome.occurredAt, in days. Negative
  // if the outcome occurred before the forecast was made (operator-late
  // outcome capture).
  leadTimeDays Float?

  resolvedAt       DateTime @default(now())
  resolvedByUserId String?
  resolvedByEmail  String?
  resolutionNotes  String?

  // Bumps when resolution policy changes. Stamps new resolutions; old ones
  // keep their stamp so historical accuracy comparisons are stable.
  calibrationVersion String @default("v1")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  outcome          Outcome           @relation(fields: [outcomeId], references: [id], onDelete: Cascade)
  forecastSnapshot ForecastSnapshot? @relation(fields: [forecastSnapshotId], references: [id], onDelete: SetNull)

  accuracies         ForecastAccuracy[]
  trajectoryOutcomes TrajectoryOutcome[]
  timelineAccuracies TimelineAccuracy[]

  @@index([outcomeId])
  @@index([forecastSnapshotId])
  @@index([resolutionState])
  @@index([predictionPosture])
  @@index([resolvedAt])
}

// Per-resolution per-accuracy-kind score record. One OutcomeResolution can
// have many ForecastAccuracy rows (one per kind: PROBABILITY, TIMELINE,
// TRAJECTORY, OUTCOME_KIND, CORRIDOR, COMPOSITE).
//
// Append-only: a re-evaluation creates a new row with a fresh evaluationVersion.
model ForecastAccuracy {
  id           String @id @default(cuid())
  resolutionId String

  accuracyKind       String
  // Numeric in [0..1] where 1 = perfectly accurate. Composite is the
  // weighted blend of the others.
  accuracyScore      Float
  // Brier-style probabilistic score for the PROBABILITY kind:
  // brier = (predictedScore - 1)² when outcome=happened, predictedScore²
  // when outcome=did-not-happen. Other kinds may store NaN — kept nullable.
  brierScore         Float?
  // Timeline-kind metrics:
  timelineErrorDays  Float? // (actualDate - expectedDate); positive = late
  withinExpectedBand Boolean? // true when actual fell within earliest..latest
  // Free-text + structured rationale.
  rationale          String
  payloadJson        String?

  evaluationVersion String @default("v1")

  computedAt DateTime @default(now())

  resolution OutcomeResolution @relation(fields: [resolutionId], references: [id], onDelete: Cascade)

  @@index([resolutionId])
  @@index([accuracyKind])
  @@index([accuracyScore])
  @@index([computedAt])
}

// Operator-tunable calibration adjustments. Read at the START of each new
// forecast cycle to modulate per-(jurisdiction, factor) weights — does NOT
// rewrite historical forecasts. Append-only by row identity, but a row's
// fields can be edited to retune; every edit bumps updatedAt and is captured
// by the next CalibrationSnapshot.
//
// scope tells the engine which subset of forecasts the row applies to:
//   GLOBAL          — every forecast
//   JURISDICTION    — forecasts whose subject's jurisdiction matches scopeKey
//   CORRIDOR        — forecasts whose subject's corridor matches scopeKey
//   SUBJECT_KIND    — forecasts of a given subjectKind
//   FACTOR          — applies to a specific factor name (e.g. "utilityExpansion")
//
// adjustmentKind determines how the value is interpreted:
//   WEIGHT_MULTIPLIER  — value × current factor weight
//   DECAY_OVERRIDE     — replaces signal-decay half-life days
//   LAG_DAYS           — added to expected-milestone date math
//   THRESHOLD_OVERRIDE — replaces a trajectory or velocity threshold
model ForecastCalibration {
  id String @id @default(cuid())

  scope      String // GLOBAL | JURISDICTION | CORRIDOR | SUBJECT_KIND | FACTOR
  scopeKey   String? // jurisdictionKey | corridorKey | subjectKind | null for GLOBAL
  factorName String? // only used when scope=FACTOR or applies to a factor

  adjustmentKind String // WEIGHT_MULTIPLIER | DECAY_OVERRIDE | LAG_DAYS | THRESHOLD_OVERRIDE
  value          Float

  // Operator-facing rationale + provenance.
  source String? // "calibration_runner" | "operator_manual" | "watchlist"
  notes  String?

  // Disable without deleting — preserves history.
  active Boolean @default(true)

  // Bumps when the algorithm that wrote the row changes — older rows know
  // which calibration generation produced them.
  calibrationVersion String @default("v1")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([scope, scopeKey, factorName, adjustmentKind])
  @@index([scope, scopeKey])
  @@index([factorName])
  @@index([adjustmentKind])
  @@index([active])
}

// Per-resolution trajectory alignment record. Records whether the trajectory
// state at prediction time matched the actual progression observed via the
// outcome.
model TrajectoryOutcome {
  id           String @id @default(cuid())
  resolutionId String

  predictedState String
  actualState    String?
  alignment      String  @default("INCONCLUSIVE")

  // True when MI-8 detected a momentum shift at prediction time AND that
  // shift turned out to correctly anticipate the outcome.
  shiftCorrect Boolean?
  // True when MI-8 missed a momentum shift that would have improved
  // prediction (post-hoc evident from outcome timing).
  shiftMissed  Boolean?

  rationale String?

  computedAt DateTime @default(now())

  resolution OutcomeResolution @relation(fields: [resolutionId], references: [id], onDelete: Cascade)

  @@index([resolutionId])
  @@index([alignment])
  @@index([shiftMissed])
}

// Per-resolution timeline-accuracy record. One row per
// (resolution, milestoneKind). Stores actual vs expected date variance.
model TimelineAccuracy {
  id           String @id @default(cuid())
  resolutionId String

  milestoneKind String
  // Forecast values captured at prediction time.
  expectedAt    DateTime?
  earliestAt    DateTime?
  latestAt      DateTime?
  // Actual observed date from the Outcome.
  actualAt      DateTime

  // Derived metrics.
  errorDays                     Float // actualAt - expectedAt (positive = late)
  absoluteErrorDays             Float
  withinBand                    Boolean // true when actualAt ∈ [earliestAt, latestAt]
  // Optional jurisdiction-relative metric: errorDays minus this
  // jurisdiction's typical lag (read from ForecastCalibration scope=JURISDICTION
  // adjustmentKind=LAG_DAYS). Lets the platform say "this was 50 days late
  // BUT this jurisdiction typically runs 45 days late, so really only 5 days
  // late by jurisdiction-norm".
  jurisdictionAdjustedErrorDays Float?

  rationale  String?
  computedAt DateTime @default(now())

  resolution OutcomeResolution @relation(fields: [resolutionId], references: [id], onDelete: Cascade)

  @@index([resolutionId])
  @@index([milestoneKind])
  @@index([errorDays])
  @@index([withinBand])
}

// One row per detected false positive — high-confidence forecast that did
// NOT result in the predicted outcome within the expected band. Drives
// PR-3 false-positive review queue.
model FalsePositive {
  id String @id @default(cuid())

  // What was predicted, and why we think it was wrong.
  forecastSnapshotId String?
  subjectKind        String
  subjectId          String

  predictedScore      Float
  predictedTrajectory String?
  predictedAt         DateTime

  // The outcome (if any) that disconfirmed the prediction. Often null —
  // the absence of any outcome by a deadline is what makes the prediction
  // a false positive. When set, this links to the disconfirming Outcome.
  disconfirmingOutcomeId String?

  // Time window we waited for the prediction to materialize.
  expectedByLatest DateTime
  detectedAt       DateTime @default(now())

  reasonClass String  @default("OTHER")
  notes       String?

  // Review state. Operator can verify or dismiss.
  reviewStatus     String    @default("AUTO") // AUTO | VERIFIED | DISMISSED
  reviewedByUserId String?
  reviewedByEmail  String?
  reviewedAt       DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  disconfirmingOutcome Outcome? @relation(fields: [disconfirmingOutcomeId], references: [id], onDelete: SetNull)

  @@index([subjectKind, subjectId])
  @@index([forecastSnapshotId])
  @@index([reasonClass])
  @@index([reviewStatus])
  @@index([expectedByLatest])
  @@index([detectedAt])
}

// Mirror of FalsePositive: outcomes that occurred without any
// corresponding high-confidence forecast.
model FalseNegative {
  id        String @id @default(cuid())
  outcomeId String

  subjectKind String
  subjectId   String

  // The most-recent forecast (if any) preceding the outcome, plus its
  // score — null if no forecast existed.
  precedingSnapshotId String?
  precedingScore      Float?
  precedingTrajectory String?
  precedingAt         DateTime?

  // How far in advance did we miss the call, in days.
  missedByDays Float?

  reasonClass String  @default("OTHER")
  notes       String?

  reviewStatus     String    @default("AUTO")
  reviewedByUserId String?
  reviewedByEmail  String?
  reviewedAt       DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  outcome Outcome @relation(fields: [outcomeId], references: [id], onDelete: Cascade)

  @@index([outcomeId])
  @@index([subjectKind, subjectId])
  @@index([reasonClass])
  @@index([reviewStatus])
  @@index([precedingAt])
}

// Append-only snapshot of overall calibration state. One row per scope
// per scope-key per computed-at. The platform writes these on a schedule;
// the time series powers a "how is our calibration drifting?" UI in PR-3.
model CalibrationSnapshot {
  id String @id @default(cuid())

  scope    String // GLOBAL | JURISDICTION | CORRIDOR | SUBJECT_KIND | FACTOR
  scopeKey String? // jurisdictionKey | corridorKey | subjectKind | null for GLOBAL

  // Aggregate metrics across resolutions in this scope at compute time.
  resolutionCount   Int
  confirmedCount    Int
  partialCount      Int
  disconfirmedCount Int

  meanProbabilityAccuracy Float?
  meanBrierScore          Float?
  meanTimelineErrorDays   Float?
  trajectoryAlignmentRate Float?

  falsePositiveCount Int @default(0)
  falseNegativeCount Int @default(0)

  // Snapshot of active calibration adjustments at compute time.
  // Stringified JSON of an array of {factorName, adjustmentKind, value}.
  activeAdjustmentsJson String?

  computedAt         DateTime @default(now())
  calibrationVersion String   @default("v1")

  // Why this snapshot was created. "scheduled" | "post_outcome" |
  // "operator_run" | "backfill".
  triggerReason String @default("scheduled")

  @@index([scope, scopeKey, computedAt])
  @@index([calibrationVersion])
  @@index([computedAt])
}

// Operator-tunable resolution-state policy table. One row per resolution
// state describing the transitions it allows and the human-readable label.
// Lets PR-3 governance UI render legal action buttons without hard-coding
// the state machine on the client.
model ResolutionState {
  id                 String  @id @default(cuid())
  state              String  @unique // PENDING | CONFIRMED | PARTIAL | DISCONFIRMED | DISPUTED | WITHDRAWN
  label              String
  description        String?
  // CSV of allowed next states.
  allowedTransitions String  @default("")

  // Whether this state contributes to accuracy / calibration aggregates.
  // CONFIRMED + PARTIAL + DISCONFIRMED contribute; PENDING + DISPUTED +
  // WITHDRAWN do not.
  contributesToAccuracy Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([state])
}

// ──────────────────────────────────────────────────────────────────────────────
//  Market Intelligence: Operator Workspace + Strategic Action Layer (MI-10)
//
//  Operator leverage layer — transforms regional intelligence into an
//  operator-facing command center. Watchlists, alerts, briefings, targeting
//  patterns, and user workspace preferences. Strictly explainable, never
//  autonomous: no auto-outreach, no auto-CRM, no auto-promote.
//
//  Schema-only in MI-10 PR-1. Service + UI ship in the same PR. Live alert
//  evaluation hooks (PR-2 work) are deferred — the engine writes alerts when
//  triggered by service calls; no scheduler shipped here.
//
//  All ten models are additive. No existing table is altered. Strong FKs
//  to existing intelligence tables (Project, Parcel, Entity, ForecastSnapshot)
//  use SetNull on delete so workspace artifacts survive upstream cleanup.
//
//  Subject loose-pointer pattern from MI-8 + MI-9 reused: WatchlistItem
//  and AlertEvent target subjects via (subjectKind, subjectId).
//
//  Pseudo-enum field values (validated in app code):
//    Watchlist.subjectKind:            DEVELOPER | PARCEL | CORRIDOR |
//                                      JURISDICTION | BROKER | FRANCHISE |
//                                      UTILITY | PROJECT_TYPE | MIXED
//    Watchlist.visibility:             PRIVATE | TEAM | ORG
//    WatchlistItem.attachReason:       MANUAL | RULE_DERIVED | IMPORTED |
//                                      MIGRATED
//    AlertRule.triggerKind:            PROBABILITY_SPIKE | TRAJECTORY_SHIFT |
//                                      CORRIDOR_IGNITION | TIMELINE_PULL_IN |
//                                      HIGH_CONFIDENCE_EMERGENCE |
//                                      RECURRING_ENTITY | UTILITY_ACCELERATION |
//                                      SHELL_PATTERN_DETECTED | WATCHLIST_HIT |
//                                      CUSTOM
//    AlertRule.severityFloor:          INFO | WATCH | ATTENTION | URGENT
//    AlertEvent.severity:              INFO | WATCH | ATTENTION | URGENT
//    AlertEvent.reviewStatus:          UNREAD | ACKNOWLEDGED | DISMISSED |
//                                      ESCALATED | SUPPRESSED
//    AlertEvent.subjectKind:           PROJECT | PARCEL | CORRIDOR |
//                                      JURISDICTION | DEVELOPER | ENTITY
//    AlertSubscription.deliveryChannel: IN_APP | EMAIL | WEBHOOK
//    BriefingDocument.briefingKind:    CORRIDOR_SUMMARY | WEEKLY_EMERGENCE |
//                                      JURISDICTION_HEAT | DEVELOPER_MOVEMENT |
//                                      FORECAST_CHANGE | CUSTOM
//    BriefingDocument.status:          DRAFT | GENERATED | OPERATOR_REVIEWED |
//                                      PUBLISHED | ARCHIVED
//    BriefingSection.sectionKind:      HEADLINE | KEY_FINDINGS |
//                                      CORRIDOR_BLOCK | DEVELOPER_BLOCK |
//                                      JURISDICTION_BLOCK | FORECAST_BLOCK |
//                                      EVIDENCE_BLOCK | NOTE_BLOCK
//    TargetingPattern.patternKind:     DEVELOPER_ENTERS_CORRIDOR |
//                                      BROKER_PRECEDES_INDUSTRIAL |
//                                      RECURRING_GC_DEVELOPER |
//                                      ENTITY_CLUSTER_PRE_PROJECT |
//                                      FRANCHISE_ROLLOUT | UTILITY_CHAIN |
//                                      ZONING_CADENCE | CUSTOM
//    AlertExplanation.factorKind:      EVIDENCE | FORECAST_DELTA |
//                                      CALIBRATION_CONTEXT |
//                                      UNCERTAINTY | RECOMMENDATION |
//                                      OTHER
//    WorkspacePreference.layoutKind:   DASHBOARD | LIST | KANBAN
//
//  Cascades:
//    WatchlistItem CASCADE from Watchlist
//    BriefingSection CASCADE from BriefingDocument
//    AlertExplanation CASCADE from AlertEvent
//    AlertSubscription CASCADE from AlertRule
//    All strong FKs to Project/Parcel/Entity/ForecastSnapshot are SetNull
// ──────────────────────────────────────────────────────────────────────────────

model Watchlist {
  id String @id @default(cuid())

  ownerUserId String?
  ownerEmail  String?
  name        String
  description String?

  subjectKind String @default("MIXED")
  visibility  String @default("PRIVATE")

  // Optional auto-population rule (JSON). When present, the watchlist
  // is rule-driven — a background runner can repopulate from rule criteria.
  // Operator-curated lists leave this NULL.
  ruleJson String?

  // Loose tagging for UI grouping.
  tagsCsv String?

  archivedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items WatchlistItem[]

  @@index([ownerUserId])
  @@index([subjectKind])
  @@index([visibility])
  @@index([archivedAt])
}

model WatchlistItem {
  id          String @id @default(cuid())
  watchlistId String

  // Subject loose-pointer plus optional strong FKs.
  subjectKind String
  subjectId   String
  projectId   String?
  parcelId    String?
  entityId    String?

  // Operator-facing display fields cached for fast UI render.
  displayLabel   String?
  displayContext String? // e.g. "West Des Moines / industrial corridor"

  attachReason String  @default("MANUAL")
  notes        String?

  // Operator-tagged priority (1 = top).
  priority Int @default(3)

  addedAt   DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Soft-detach via timestamp preserves history.
  detachedAt     DateTime?
  detachedReason String?
  detachedBy     String?

  watchlist Watchlist @relation(fields: [watchlistId], references: [id], onDelete: Cascade)
  project   Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)
  parcel    Parcel?   @relation(fields: [parcelId], references: [id], onDelete: SetNull)
  entity    Entity?   @relation(fields: [entityId], references: [id], onDelete: SetNull)

  @@unique([watchlistId, subjectKind, subjectId])
  @@index([watchlistId])
  @@index([subjectKind, subjectId])
  @@index([projectId])
  @@index([parcelId])
  @@index([entityId])
  @@index([detachedAt])
  @@index([priority])
}

// Operator-defined alert rule. Evaluates against the intelligence stream
// (forecast snapshots, parcel pressure, corridor heat, etc.). Rules are
// authored, not auto-discovered.
model AlertRule {
  id String @id @default(cuid())

  ownerUserId String?
  ownerEmail  String?

  name        String
  description String?

  triggerKind   String // PROBABILITY_SPIKE | TRAJECTORY_SHIFT | ...
  severityFloor String @default("WATCH")

  // Rule criteria (JSON). Schema varies per triggerKind; documented in
  // lib/services/operatorWorkspace/types.ts.
  //
  // Examples:
  //   { "minScore": 0.7, "windowDays": 7, "subjectKind": "PROJECT" }
  //   { "watchlistId": "wl_abc123", "fireOn": "any_change" }
  criteriaJson String

  // Optional scope filters (CSV) for narrowing where the rule applies.
  jurisdictionCsv String?
  subjectKindCsv  String?

  // When the rule was last evaluated; null = never run.
  lastEvaluatedAt DateTime?
  // Suppression — operator may pause without deleting.
  active          Boolean   @default(true)
  // Cooldown between consecutive fires for the same (rule, subjectId).
  // Prevents alert storms. Default 24h; 0 = no cooldown.
  cooldownMinutes Int       @default(1440)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  events        AlertEvent[]
  subscriptions AlertSubscription[]

  @@index([ownerUserId])
  @@index([triggerKind])
  @@index([active])
  @@index([lastEvaluatedAt])
}

// One fire of an alert. Append-only — re-fires create new rows. Cooldown
// rules suppress within the configured window.
model AlertEvent {
  id String @id @default(cuid())

  ruleId      String? // null when the alert was triggered ad-hoc
  // Subject targeting (loose + optional strong FKs).
  subjectKind String
  subjectId   String
  projectId   String?
  parcelId    String?

  // Forecast snapshot context (when applicable).
  forecastSnapshotId String?

  severity String  @default("WATCH")
  headline String // operator-facing one-line summary
  detail   String? // multi-paragraph explanation

  // Captured state at fire time for replayability.
  capturedScore      Float?
  capturedTrajectory String?
  capturedAt         DateTime @default(now())

  reviewStatus     String    @default("UNREAD")
  reviewedByUserId String?
  reviewedByEmail  String?
  reviewedAt       DateTime?

  payloadJson String? // arbitrary metadata for the alert

  rule             AlertRule?         @relation(fields: [ruleId], references: [id], onDelete: SetNull)
  project          Project?           @relation(fields: [projectId], references: [id], onDelete: SetNull)
  parcel           Parcel?            @relation(fields: [parcelId], references: [id], onDelete: SetNull)
  forecastSnapshot ForecastSnapshot?  @relation(fields: [forecastSnapshotId], references: [id], onDelete: SetNull)
  explanations     AlertExplanation[]

  @@index([ruleId, capturedAt])
  @@index([subjectKind, subjectId, capturedAt])
  @@index([projectId, capturedAt])
  @@index([parcelId, capturedAt])
  @@index([reviewStatus])
  @@index([severity])
  @@index([capturedAt])
}

// Per-alert subscription. Operator decides where alerts from a rule should
// be delivered. IN_APP is the default; EMAIL / WEBHOOK delivery requires
// PR-2 follow-up (this PR ships only IN_APP).
model AlertSubscription {
  id               String  @id @default(cuid())
  ruleId           String
  subscriberUserId String?
  subscriberEmail  String?
  deliveryChannel  String  @default("IN_APP")
  // Per-channel config (e.g. webhook URL, email tokenization options).
  configJson       String?
  active           Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  rule AlertRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)

  @@unique([ruleId, subscriberEmail, deliveryChannel])
  @@index([ruleId])
  @@index([subscriberUserId])
  @@index([deliveryChannel])
  @@index([active])
}

// Structured explanation rows for a fired alert. One row per factor /
// piece of evidence so the UI can render a sortable why-table without
// parsing payloadJson.
model AlertExplanation {
  id      String @id @default(cuid())
  alertId String

  factorKind  String // EVIDENCE | FORECAST_DELTA | CALIBRATION_CONTEXT | ...
  factorName  String
  factorScore Float?
  rationale   String

  // Optional pointer to source row driving this factor.
  sourceRefKind String?
  sourceRefId   String?

  createdAt DateTime @default(now())

  alert AlertEvent @relation(fields: [alertId], references: [id], onDelete: Cascade)

  @@index([alertId])
  @@index([factorKind])
}

// Operator briefing document. Generated periodically (weekly / on-demand)
// summarizing emergence patterns for human consumption. NOT shared
// externally — internal command-center artifact.
model BriefingDocument {
  id String @id @default(cuid())

  briefingKind String
  title        String
  // Time window the briefing covers.
  windowStart  DateTime
  windowEnd    DateTime

  // Optional scope filters.
  jurisdictionKey String?
  corridorKey     String?
  watchlistId     String?

  status      String  @default("DRAFT")
  // Free-text TL;DR rendered at the top.
  summary     String?
  // Structured payload — full evidence bundle.
  payloadJson String?

  authoredByUserId String?
  authoredByEmail  String?

  generatedAt DateTime  @default(now())
  publishedAt DateTime?
  updatedAt   DateTime  @updatedAt

  sections BriefingSection[]

  @@index([briefingKind])
  @@index([status])
  @@index([windowStart])
  @@index([jurisdictionKey])
  @@index([corridorKey])
  @@index([watchlistId])
}

// Per-section briefing content. Ordered display via `position`. Cascade
// from BriefingDocument so an archived briefing loses its sections.
model BriefingSection {
  id         String @id @default(cuid())
  briefingId String

  position    Int     @default(0)
  sectionKind String
  title       String?
  body        String // markdown-ish operator-facing text

  // Optional structured payload for the section (factor lists, evidence rows).
  payloadJson String?

  createdAt DateTime @default(now())

  briefing BriefingDocument @relation(fields: [briefingId], references: [id], onDelete: Cascade)

  @@index([briefingId, position])
  @@index([sectionKind])
}

// Operator-curated targeting pattern. Either rule-defined (criteria JSON)
// or operator-tagged (a known pattern the operator wants to surface
// recurrence of). The engine evaluates these and writes AlertEvents when
// matches occur.
model TargetingPattern {
  id String @id @default(cuid())

  ownerUserId String?
  ownerEmail  String?

  name        String
  description String?
  patternKind String

  // Pattern criteria — schema varies per patternKind.
  criteriaJson String

  // Optional priority for surfacing.
  priority Int @default(3)

  // Activity tracking.
  lastEvaluatedAt DateTime?
  lastMatchedAt   DateTime?
  matchCount      Int       @default(0)

  active Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([patternKind])
  @@index([active])
  @@index([priority])
  @@index([lastMatchedAt])
}

// Per-user workspace preferences. Layout choice, pinned watchlists, default
// filters. One row per user (the relation enforces it via unique).
model WorkspacePreference {
  id        String  @id @default(cuid())
  userId    String  @unique
  userEmail String?

  layoutKind          String  @default("DASHBOARD")
  // CSV of watchlist ids pinned to the top of the workspace.
  pinnedWatchlistsCsv String?
  // CSV of corridor keys pinned.
  pinnedCorridorsCsv  String?
  // Default jurisdiction filter.
  defaultJurisdiction String?

  // Free-form display-only JSON for any future preference additions.
  preferencesJson String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userEmail])
}

// ── Integration Credentials Vault ───────────────────────────────────────────
//
// Encrypted storage for third-party integration credentials (Beeline, Blue
// Book Network, ConstructConnect, iSqFt, etc.). Encryption is AES-256-GCM
// with a master key from CREDENTIAL_MASTER_KEY env var. The DB never holds
// plaintext; the master key never enters the DB.
//
// Read path: ONLY lib/services/credentials/credentialVault.ts may decrypt.
// AI/prompt-building code is forbidden from importing the vault (enforced
// by ESLint no-restricted-imports rule). See docs/architecture/CREDENTIALS.md.
model IntegrationCredential {
  id             String    @id @default(cuid())
  service        String // "beeline" | "blue_book" | "constructconnect" | "isqft"
  field          String // "username" | "password" | "api_key" | "totp_secret"
  encryptedValue String // base64 ciphertext
  iv             String // base64 nonce (12 bytes for GCM)
  authTag        String // base64 GCM auth tag
  algorithm      String    @default("aes-256-gcm")
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  lastTestedAt   DateTime?
  lastTestStatus String? // 'success' | 'failed' | null
  lastTestError  String?

  @@unique([service, field])
  @@index([service])
}

// ──────────────────────────────────────────────────────────────────────────────
//  Observability: cross-cutting AuditEvent persistence (Phase O1.2)
//
//  Single canonical table for audit events that must outlive Loki retention.
//  The existing 7 service audit emitters (entity-resolver, project-aggregator,
//  parcel-memory, emergence-forecast, outcome-calibration,
//  operator-workspace, live-ingestion) continue to emit stdout JSON as
//  before — Promtail scrapes those to Loki for hot search.
//
//  This table is for the subset of audit events that need DB-backed
//  forever-persistence:
//    - operator_override
//    - merge_split
//    - replay_run
//    - migration_governance
//    - runner_cycle
//    - review_action
//    - alert_review
//    - calibration_adjustment (when operator-applied)
//    - ingestion_pipeline_error
//    - system_health
//
//  Volume estimate: ≤ 1000 rows/day at metro scale. Indexes optimized for
//  operator queries:
//    - by category + time ("show me all operator overrides this week")
//    - by subject ("show me everything that happened to this project")
//    - by correlation/replay/ingestion id (cross-service tracing)
//    - by actor ("show me what this analyst did today")
//
//  Append-only. No update / no delete by code. Retention enforced by ops
//  job (future O3) — likely 5+ years for compliance-grade lineage.
// ──────────────────────────────────────────────────────────────────────────────

model AuditEvent {
  id String @id @default(cuid())

  category String // entity_resolution | project_attachment | forecast_generation | ...
  action   String // service-specific verb
  severity String @default("INFO") // DEBUG | INFO | NOTICE | WARN | ERROR | CRITICAL

  // Subject + actor (loose-pointer).
  subjectKind String?
  subjectId   String?
  actorUserId String?
  actorEmail  String?
  actorKind   String  @default("system") // operator | system | runner | api | anonymous

  // Correlation envelope.
  correlationId String?
  replayId      String?
  ingestionId   String?
  runnerId      String?

  // Version snapshot at emit time. JSON of all engine version tags.
  schemaVersion   String  @default("1.0")
  versionTagsJson String?

  // Operator-readable payload.
  decision    String?
  reasonLog   String? // JSON-stringified string array
  payloadJson String?

  emittedAt DateTime @default(now())

  @@index([category, emittedAt])
  @@index([action])
  @@index([subjectKind, subjectId])
  @@index([actorUserId])
  @@index([correlationId])
  @@index([replayId])
  @@index([ingestionId])
  @@index([runnerId])
  @@index([severity])
  @@index([emittedAt])
}

// ──────────────────────────────────────────────────────────────────────────────
//  Operational: RunnerLease (Phase O1.4)
//
//  Coordination primitive for recurring MI cycle execution (forecast,
//  calibration, briefing, alert-eval, outcome-detect, backfill). Provides:
//
//    1. At-most-once execution per window — multiple workers can't both
//       fire the daily forecast cycle.
//    2. Heartbeat — a long-running cycle extends its lease periodically;
//       absence of heartbeats > lease window flags a stale/hung run.
//    3. Cycle history — last successful + last attempted run per cycleKey
//       with status + duration + error.
//
//  Distinct from BackgroundJob (which is per-bid + per-jobType). RunnerLease
//  is platform-wide: one row per cycleKey × windowStart.
//
//  windowKey shape: `<cycleName>_<windowGranularity>_<windowStartIso>`
//    e.g. "forecast-daily_2026-05-19"
//         "calibration-weekly_2026-W20"
//         "briefing-corridor-daily_2026-05-19"
//
//  Append-only history-wise: re-running the same cycleKey + window updates
//  the existing row (status transitions, heartbeats); never deleted. The
//  AuditEvent table (O1.2) carries the long-lived runner_cycle history;
//  this table is hot-path coordination only.
// ──────────────────────────────────────────────────────────────────────────────

model RunnerLease {
  id String @id @default(cuid())

  // Cycle identity. cycleName is the stable runner name (e.g. forecast-daily).
  // windowKey is the unique (cycleName + window-bounded-time) string that
  // makes a particular cycle invocation idempotent.
  cycleName String
  windowKey String @unique

  // Lease semantics.
  status          String   @default("claimed") // claimed | running | succeeded | failed | stale
  leaseToken      String // random per-claim; only this holder can release
  leasedBy        String // runner instance identifier (hostname/pid/uuid)
  leasedAt        DateTime @default(now())
  leaseExpiresAt  DateTime // claim window; holder must heartbeat before this
  lastHeartbeatAt DateTime @default(now())

  // Outcome.
  finishedAt   DateTime?
  durationMs   Int?
  errorMessage String?

  // Optional correlation pointers (matches AuditEvent envelope from O1.2).
  runnerId String? // matches AuditEvent.runnerId for cross-tier tracing
  replayId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([cycleName, leasedAt])
  @@index([status])
  @@index([leaseExpiresAt])
  @@index([runnerId])
}
