// ──────────────────────────────────────────────────────────────────────────────
//  Market Intelligence: Outcome Tracking + Forecast Calibration (MI-9)
//
//  Feedback intelligence — the layer that teaches the platform whether its
//  predictions matched reality. Builds on top of MI-8's ForecastSnapshot
//  history. Deterministic-first: no black-box self-modifying behavior, no
//  silent forecast retrofits, no destruction of historical lineage.
//
//  Schema-only in MI-9 PR-1. Service layer in lib/services/outcomeCalibration
//  ships in the same PR but does not mutate any historical forecast row.
//  Calibration coefficients are advisory inputs to the next forecast cycle,
//  not retroactive rewrites of past forecasts.
//
//  All ten models are additive. No existing table is altered.
//
//  Outcome ontology (Outcome.outcomeKind pseudo-enum):
//    CONSTRUCTION_STARTED
//    PERMIT_ISSUED
//    BID_ISSUED
//    PROJECT_ABANDONED
//    PROJECT_STALLED
//    TIMELINE_SLIPPED
//    SHELL_REALIZED
//    FRANCHISE_ROLLOUT_CONFIRMED
//    ZONING_FAILED
//    UTILITY_EXPANSION_COMPLETED
//    CORRIDOR_ACCELERATION_CONFIRMED
//    OTHER
//
//  Subject loose-pointer pattern: every outcome targets a subject identified
//  by (subjectKind, subjectId), mirroring MI-8's pattern. Strong nullable FKs
//  to Project / Parcel are kept for relational queries.
//
//  Pseudo-enum field values (validated in app code):
//    Outcome.outcomeKind:               (see above)
//    Outcome.detectionMethod:           AUTOMATIC | OPERATOR_REPORTED |
//                                       EXTERNAL_FEED | INFERRED
//    Outcome.subjectKind:               PROJECT | PARCEL | CORRIDOR |
//                                       JURISDICTION | DEVELOPER
//    OutcomeEvidence.evidenceKind:      MARKET_SIGNAL | DOCUMENT |
//                                       PRESS_RELEASE | OPERATOR_NOTE |
//                                       EXTERNAL_FEED | PHOTO | OTHER
//    OutcomeResolution.resolutionState: PENDING | CONFIRMED | PARTIAL |
//                                       DISCONFIRMED | DISPUTED | WITHDRAWN
//    OutcomeResolution.predictionPosture: HIGH_CONF_PREDICTED |
//                                       MEDIUM_CONF_PREDICTED |
//                                       LOW_CONF_PREDICTED | UNPREDICTED
//    ForecastAccuracy.accuracyKind:     PROBABILITY | TIMELINE |
//                                       TRAJECTORY | OUTCOME_KIND |
//                                       CORRIDOR | COMPOSITE
//    TrajectoryOutcome.alignment:       ALIGNED | DIVERGED | EARLY_SHIFT |
//                                       MISSED_SHIFT | INCONCLUSIVE
//    FalsePositive.reasonClass:         OVERWEIGHTED_DEVELOPER |
//                                       OVERWEIGHTED_CONTINUANCE |
//                                       OVERWEIGHTED_UTILITY |
//                                       STALE_SIGNAL_CARRYOVER |
//                                       JURISDICTION_LAG_UNDERESTIMATED |
//                                       SHELL_CLUSTER_MISREAD | OTHER
//    FalseNegative.reasonClass:         UNDERWEIGHTED_PARCEL |
//                                       UNDERWEIGHTED_INFRASTRUCTURE |
//                                       MISSED_CORRIDOR_IGNITION |
//                                       MISSED_FRANCHISE_PATTERN |
//                                       NEW_SIGNAL_TYPE | OTHER
//    CalibrationSnapshot.scope:         GLOBAL | JURISDICTION | CORRIDOR |
//                                       SUBJECT_KIND | FACTOR
//    ForecastCalibration.scope:         GLOBAL | JURISDICTION | CORRIDOR |
//                                       SUBJECT_KIND | FACTOR
//    ForecastCalibration.adjustmentKind: WEIGHT_MULTIPLIER | DECAY_OVERRIDE |
//                                       LAG_DAYS | THRESHOLD_OVERRIDE
//
//  Cascades:
//    OutcomeEvidence CASCADE from Outcome — evidence is meaningless detached
//    from its outcome.
//    OutcomeResolution.outcomeId CASCADE from Outcome; .forecastSnapshotId
//    SetNull (a forecast deletion is unusual but must not lose outcome
//    lineage).
//    ForecastAccuracy.resolutionId CASCADE from OutcomeResolution.
//    TrajectoryOutcome.resolutionId CASCADE from OutcomeResolution.
//    TimelineAccuracy.resolutionId CASCADE from OutcomeResolution.
//    FalsePositive / FalseNegative cascade from their parent Outcome or
//    Resolution where applicable.
//
//  Append-only lineage discipline:
//    - Outcome rows are append-only; corrections create a new Outcome with
//      `supersededByOutcomeId` pointing to the replacement and
//      `resolutionState=WITHDRAWN` on the original's resolution.
//    - Past ForecastAccuracy rows are NEVER mutated. Recomputation appends
//      a new row with a fresh `evaluationVersion`.
//    - CalibrationSnapshot is strictly append-only.
//
//  Bumps to CALIBRATION_VERSION (in app code, recorded on every accuracy /
//  calibration row) flag schema-and-algorithm generations the same way
//  FORECAST_VERSION tags emergence forecasts.
// ──────────────────────────────────────────────────────────────────────────────

model Outcome {
  id String @id @default(cuid())

  // Subject identity. subjectKind + subjectId is the universal pointer;
  // strong FKs are nullable for relational query convenience.
  subjectKind String
  subjectId   String
  projectId   String?
  parcelId    String?

  // Outcome type + observation metadata.
  outcomeKind     String
  outcomeLabel    String? // operator-facing label override
  detectionMethod String  @default("AUTOMATIC")

  // When the outcome actually occurred (operator-best-knowledge), and
  // when the platform observed it. These can differ — a permit issued
  // 3 weeks ago that we discover today has observedAt = today but
  // occurredAt = 3 weeks ago.
  occurredAt DateTime
  observedAt DateTime @default(now())

  // Confidence in the outcome itself (not in any forecast).
  outcomeConfidence String @default("MEDIUM") // LOW | MEDIUM | HIGH | VERIFIED

  // Free-text rationale + optional structured payload.
  notes       String?
  payloadJson String?

  // Append-only supersede chain. When an operator corrects an Outcome
  // (wrong date, wrong subject, retraction), a NEW Outcome row is created
  // and the original gets supersededByOutcomeId pointing at it.
  supersededByOutcomeId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project        Project?            @relation(fields: [projectId], references: [id], onDelete: SetNull)
  parcel         Parcel?             @relation(fields: [parcelId], references: [id], onDelete: SetNull)
  evidence       OutcomeEvidence[]
  resolutions    OutcomeResolution[]
  falsePositives FalsePositive[]
  falseNegatives FalseNegative[]
  supersededBy   Outcome?            @relation("OutcomeSupersede", fields: [supersededByOutcomeId], references: [id], onDelete: SetNull)
  supersedes     Outcome[]           @relation("OutcomeSupersede")

  @@index([subjectKind, subjectId, occurredAt])
  @@index([outcomeKind])
  @@index([projectId])
  @@index([parcelId])
  @@index([occurredAt])
  @@index([observedAt])
  @@index([supersededByOutcomeId])
}

// Per-outcome evidence rows. Each evidence row points back to its source
// (MarketSignal, MarketSourceDoc, MarketLead, operator note, external feed)
// via loose pointer (sourceRefKind + sourceRefId) — same pattern as MI-7
// ParcelSignal.
model OutcomeEvidence {
  id        String @id @default(cuid())
  outcomeId String

  evidenceKind  String
  sourceRefKind String?
  sourceRefId   String?
  sourceUrl     String?

  capturedAt DateTime
  observedAt DateTime @default(now())

  rationale   String
  payloadJson String?

  // Optional operator vouching.
  vouchedByUserId String?
  vouchedByEmail  String?
  vouchedAt       DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  outcome Outcome @relation(fields: [outcomeId], references: [id], onDelete: Cascade)

  @@index([outcomeId])
  @@index([evidenceKind])
  @@index([capturedAt])
  @@index([sourceRefKind, sourceRefId])
}

// One row per (Outcome, ForecastSnapshot) pair. This is where the platform
// records "did this forecast predict this outcome?" — and it's the row the
// accuracy / calibration services attach to.
//
// resolutionState transitions are append-only via new rows: a DISPUTED row
// for the same (outcome, snapshot) creates a NEW OutcomeResolution row
// rather than mutating an existing one.
model OutcomeResolution {
  id                 String  @id @default(cuid())
  outcomeId          String
  // The forecast snapshot being evaluated. Null when the outcome had no
  // matching forecast (a UNPREDICTED FalseNegative case).
  forecastSnapshotId String?

  resolutionState   String @default("PENDING")
  predictionPosture String @default("UNPREDICTED")

  // Snapshot of the forecast values at prediction time, captured here for
  // cheap query without re-joining to ForecastSnapshot. Mirrors what the
  // forecast asserted; the actual outcome is on the Outcome row.
  predictedScore      Float?
  predictedTrajectory String?
  predictedAt         DateTime?

  // How long between predictedAt and Outcome.occurredAt, in days. Negative
  // if the outcome occurred before the forecast was made (operator-late
  // outcome capture).
  leadTimeDays Float?

  resolvedAt       DateTime @default(now())
  resolvedByUserId String?
  resolvedByEmail  String?
  resolutionNotes  String?

  // Bumps when resolution policy changes. Stamps new resolutions; old ones
  // keep their stamp so historical accuracy comparisons are stable.
  calibrationVersion String @default("v1")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  outcome          Outcome           @relation(fields: [outcomeId], references: [id], onDelete: Cascade)
  forecastSnapshot ForecastSnapshot? @relation(fields: [forecastSnapshotId], references: [id], onDelete: SetNull)

  accuracies         ForecastAccuracy[]
  trajectoryOutcomes TrajectoryOutcome[]
  timelineAccuracies TimelineAccuracy[]

  @@index([outcomeId])
  @@index([forecastSnapshotId])
  @@index([resolutionState])
  @@index([predictionPosture])
  @@index([resolvedAt])
}

// Per-resolution per-accuracy-kind score record. One OutcomeResolution can
// have many ForecastAccuracy rows (one per kind: PROBABILITY, TIMELINE,
// TRAJECTORY, OUTCOME_KIND, CORRIDOR, COMPOSITE).
//
// Append-only: a re-evaluation creates a new row with a fresh evaluationVersion.
model ForecastAccuracy {
  id           String @id @default(cuid())
  resolutionId String

  accuracyKind       String
  // Numeric in [0..1] where 1 = perfectly accurate. Composite is the
  // weighted blend of the others.
  accuracyScore      Float
  // Brier-style probabilistic score for the PROBABILITY kind:
  // brier = (predictedScore - 1)² when outcome=happened, predictedScore²
  // when outcome=did-not-happen. Other kinds may store NaN — kept nullable.
  brierScore         Float?
  // Timeline-kind metrics:
  timelineErrorDays  Float? // (actualDate - expectedDate); positive = late
  withinExpectedBand Boolean? // true when actual fell within earliest..latest
  // Free-text + structured rationale.
  rationale          String
  payloadJson        String?

  evaluationVersion String @default("v1")

  computedAt DateTime @default(now())

  resolution OutcomeResolution @relation(fields: [resolutionId], references: [id], onDelete: Cascade)

  @@index([resolutionId])
  @@index([accuracyKind])
  @@index([accuracyScore])
  @@index([computedAt])
}

// Operator-tunable calibration adjustments. Read at the START of each new
// forecast cycle to modulate per-(jurisdiction, factor) weights — does NOT
// rewrite historical forecasts. Append-only by row identity, but a row's
// fields can be edited to retune; every edit bumps updatedAt and is captured
// by the next CalibrationSnapshot.
//
// scope tells the engine which subset of forecasts the row applies to:
//   GLOBAL          — every forecast
//   JURISDICTION    — forecasts whose subject's jurisdiction matches scopeKey
//   CORRIDOR        — forecasts whose subject's corridor matches scopeKey
//   SUBJECT_KIND    — forecasts of a given subjectKind
//   FACTOR          — applies to a specific factor name (e.g. "utilityExpansion")
//
// adjustmentKind determines how the value is interpreted:
//   WEIGHT_MULTIPLIER  — value × current factor weight
//   DECAY_OVERRIDE     — replaces signal-decay half-life days
//   LAG_DAYS           — added to expected-milestone date math
//   THRESHOLD_OVERRIDE — replaces a trajectory or velocity threshold
model ForecastCalibration {
  id String @id @default(cuid())

  scope      String // GLOBAL | JURISDICTION | CORRIDOR | SUBJECT_KIND | FACTOR
  scopeKey   String? // jurisdictionKey | corridorKey | subjectKind | null for GLOBAL
  factorName String? // only used when scope=FACTOR or applies to a factor

  adjustmentKind String // WEIGHT_MULTIPLIER | DECAY_OVERRIDE | LAG_DAYS | THRESHOLD_OVERRIDE
  value          Float

  // Operator-facing rationale + provenance.
  source String? // "calibration_runner" | "operator_manual" | "watchlist"
  notes  String?

  // Disable without deleting — preserves history.
  active Boolean @default(true)

  // Bumps when the algorithm that wrote the row changes — older rows know
  // which calibration generation produced them.
  calibrationVersion String @default("v1")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([scope, scopeKey, factorName, adjustmentKind])
  @@index([scope, scopeKey])
  @@index([factorName])
  @@index([adjustmentKind])
  @@index([active])
}

// Per-resolution trajectory alignment record. Records whether the trajectory
// state at prediction time matched the actual progression observed via the
// outcome.
model TrajectoryOutcome {
  id           String @id @default(cuid())
  resolutionId String

  predictedState String
  actualState    String?
  alignment      String  @default("INCONCLUSIVE")

  // True when MI-8 detected a momentum shift at prediction time AND that
  // shift turned out to correctly anticipate the outcome.
  shiftCorrect Boolean?
  // True when MI-8 missed a momentum shift that would have improved
  // prediction (post-hoc evident from outcome timing).
  shiftMissed  Boolean?

  rationale String?

  computedAt DateTime @default(now())

  resolution OutcomeResolution @relation(fields: [resolutionId], references: [id], onDelete: Cascade)

  @@index([resolutionId])
  @@index([alignment])
  @@index([shiftMissed])
}

// Per-resolution timeline-accuracy record. One row per
// (resolution, milestoneKind). Stores actual vs expected date variance.
model TimelineAccuracy {
  id           String @id @default(cuid())
  resolutionId String

  milestoneKind String
  // Forecast values captured at prediction time.
  expectedAt    DateTime?
  earliestAt    DateTime?
  latestAt      DateTime?
  // Actual observed date from the Outcome.
  actualAt      DateTime

  // Derived metrics.
  errorDays                     Float // actualAt - expectedAt (positive = late)
  absoluteErrorDays             Float
  withinBand                    Boolean // true when actualAt ∈ [earliestAt, latestAt]
  // Optional jurisdiction-relative metric: errorDays minus this
  // jurisdiction's typical lag (read from ForecastCalibration scope=JURISDICTION
  // adjustmentKind=LAG_DAYS). Lets the platform say "this was 50 days late
  // BUT this jurisdiction typically runs 45 days late, so really only 5 days
  // late by jurisdiction-norm".
  jurisdictionAdjustedErrorDays Float?

  rationale  String?
  computedAt DateTime @default(now())

  resolution OutcomeResolution @relation(fields: [resolutionId], references: [id], onDelete: Cascade)

  @@index([resolutionId])
  @@index([milestoneKind])
  @@index([errorDays])
  @@index([withinBand])
}

// One row per detected false positive — high-confidence forecast that did
// NOT result in the predicted outcome within the expected band. Drives
// PR-3 false-positive review queue.
model FalsePositive {
  id String @id @default(cuid())

  // What was predicted, and why we think it was wrong.
  forecastSnapshotId String?
  subjectKind        String
  subjectId          String

  predictedScore      Float
  predictedTrajectory String?
  predictedAt         DateTime

  // The outcome (if any) that disconfirmed the prediction. Often null —
  // the absence of any outcome by a deadline is what makes the prediction
  // a false positive. When set, this links to the disconfirming Outcome.
  disconfirmingOutcomeId String?

  // Time window we waited for the prediction to materialize.
  expectedByLatest DateTime
  detectedAt       DateTime @default(now())

  reasonClass String  @default("OTHER")
  notes       String?

  // Review state. Operator can verify or dismiss.
  reviewStatus     String    @default("AUTO") // AUTO | VERIFIED | DISMISSED
  reviewedByUserId String?
  reviewedByEmail  String?
  reviewedAt       DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  disconfirmingOutcome Outcome? @relation(fields: [disconfirmingOutcomeId], references: [id], onDelete: SetNull)

  @@index([subjectKind, subjectId])
  @@index([forecastSnapshotId])
  @@index([reasonClass])
  @@index([reviewStatus])
  @@index([expectedByLatest])
  @@index([detectedAt])
}

// Mirror of FalsePositive: outcomes that occurred without any
// corresponding high-confidence forecast.
model FalseNegative {
  id        String @id @default(cuid())
  outcomeId String

  subjectKind String
  subjectId   String

  // The most-recent forecast (if any) preceding the outcome, plus its
  // score — null if no forecast existed.
  precedingSnapshotId String?
  precedingScore      Float?
  precedingTrajectory String?
  precedingAt         DateTime?

  // How far in advance did we miss the call, in days.
  missedByDays Float?

  reasonClass String  @default("OTHER")
  notes       String?

  reviewStatus     String    @default("AUTO")
  reviewedByUserId String?
  reviewedByEmail  String?
  reviewedAt       DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  outcome Outcome @relation(fields: [outcomeId], references: [id], onDelete: Cascade)

  @@index([outcomeId])
  @@index([subjectKind, subjectId])
  @@index([reasonClass])
  @@index([reviewStatus])
  @@index([precedingAt])
}

// Append-only snapshot of overall calibration state. One row per scope
// per scope-key per computed-at. The platform writes these on a schedule;
// the time series powers a "how is our calibration drifting?" UI in PR-3.
model CalibrationSnapshot {
  id String @id @default(cuid())

  scope    String // GLOBAL | JURISDICTION | CORRIDOR | SUBJECT_KIND | FACTOR
  scopeKey String? // jurisdictionKey | corridorKey | subjectKind | null for GLOBAL

  // Aggregate metrics across resolutions in this scope at compute time.
  resolutionCount   Int
  confirmedCount    Int
  partialCount      Int
  disconfirmedCount Int

  meanProbabilityAccuracy Float?
  meanBrierScore          Float?
  meanTimelineErrorDays   Float?
  trajectoryAlignmentRate Float?

  falsePositiveCount Int @default(0)
  falseNegativeCount Int @default(0)

  // Snapshot of active calibration adjustments at compute time.
  // Stringified JSON of an array of {factorName, adjustmentKind, value}.
  activeAdjustmentsJson String?

  computedAt         DateTime @default(now())
  calibrationVersion String   @default("v1")

  // Why this snapshot was created. "scheduled" | "post_outcome" |
  // "operator_run" | "backfill".
  triggerReason String @default("scheduled")

  @@index([scope, scopeKey, computedAt])
  @@index([calibrationVersion])
  @@index([computedAt])
}

// Operator-tunable resolution-state policy table. One row per resolution
// state describing the transitions it allows and the human-readable label.
// Lets PR-3 governance UI render legal action buttons without hard-coding
// the state machine on the client.
model ResolutionState {
  id                 String  @id @default(cuid())
  state              String  @unique // PENDING | CONFIRMED | PARTIAL | DISCONFIRMED | DISPUTED | WITHDRAWN
  label              String
  description        String?
  // CSV of allowed next states.
  allowedTransitions String  @default("")

  // Whether this state contributes to accuracy / calibration aggregates.
  // CONFIRMED + PARTIAL + DISCONFIRMED contribute; PENDING + DISPUTED +
  // WITHDRAWN do not.
  contributesToAccuracy Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([state])
}

// ──────────────────────────────────────────────────────────────────────────────
//  Market Intelligence: Operator Workspace + Strategic Action Layer (MI-10)
//
//  Operator leverage layer — transforms regional intelligence into an
//  operator-facing command center. Watchlists, alerts, briefings, targeting
//  patterns, and user workspace preferences. Strictly explainable, never
//  autonomous: no auto-outreach, no auto-CRM, no auto-promote.
//
//  Schema-only in MI-10 PR-1. Service + UI ship in the same PR. Live alert
//  evaluation hooks (PR-2 work) are deferred — the engine writes alerts when
//  triggered by service calls; no scheduler shipped here.
//
//  All ten models are additive. No existing table is altered. Strong FKs
//  to existing intelligence tables (Project, Parcel, Entity, ForecastSnapshot)
//  use SetNull on delete so workspace artifacts survive upstream cleanup.
//
//  Subject loose-pointer pattern from MI-8 + MI-9 reused: WatchlistItem
//  and AlertEvent target subjects via (subjectKind, subjectId).
//
//  Pseudo-enum field values (validated in app code):
//    Watchlist.subjectKind:            DEVELOPER | PARCEL | CORRIDOR |
//                                      JURISDICTION | BROKER | FRANCHISE |
//                                      UTILITY | PROJECT_TYPE | MIXED
//    Watchlist.visibility:             PRIVATE | TEAM | ORG
//    WatchlistItem.attachReason:       MANUAL | RULE_DERIVED | IMPORTED |
//                                      MIGRATED
//    AlertRule.triggerKind:            PROBABILITY_SPIKE | TRAJECTORY_SHIFT |
//                                      CORRIDOR_IGNITION | TIMELINE_PULL_IN |
//                                      HIGH_CONFIDENCE_EMERGENCE |
//                                      RECURRING_ENTITY | UTILITY_ACCELERATION |
//                                      SHELL_PATTERN_DETECTED | WATCHLIST_HIT |
//                                      CUSTOM
//    AlertRule.severityFloor:          INFO | WATCH | ATTENTION | URGENT
//    AlertEvent.severity:              INFO | WATCH | ATTENTION | URGENT
//    AlertEvent.reviewStatus:          UNREAD | ACKNOWLEDGED | DISMISSED |
//                                      ESCALATED | SUPPRESSED
//    AlertEvent.subjectKind:           PROJECT | PARCEL | CORRIDOR |
//                                      JURISDICTION | DEVELOPER | ENTITY
//    AlertSubscription.deliveryChannel: IN_APP | EMAIL | WEBHOOK
//    BriefingDocument.briefingKind:    CORRIDOR_SUMMARY | WEEKLY_EMERGENCE |
//                                      JURISDICTION_HEAT | DEVELOPER_MOVEMENT |
//                                      FORECAST_CHANGE | CUSTOM
//    BriefingDocument.status:          DRAFT | GENERATED | OPERATOR_REVIEWED |
//                                      PUBLISHED | ARCHIVED
//    BriefingSection.sectionKind:      HEADLINE | KEY_FINDINGS |
//                                      CORRIDOR_BLOCK | DEVELOPER_BLOCK |
//                                      JURISDICTION_BLOCK | FORECAST_BLOCK |
//                                      EVIDENCE_BLOCK | NOTE_BLOCK
//    TargetingPattern.patternKind:     DEVELOPER_ENTERS_CORRIDOR |
//                                      BROKER_PRECEDES_INDUSTRIAL |
//                                      RECURRING_GC_DEVELOPER |
//                                      ENTITY_CLUSTER_PRE_PROJECT |
//                                      FRANCHISE_ROLLOUT | UTILITY_CHAIN |
//                                      ZONING_CADENCE | CUSTOM
//    AlertExplanation.factorKind:      EVIDENCE | FORECAST_DELTA |
//                                      CALIBRATION_CONTEXT |
//                                      UNCERTAINTY | RECOMMENDATION |
//                                      OTHER
//    WorkspacePreference.layoutKind:   DASHBOARD | LIST | KANBAN
//
//  Cascades:
//    WatchlistItem CASCADE from Watchlist
//    BriefingSection CASCADE from BriefingDocument
//    AlertExplanation CASCADE from AlertEvent
//    AlertSubscription CASCADE from AlertRule
//    All strong FKs to Project/Parcel/Entity/ForecastSnapshot are SetNull
// ──────────────────────────────────────────────────────────────────────────────

model Watchlist {
  id String @id @default(cuid())

  ownerUserId String?
  ownerEmail  String?
  name        String
  description String?

  subjectKind String @default("MIXED")
  visibility  String @default("PRIVATE")

  // Optional auto-population rule (JSON). When present, the watchlist
  // is rule-driven — a background runner can repopulate from rule criteria.
  // Operator-curated lists leave this NULL.
  ruleJson String?

  // Loose tagging for UI grouping.
  tagsCsv String?

  archivedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items WatchlistItem[]

  @@index([ownerUserId])
  @@index([subjectKind])
  @@index([visibility])
  @@index([archivedAt])
}

model WatchlistItem {
  id          String @id @default(cuid())
  watchlistId String

  // Subject loose-pointer plus optional strong FKs.
  subjectKind String
  subjectId   String
  projectId   String?
  parcelId    String?
  entityId    String?

  // Operator-facing display fields cached for fast UI render.
  displayLabel   String?
  displayContext String? // e.g. "West Des Moines / industrial corridor"

  attachReason String  @default("MANUAL")
  notes        String?

  // Operator-tagged priority (1 = top).
  priority Int @default(3)

  addedAt   DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Soft-detach via timestamp preserves history.
  detachedAt     DateTime?
  detachedReason String?
  detachedBy     String?

  watchlist Watchlist @relation(fields: [watchlistId], references: [id], onDelete: Cascade)
  project   Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)
  parcel    Parcel?   @relation(fields: [parcelId], references: [id], onDelete: SetNull)
  entity    Entity?   @relation(fields: [entityId], references: [id], onDelete: SetNull)

  @@unique([watchlistId, subjectKind, subjectId])
  @@index([watchlistId])
  @@index([subjectKind, subjectId])
  @@index([projectId])
  @@index([parcelId])
  @@index([entityId])
  @@index([detachedAt])
  @@index([priority])
}

// Operator-defined alert rule. Evaluates against the intelligence stream
// (forecast snapshots, parcel pressure, corridor heat, etc.). Rules are
// authored, not auto-discovered.
model AlertRule {
  id String @id @default(cuid())

  ownerUserId String?
  ownerEmail  String?

  name        String
  description String?

  triggerKind   String // PROBABILITY_SPIKE | TRAJECTORY_SHIFT | ...
  severityFloor String @default("WATCH")

  // Rule criteria (JSON). Schema varies per triggerKind; documented in
  // lib/services/operatorWorkspace/types.ts.
  //
  // Examples:
  //   { "minScore": 0.7, "windowDays": 7, "subjectKind": "PROJECT" }
  //   { "watchlistId": "wl_abc123", "fireOn": "any_change" }
  criteriaJson String

  // Optional scope filters (CSV) for narrowing where the rule applies.
  jurisdictionCsv String?
  subjectKindCsv  String?

  // When the rule was last evaluated; null = never run.
  lastEvaluatedAt DateTime?
  // Suppression — operator may pause without deleting.
  active          Boolean   @default(true)
  // Cooldown between consecutive fires for the same (rule, subjectId).
  // Prevents alert storms. Default 24h; 0 = no cooldown.
  cooldownMinutes Int       @default(1440)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  events        AlertEvent[]
  subscriptions AlertSubscription[]

  @@index([ownerUserId])
  @@index([triggerKind])
  @@index([active])
  @@index([lastEvaluatedAt])
}

// One fire of an alert. Append-only — re-fires create new rows. Cooldown
// rules suppress within the configured window.
model AlertEvent {
  id String @id @default(cuid())

  ruleId      String? // null when the alert was triggered ad-hoc
  // Subject targeting (loose + optional strong FKs).
  subjectKind String
  subjectId   String
  projectId   String?
  parcelId    String?

  // Forecast snapshot context (when applicable).
  forecastSnapshotId String?

  severity String  @default("WATCH")
  headline String // operator-facing one-line summary
  detail   String? // multi-paragraph explanation

  // Captured state at fire time for replayability.
  capturedScore      Float?
  capturedTrajectory String?
  capturedAt         DateTime @default(now())

  reviewStatus     String    @default("UNREAD")
  reviewedByUserId String?
  reviewedByEmail  String?
  reviewedAt       DateTime?

  payloadJson String? // arbitrary metadata for the alert

  rule             AlertRule?         @relation(fields: [ruleId], references: [id], onDelete: SetNull)
  project          Project?           @relation(fields: [projectId], references: [id], onDelete: SetNull)
  parcel           Parcel?            @relation(fields: [parcelId], references: [id], onDelete: SetNull)
  forecastSnapshot ForecastSnapshot?  @relation(fields: [forecastSnapshotId], references: [id], onDelete: SetNull)
  explanations     AlertExplanation[]

  @@index([ruleId, capturedAt])
  @@index([subjectKind, subjectId, capturedAt])
  @@index([projectId, capturedAt])
  @@index([parcelId, capturedAt])
  @@index([reviewStatus])
  @@index([severity])
  @@index([capturedAt])
}

// Per-alert subscription. Operator decides where alerts from a rule should
// be delivered. IN_APP is the default; EMAIL / WEBHOOK delivery requires
// PR-2 follow-up (this PR ships only IN_APP).
model AlertSubscription {
  id               String  @id @default(cuid())
  ruleId           String
  subscriberUserId String?
  subscriberEmail  String?
  deliveryChannel  String  @default("IN_APP")
  // Per-channel config (e.g. webhook URL, email tokenization options).
  configJson       String?
  active           Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  rule AlertRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)

  @@unique([ruleId, subscriberEmail, deliveryChannel])
  @@index([ruleId])
  @@index([subscriberUserId])
  @@index([deliveryChannel])
  @@index([active])
}

// Structured explanation rows for a fired alert. One row per factor /
// piece of evidence so the UI can render a sortable why-table without
// parsing payloadJson.
model AlertExplanation {
  id      String @id @default(cuid())
  alertId String

  factorKind  String // EVIDENCE | FORECAST_DELTA | CALIBRATION_CONTEXT | ...
  factorName  String
  factorScore Float?
  rationale   String

  // Optional pointer to source row driving this factor.
  sourceRefKind String?
  sourceRefId   String?

  createdAt DateTime @default(now())

  alert AlertEvent @relation(fields: [alertId], references: [id], onDelete: Cascade)

  @@index([alertId])
  @@index([factorKind])
}

// Operator briefing document. Generated periodically (weekly / on-demand)
// summarizing emergence patterns for human consumption. NOT shared
// externally — internal command-center artifact.
model BriefingDocument {
  id String @id @default(cuid())

  briefingKind String
  title        String
  // Time window the briefing covers.
  windowStart  DateTime
  windowEnd    DateTime

  // Optional scope filters.
  jurisdictionKey String?
  corridorKey     String?
  watchlistId     String?

  status      String  @default("DRAFT")
  // Free-text TL;DR rendered at the top.
  summary     String?
  // Structured payload — full evidence bundle.
  payloadJson String?

  authoredByUserId String?
  authoredByEmail  String?

  generatedAt DateTime  @default(now())
  publishedAt DateTime?
  updatedAt   DateTime  @updatedAt

  sections BriefingSection[]

  @@index([briefingKind])
  @@index([status])
  @@index([windowStart])
  @@index([jurisdictionKey])
  @@index([corridorKey])
  @@index([watchlistId])
}

// Per-section briefing content. Ordered display via `position`. Cascade
// from BriefingDocument so an archived briefing loses its sections.
model BriefingSection {
  id         String @id @default(cuid())
  briefingId String

  position    Int     @default(0)
  sectionKind String
  title       String?
  body        String // markdown-ish operator-facing text

  // Optional structured payload for the section (factor lists, evidence rows).
  payloadJson String?

  createdAt DateTime @default(now())

  briefing BriefingDocument @relation(fields: [briefingId], references: [id], onDelete: Cascade)

  @@index([briefingId, position])
  @@index([sectionKind])
}

// Operator-curated targeting pattern. Either rule-defined (criteria JSON)
// or operator-tagged (a known pattern the operator wants to surface
// recurrence of). The engine evaluates these and writes AlertEvents when
// matches occur.
model TargetingPattern {
  id String @id @default(cuid())

  ownerUserId String?
  ownerEmail  String?

  name        String
  description String?
  patternKind String

  // Pattern criteria — schema varies per patternKind.
  criteriaJson String

  // Optional priority for surfacing.
  priority Int @default(3)

  // Activity tracking.
  lastEvaluatedAt DateTime?
  lastMatchedAt   DateTime?
  matchCount      Int       @default(0)

  active Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([patternKind])
  @@index([active])
  @@index([priority])
  @@index([lastMatchedAt])
}

// Per-user workspace preferences. Layout choice, pinned watchlists, default
// filters. One row per user (the relation enforces it via unique).
model WorkspacePreference {
  id        String  @id @default(cuid())
  userId    String  @unique
  userEmail String?

  layoutKind          String  @default("DASHBOARD")
  // CSV of watchlist ids pinned to the top of the workspace.
  pinnedWatchlistsCsv String?
  // CSV of corridor keys pinned.
  pinnedCorridorsCsv  String?
  // Default jurisdiction filter.
  defaultJurisdiction String?

  // Free-form display-only JSON for any future preference additions.
  preferencesJson String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userEmail])
}

// ── Integration Credentials Vault ───────────────────────────────────────────
//
// Encrypted storage for third-party integration credentials (Beeline, Blue
// Book Network, ConstructConnect, iSqFt, etc.). Encryption is AES-256-GCM
// with a master key from CREDENTIAL_MASTER_KEY env var. The DB never holds
// plaintext; the master key never enters the DB.
//
// Read path: ONLY lib/services/credentials/credentialVault.ts may decrypt.
// AI/prompt-building code is forbidden from importing the vault (enforced
// by ESLint no-restricted-imports rule). See docs/architecture/CREDENTIALS.md.
model IntegrationCredential {
  id             String    @id @default(cuid())
  service        String // "beeline" | "blue_book" | "constructconnect" | "isqft"
  field          String // "username" | "password" | "api_key" | "totp_secret"
  encryptedValue String // base64 ciphertext
  iv             String // base64 nonce (12 bytes for GCM)
  authTag        String // base64 GCM auth tag
  algorithm      String    @default("aes-256-gcm")
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  lastTestedAt   DateTime?
  lastTestStatus String? // 'success' | 'failed' | null
  lastTestError  String?

  @@unique([service, field])
  @@index([service])
}

// ──────────────────────────────────────────────────────────────────────────────
//  Observability: cross-cutting AuditEvent persistence (Phase O1.2)
//
//  Single canonical table for audit events that must outlive Loki retention.
//  The existing 7 service audit emitters (entity-resolver, project-aggregator,
//  parcel-memory, emergence-forecast, outcome-calibration,
//  operator-workspace, live-ingestion) continue to emit stdout JSON as
//  before — Promtail scrapes those to Loki for hot search.
//
//  This table is for the subset of audit events that need DB-backed
//  forever-persistence:
//    - operator_override
//    - merge_split
//    - replay_run
//    - migration_governance
//    - runner_cycle
//    - review_action
//    - alert_review
//    - calibration_adjustment (when operator-applied)
//    - ingestion_pipeline_error
//    - system_health
//
//  Volume estimate: ≤ 1000 rows/day at metro scale. Indexes optimized for
//  operator queries:
//    - by category + time ("show me all operator overrides this week")
//    - by subject ("show me everything that happened to this project")
//    - by correlation/replay/ingestion id (cross-service tracing)
//    - by actor ("show me what this analyst did today")
//
//  Append-only. No update / no delete by code. Retention enforced by ops
//  job (future O3) — likely 5+ years for compliance-grade lineage.
// ──────────────────────────────────────────────────────────────────────────────

model AuditEvent {
  id String @id @default(cuid())

  category String // entity_resolution | project_attachment | forecast_generation | ...
  action   String // service-specific verb
  severity String @default("INFO") // DEBUG | INFO | NOTICE | WARN | ERROR | CRITICAL

  // Subject + actor (loose-pointer).
  subjectKind String?
  subjectId   String?
  actorUserId String?
  actorEmail  String?
  actorKind   String  @default("system") // operator | system | runner | api | anonymous

  // Correlation envelope.
  correlationId String?
  replayId      String?
  ingestionId   String?
  runnerId      String?

  // Version snapshot at emit time. JSON of all engine version tags.
  schemaVersion   String  @default("1.0")
  versionTagsJson String?

  // Operator-readable payload.
  decision    String?
  reasonLog   String? // JSON-stringified string array
  payloadJson String?

  emittedAt DateTime @default(now())

  @@index([category, emittedAt])
  @@index([action])
  @@index([subjectKind, subjectId])
  @@index([actorUserId])
  @@index([correlationId])
  @@index([replayId])
  @@index([ingestionId])
  @@index([runnerId])
  @@index([severity])
  @@index([emittedAt])
}

// ──────────────────────────────────────────────────────────────────────────────
//  Operational: RunnerLease (Phase O1.4)
//
//  Coordination primitive for recurring MI cycle execution (forecast,
//  calibration, briefing, alert-eval, outcome-detect, backfill). Provides:
//
//    1. At-most-once execution per window — multiple workers can't both
//       fire the daily forecast cycle.
//    2. Heartbeat — a long-running cycle extends its lease periodically;
//       absence of heartbeats > lease window flags a stale/hung run.
//    3. Cycle history — last successful + last attempted run per cycleKey
//       with status + duration + error.
//
//  Distinct from BackgroundJob (which is per-bid + per-jobType). RunnerLease
//  is platform-wide: one row per cycleKey × windowStart.
//
//  windowKey shape: `<cycleName>_<windowGranularity>_<windowStartIso>`
//    e.g. "forecast-daily_2026-05-19"
//         "calibration-weekly_2026-W20"
//         "briefing-corridor-daily_2026-05-19"
//
//  Append-only history-wise: re-running the same cycleKey + window updates
//  the existing row (status transitions, heartbeats); never deleted. The
//  AuditEvent table (O1.2) carries the long-lived runner_cycle history;
//  this table is hot-path coordination only.
// ──────────────────────────────────────────────────────────────────────────────

model RunnerLease {
  id String @id @default(cuid())

  // Cycle identity. cycleName is the stable runner name (e.g. forecast-daily).
  // windowKey is the unique (cycleName + window-bounded-time) string that
  // makes a particular cycle invocation idempotent.
  cycleName String
  windowKey String @unique

  // Lease semantics.
  status          String   @default("claimed") // claimed | running | succeeded | failed | stale
  leaseToken      String // random per-claim; only this holder can release
  leasedBy        String // runner instance identifier (hostname/pid/uuid)
  leasedAt        DateTime @default(now())
  leaseExpiresAt  DateTime // claim window; holder must heartbeat before this
  lastHeartbeatAt DateTime @default(now())

  // Outcome.
  finishedAt   DateTime?
  durationMs   Int?
  errorMessage String?

  // Optional correlation pointers (matches AuditEvent envelope from O1.2).
  runnerId String? // matches AuditEvent.runnerId for cross-tier tracing
  replayId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([cycleName, leasedAt])
  @@index([status])
  @@index([leaseExpiresAt])
  @@index([runnerId])
}

// ──────────────────────────────────────────────────────────────────────────────
//  Module OPS1 — Tracked Item register spine (Slice 1)
//
//  ONE shared operations register — OAC action items, field/JSO report items,
//  warranty/closeout/training/O&M items, testing/inspection, attic stock —
//  instead of five disconnected builders. Every row carries an embedded
//  source citation (typed nullable FKs + excerpt + locator + extraction
//  provenance). Rows are live tracked commitments created or promoted by a
//  HUMAN; AI-extracted candidates are drafted elsewhere and only become rows
//  here through explicit human action. Status transitions are human-only and
//  validated by lib/services/trackedItems/fsm.ts (OPEN → IN_PROGRESS →
//  READY_TO_CLOSE → CLOSED, or → WAIVED with a required reason); nothing in
//  this module auto-closes, auto-assigns, or sends communications.
//
//  Citation FKs use onDelete: SetNull deliberately: deleting source evidence
//  (a meeting, a spec section wiped by re-split, a promoted action item) must
//  never destroy the tracked commitment — the denormalized evidenceExcerpt /
//  sourceLocator snapshot survives.

model TrackedItem {
  id          Int     @id @default(autoincrement())
  bidId       Int
  kind        String // OAC_ACTION | FIELD_ITEM | JSO_ITEM | WARRANTY | CLOSEOUT | TRAINING | OM | TEST_INSPECTION | ATTIC_STOCK
  title       String
  description String?
  status      String  @default("OPEN") // OPEN | IN_PROGRESS | READY_TO_CLOSE | CLOSED | WAIVED — fsm.ts is the single authority
  priority    String  @default("MEDIUM") // LOW | MEDIUM | HIGH | CRITICAL (same vocabulary as MeetingActionItem)

  assigneeName              String?
  assigneeEmail             String?
  projectContactId          Int?
  tradeId                   Int?
  leadTradeId               Int?
  responsibleContractorId   Int?
  gcInternalResponsibility  Boolean   @default(false)
  consultantDiscipline      String?
  sourceReportObservationId Int?      @unique
  dueDate                   DateTime?
  carriedFromDate           String? // ISO date — mirrors MeetingActionItem.carriedFromDate

  // ── Embedded source citation ────────────────────────────────────────────
  // Canonical vocabulary (single source of truth: lib/services/trackedItems/sourceKinds.ts):
  //   manual | meeting_action_item | meeting_design_change | meeting_register |
  //   consultant_observation | field_report
  // Legacy values still present on old rows (readable forever, never rewritten,
  // never written by new code): meeting | consultant_report | spec_section
  // (jso_report reserved for a later slice)
  sourceKind                    String  @default("manual")
  sourceMeetingId               Int?
  sourceMeetingActionItemId     Int?    @unique // at most one TrackedItem per promoted MeetingActionItem (bridge duplicate guard)
  sourceSpecSectionId           Int?
  sourceFieldReportId           Int? // Slice 2 — items created from a FieldReport cite it here (SetNull: report deletion never destroys the item)
  sourceConsultantObservationId Int?    @unique // Phase 1A — the ONE originating consultant observation (accept-new duplicate guard; supporting citations live on ConsultantObservation.registerItemId)
  sourceMeetingRegisterEntryId  Int?    @unique // R2-B1 — the ONE originating Meeting Register entry when promoted (duplicate guard; supporting/continuity links live on MeetingRegisterEntry.linkedTrackedItemId)
  evidenceExcerpt               String? // verbatim/paraphrased source text carried forward at promotion time
  sourceLocator                 String? // page / timestamp / transcript-anchor hint; rough or null in V1
  extractionMethod              String  @default("manual") // manual | meeting_analysis | regex | heuristic | ai_claude — every producer writes this EXPLICITLY (never rely on the default; see the WP1a seeder-provenance lesson)
  extractorVersion              String?
  citationVerified              Boolean @default(false) // true only when the excerpt was verified against the stored source text

  closedAt     DateTime?
  closedBy     String? // required by fsm.ts for CLOSED
  waivedReason String? // required by fsm.ts for WAIVED

  // ── Formal response (Phase 1A) ──────────────────────────────────────────
  // ONE current formal response per item — the deliberate statement we make
  // back to the consultant. Explicit save only (no autosave). Every edit is
  // an audited PATCH; the immediately-prior value is kept here (bounded) AND
  // in the audit event's payloadJson. Never sourced from TrackedItemComment.
  formalResponse      String?
  formalResponseBy    String?
  formalResponseAt    DateTime?
  formalResponsePrior String?

  // Phase 1B — PM review flag: set/cleared MANUALLY by pm|admin only,
  // never automatically (no trigger on link/dispose/status). Audited.
  pmReviewRequired Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  bid                         Bid                          @relation(fields: [bidId], references: [id], onDelete: Cascade)
  projectContact              ProjectContact?              @relation(fields: [projectContactId], references: [id], onDelete: SetNull)
  trade                       Trade?                       @relation(fields: [tradeId], references: [id], onDelete: SetNull)
  leadTrade                   Trade?                       @relation("TrackedItemLeadTrade", fields: [leadTradeId], references: [id], onDelete: SetNull)
  // Physical FK remains SET NULL from the additive Build 2 migration. The
  // R2B2_responsible_contractor_retention_guard trigger owns the effective
  // history-retention restriction without rebuilding this inherited table.
  responsibleContractor       Subcontractor?               @relation("TrackedItemResponsibleContractor", fields: [responsibleContractorId], references: [id], onDelete: SetNull)
  sourceReportObservation     ReportObservation?           @relation("PromotedReportObservation", fields: [sourceReportObservationId], references: [id], onDelete: Restrict)
  sourceMeeting               Meeting?                     @relation(fields: [sourceMeetingId], references: [id], onDelete: SetNull)
  sourceMeetingActionItem     MeetingActionItem?           @relation(fields: [sourceMeetingActionItemId], references: [id], onDelete: SetNull)
  sourceSpecSection           SpecSection?                 @relation(fields: [sourceSpecSectionId], references: [id], onDelete: SetNull)
  sourceFieldReport           FieldReport?                 @relation(fields: [sourceFieldReportId], references: [id], onDelete: SetNull)
  sourceConsultantObservation ConsultantObservation?       @relation("TrackedItemOriginatingObservation", fields: [sourceConsultantObservationId], references: [id], onDelete: SetNull)
  sourceMeetingRegisterEntry  MeetingRegisterEntry?        @relation("TrackedItemOriginatingRegisterEntry", fields: [sourceMeetingRegisterEntryId], references: [id], onDelete: SetNull)
  supportingObservations      ConsultantObservation[]      @relation("ObservationRegisterItem")
  spawnedFromObservations     ConsultantObservation[]      @relation("ObservationSpawnedItem")
  linkedRegisterEntries       MeetingRegisterEntry[]       @relation("RegisterEntryOpsLink")
  comments                    TrackedItemComment[]
  attachments                 TrackedItemAttachment[]
  linkedDesignChanges         DesignIntentChange[]
  reportObservations          ReportObservation[]          @relation("ReportObservationRegisterItem")
  tradeAssignments            TrackedItemTradeAssignment[]
  responsePackageItems        ResponsePackageItem[]

  @@index([bidId])
  @@index([bidId, kind])
  @@index([bidId, status])
  @@index([bidId, leadTradeId])
  @@index([bidId, responsibleContractorId])
  @@index([dueDate])
}

// Append-only in V1: no edit/delete routes exist by design — the thread is an
// honest trail. Author fields come from the session where available.
model TrackedItemComment {
  id            Int      @id @default(autoincrement())
  trackedItemId Int
  authorName    String?
  authorEmail   String?
  body          String
  createdAt     DateTime @default(now())

  trackedItem TrackedItem @relation(fields: [trackedItemId], references: [id], onDelete: Cascade)

  @@index([trackedItemId])
}

// Attachment metadata only — bytes live in BlobStore under the relative key
// shape plan-room/jobs/{bidId}/tracked-items/{trackedItemId}/{safeFileName}
// (lib/services/trackedItems/storagePath.ts). MIME-allowlisted (jpeg/png/
// webp/pdf), size-capped, served only through authenticated routes. No
// EXIF/GPS processing, no thumbnails in V1.
// ── Module OPS2 (Slice 2) — Field Report source documents ───────────────────
//
// A FieldReport is SOURCE EVIDENCE, not a second tracker: uploaded field/
// daily reports live here (metadata + BlobStore key), and operations items
// created from them are TrackedItem rows (kind FIELD_ITEM, sourceKind
// "field_report", sourceFieldReportId citation) — HUMAN-created one at a
// time, never auto-extracted. parseStatus is a placeholder vocabulary in V0
// ("UNPARSED" only); OCR/AI parse stages are later, separately-gated slices.

model FieldReport {
  id                   Int       @id @default(autoincrement())
  bidId                Int
  title                String
  reportDate           DateTime?
  authorName           String?
  // Original uploaded file (nullable — a report row may be created before
  // its file is uploaded). Bytes in BlobStore under
  // plan-room/jobs/{bidId}/field-reports/{fieldReportId}/{safeFileName}.
  sourceFileStorageKey String?
  originalFileName     String?
  mimeType             String?
  byteSize             Int?
  parseStatus          String    @default("UNPARSED") // UNPARSED only in V0 — no OCR/AI parse states exist yet
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  bid          Bid                 @relation(fields: [bidId], references: [id], onDelete: Cascade)
  trackedItems TrackedItem[]
  observations ReportObservation[]

  @@index([bidId])
  @@index([bidId, reportDate])
}

// ──────────────────────────────────────────────────────────────────────────────
//  Module OPS3 (Phase 1A) — Consultant Reports.
//
//  Reports received FROM consultants (architect/engineer field reports,
//  commissioning, testing/inspection) — business-document identity split
//  from immutable file rows (revisions). Observations are durable rows a
//  human enters while reading the PDF; accepting one creates/links a
//  TrackedItem on the shared register spine. This module NEVER: parses,
//  extracts, OCRs, calls a provider, auto-creates items, auto-closes
//  anything, or hard-deletes a report/revision/observation. Voiding is a
//  status flip; files and history are always retained.
// ──────────────────────────────────────────────────────────────────────────────

model ConsultantReport {
  id                     Int       @id @default(autoincrement())
  bidId                  Int
  vendorName             String // consultant firm, verbatim (e.g. "IMEG") — never hardcoded in code/copy
  title                  String? // consultant's own document title, metadata only (e.g. "Job Site Observation")
  reportNumber           String? // original-verbatim number (e.g. "#14")
  reportNumberNormalized String? // lowercased/trimmed for soft duplicate-warning queries — NO hard uniqueness (consultant numbering is too inconsistent)
  // Fixed category vocabulary (API-validated string, never a Prisma enum):
  // ARCHITECT_FIELD_REPORT | ENGINEER_FIELD_REPORT | COMMISSIONING_REPORT |
  // TESTING_INSPECTION_REPORT | OTHER_CONSULTANT_REPORT
  reportType             String
  reportDate             DateTime?
  status                 String    @default("ACTIVE") // ACTIVE | VOIDED — void is a flip, never a delete
  voidedBy               String?
  voidedAt               DateTime?
  uploadedBy             String?
  uploadedAt             DateTime  @default(now())
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  bid                Bid                        @relation(fields: [bidId], references: [id], onDelete: Cascade)
  revisions          ConsultantReportRevision[]
  observations       ConsultantObservation[]
  reportObservations ReportObservation[]

  @@index([bidId])
  @@index([bidId, status])
  @@index([bidId, reportNumberNormalized])
}

// Immutable per-file row. Revision 0 is created inside the upload
// transaction; a corrected file for the SAME report identity appends a new
// revision with supersedesRevisionId set (set-once). Both files stay
// downloadable forever. A later periodic report is a NEW ConsultantReport,
// never a revision.
model ConsultantReportRevision {
  id                   Int      @id @default(autoincrement())
  reportId             Int
  bidId                Int // denormalized for the [bidId, checksum] duplicate guard + bid-scoped fetches
  revisionIndex        Int      @default(0)
  storedKey            String // content-addressed: plan-room/jobs/{bidId}/consultant-reports/{sha256}.pdf — NEVER client-supplied
  originalFilename     String
  fileSizeBytes        Int
  mimeType             String // application/pdf only in 1A
  checksum             String // sha-256 hex of the exact bytes
  uploadedBy           String?
  uploadedAt           DateTime @default(now())
  replacementReason    String?
  supersedesRevisionId Int?     @unique // self-FK, set-once, SetNull

  report             ConsultantReport          @relation(fields: [reportId], references: [id], onDelete: Cascade)
  bid                Bid                       @relation(fields: [bidId], references: [id], onDelete: Cascade)
  supersedesRevision ConsultantReportRevision? @relation("RevisionSupersedes", fields: [supersedesRevisionId], references: [id], onDelete: SetNull)
  supersededBy       ConsultantReportRevision? @relation("RevisionSupersedes")

  @@unique([bidId, checksum]) // the sole hard uniqueness constraint in Phase 1A — same bytes in the same bid is a duplicate, never silently re-stored
  @@index([reportId])
  @@index([bidId])
}

// Durable observation row — a human's manual entry while reading the PDF.
// State machine (service-enforced, never a Prisma enum):
//   ENTERED → ACCEPTED_NEW_ITEM | ACCEPTED_LINKED_ITEM | DISMISSED
//   DISMISSED → ENTERED (reinstate) ; ACCEPTED_LINKED_ITEM → ACCEPTED_LINKED_ITEM (relink correction)
// Source-verbatim fields (observationText, sourcePage, consultantTargetDate)
// FREEZE the instant a row leaves ENTERED — post-acceptance corrections
// happen on the TrackedItem, never here.
model ConsultantObservation {
  id                   Int       @id @default(autoincrement())
  reportId             Int
  bidId                Int // denormalized for bid-scoped fetches + the application-layer same-bid link check (SQLite cannot express a cross-table same-value constraint)
  observationText      String
  sourcePage           String? // verbatim locator (e.g. "p.2") — frozen after resolution like every verbatim field
  consultantTargetDate DateTime? // consultant-reported target — NEVER synced with TrackedItem.dueDate in either direction
  state                String    @default("ENTERED") // ENTERED | ACCEPTED_NEW_ITEM | ACCEPTED_LINKED_ITEM | DISMISSED
  registerItemId       Int? // many observations may support ONE TrackedItem (set at acceptance/link; SetNull)
  spawnedItemId        Int? // Phase 1B — the TrackedItem this observation CAUSED via /spawn (linking sets registerItemId only; spawning sets BOTH; SetNull)
  dismissedReason      String?
  createdBy            String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  report         ConsultantReport              @relation(fields: [reportId], references: [id], onDelete: Cascade)
  bid            Bid                           @relation(fields: [bidId], references: [id], onDelete: Cascade)
  registerItem   TrackedItem?                  @relation("ObservationRegisterItem", fields: [registerItemId], references: [id], onDelete: SetNull)
  spawnedItem    TrackedItem?                  @relation("ObservationSpawnedItem", fields: [spawnedItemId], references: [id], onDelete: SetNull)
  originatedItem TrackedItem?                  @relation("TrackedItemOriginatingObservation")
  dispositions   ConsultantDispositionRecord[]

  @@index([reportId, state])
  @@index([bidId])
  @@index([registerItemId])
}

// Phase 1B — append-only consultant disposition log. NO update or delete
// path exists at ANY layer: the service module exports create/read only,
// the route answers PATCH/PUT/DELETE with 405, and the Prisma client
// extension in lib/prisma.ts rejects update/upsert/delete on this model
// outright. A wrong disposition is corrected by APPENDING a new record;
// the current disposition is the latest by (disposedAt, id).
model ConsultantDispositionRecord {
  id              Int      @id @default(autoincrement())
  observationId   Int
  bidId           Int // scoping for cross-project 404s
  dispositionType String // APPROVE | REJECT | DEFER | VOID — app-validated string, never a Prisma enum (repo convention)
  dispositionText String? // optional rationale, ≤2000 (service-enforced)
  disposedBy      String // session actor — REQUIRED; a record with no human author must be impossible
  disposedAt      DateTime @default(now())
  createdAt       DateTime @default(now())

  observation ConsultantObservation @relation(fields: [observationId], references: [id], onDelete: Cascade)
  bid         Bid                   @relation(fields: [bidId], references: [id], onDelete: Cascade)

  @@index([observationId, disposedAt])
  @@index([bidId])
}

// ── Module OPS6 (Phase 2) — consultant-stream PDF export record ─────────────
// One row per generated export: the immutable artifact trail behind the
// authenticated download URL. NO update path exists by design — a stale
// export is superseded by generating a new one, never edited. Bytes live
// in the BlobStore under the content-addressed storedKey; serving happens
// only through the bid-scoped download route (never a public/signed URL).
model ConsultantStreamExport {
  id               String   @id @default(cuid())
  bidId            Int
  storedKey        String // plan-room/jobs/{bidId}/consultant-stream-exports/{sha256}.pdf — server-derived, never client-supplied
  sha256           String
  byteSize         Int
  pageCount        Int      @default(0)
  observationCount Int
  filtersJson      String // the exact filters this export was generated with (dateFrom/dateTo/observationIds/includeDisposed)
  generatedBy      String?
  generatedAt      DateTime @default(now())

  bid Bid @relation(fields: [bidId], references: [id], onDelete: Cascade)

  @@index([bidId, generatedAt])
}

model TrackedItemAttachment {
  id            Int      @id @default(autoincrement())
  trackedItemId Int
  storageKey    String
  fileName      String
  mimeType      String
  byteSize      Int
  kind          String   @default("photo") // photo | document
  caption       String?
  createdBy     String?
  createdAt     DateTime @default(now())

  trackedItem TrackedItem @relation(fields: [trackedItemId], references: [id], onDelete: Cascade)

  @@index([trackedItemId])
}

// ── R2 Build 2 — Field Reports & Trade Response ───────────────────────────
// Human-authored source observation. Verbatim source fields may be edited
// only while disposition=OPEN; leaving OPEN freezes them permanently.
model ReportObservation {
  id                 Int       @id @default(autoincrement())
  bidId              Int
  sourceKind         String // field_report | consultant_report | direct_entry
  fieldReportId      Int?
  consultantReportId Int?
  observationText    String
  sourceLocator      String?
  observedAt         DateTime?
  disposition        String    @default("OPEN")
  dispositionBy      String?
  dispositionAt      DateTime?
  dispositionReason  String?
  registerItemId     Int?
  createdBy          String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  bid                 Bid               @relation(fields: [bidId], references: [id], onDelete: Restrict)
  fieldReport         FieldReport?      @relation(fields: [fieldReportId], references: [id], onDelete: Restrict)
  consultantReport    ConsultantReport? @relation(fields: [consultantReportId], references: [id], onDelete: Restrict)
  registerItem        TrackedItem?      @relation("ReportObservationRegisterItem", fields: [registerItemId], references: [id], onDelete: Restrict)
  promotedTrackedItem TrackedItem?      @relation("PromotedReportObservation")

  @@index([bidId, disposition])
  @@index([fieldReportId])
  @@index([consultantReportId])
  @@index([registerItemId])
}

model TrackedItemTradeAssignment {
  id            Int    @id @default(autoincrement())
  bidId         Int
  trackedItemId Int
  tradeId       Int
  role          String @default("SUPPORTING") // LEAD | SUPPORTING

  bid         Bid         @relation(fields: [bidId], references: [id], onDelete: Cascade)
  trackedItem TrackedItem @relation(fields: [trackedItemId], references: [id], onDelete: Cascade)
  trade       Trade       @relation(fields: [tradeId], references: [id], onDelete: Cascade)

  @@unique([trackedItemId, tradeId])
  @@index([bidId, trackedItemId])
}

model ResponsePackage {
  id              Int       @id @default(autoincrement())
  bidId           Int
  packageNumber   Int
  title           String
  contractorId    Int?
  status          String    @default("DRAFT")
  issuedAt        DateTime?
  issuedBy        String?
  responseDueDate DateTime?
  manualChannel   String? // EMAIL | PROCORE | OTHER; recorded alternative to portal token
  voidedBy        String?
  voidedAt        DateTime?
  createdBy       String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  bid        Bid                   @relation(fields: [bidId], references: [id], onDelete: Restrict)
  contractor Subcontractor?        @relation(fields: [contractorId], references: [id], onDelete: Restrict)
  items      ResponsePackageItem[]
  tokens     ResponseAccessToken[]

  @@unique([bidId, packageNumber])
  @@index([bidId, status])
  @@index([bidId, contractorId])
}

model ResponsePackageItem {
  id            Int     @id @default(autoincrement())
  packageId     Int
  bidId         Int
  trackedItemId Int
  displayNumber String?

  package     ResponsePackage         @relation(fields: [packageId], references: [id], onDelete: Restrict)
  bid         Bid                     @relation(fields: [bidId], references: [id], onDelete: Restrict)
  trackedItem TrackedItem             @relation(fields: [trackedItemId], references: [id], onDelete: Restrict)
  responses   TradeResponseRevision[]

  @@unique([packageId, trackedItemId])
  @@index([bidId, packageId])
  @@index([bidId, trackedItemId])
}

// Contractor-controlled response fields are immutable after create. GC review
// fields may be set through the dedicated review service only.
model TradeResponseRevision {
  id                     Int       @id @default(autoincrement())
  bidId                  Int
  packageItemId          Int
  revisionIndex          Int       @default(0)
  responderName          String
  responderCompany       String?
  channel                String    @default("PORTAL")
  responseType           String
  responseText           String
  proposedCompletionDate DateTime?
  actualCompletionDate   DateTime?
  submittedAt            DateTime  @default(now())
  enteredBy              String?
  gcReview               String    @default("PENDING")
  gcReviewBy             String?
  gcReviewAt             DateTime?
  gcCommentary           String?

  bid             Bid                           @relation(fields: [bidId], references: [id], onDelete: Restrict)
  packageItem     ResponsePackageItem           @relation(fields: [packageItemId], references: [id], onDelete: Restrict)
  attachments     TradeResponseAttachment[]
  reviewDecisions TradeResponseReviewDecision[]

  @@unique([packageItemId, revisionIndex])
  @@index([bidId, packageItemId])
}

model TradeResponseAttachment {
  id                 Int      @id @default(autoincrement())
  responseRevisionId Int
  bidId              Int
  storageKey         String
  fileName           String
  mimeType           String
  byteSize           Int
  createdAt          DateTime @default(now())

  responseRevision TradeResponseRevision @relation(fields: [responseRevisionId], references: [id], onDelete: Restrict)
  bid              Bid                   @relation(fields: [bidId], references: [id], onDelete: Restrict)

  @@unique([responseRevisionId, storageKey])
  @@index([bidId, responseRevisionId])
}

model ResponseAccessToken {
  id              String    @id @default(cuid())
  bidId           Int
  packageId       Int
  tokenHash       String    @unique
  contractorEmail String?
  expiresAt       DateTime
  revokedAt       DateTime?
  createdBy       String
  createdAt       DateTime  @default(now())
  lastUsedAt      DateTime?

  bid     Bid             @relation(fields: [bidId], references: [id], onDelete: Restrict)
  package ResponsePackage @relation(fields: [packageId], references: [id], onDelete: Restrict)

  @@index([bidId, packageId])
  @@index([expiresAt])
}

// Immutable GC review evidence. The projection fields on TradeResponseRevision
// remain convenient for readiness checks, while every decision/correction is
// retained here with explicit provenance.
model TradeResponseReviewDecision {
  id                 Int      @id @default(autoincrement())
  bidId              Int
  responseRevisionId Int
  decision           String
  commentary         String?
  reviewedBy         String
  correctionOfId     Int?
  createdAt          DateTime @default(now())

  bid              Bid                           @relation(fields: [bidId], references: [id], onDelete: Restrict)
  responseRevision TradeResponseRevision         @relation(fields: [responseRevisionId], references: [id], onDelete: Restrict)
  correctionOf     TradeResponseReviewDecision?  @relation("ReviewDecisionCorrections", fields: [correctionOfId], references: [id], onDelete: Restrict)
  corrections      TradeResponseReviewDecision[] @relation("ReviewDecisionCorrections")

  @@index([bidId, responseRevisionId, createdAt])
  @@index([correctionOfId])
}

// Shared, expiring coordination state for the public token wall. Rows are
// keyed by a server-derived digest (never a caller-provided address or raw
// token), and expired rows are removed on consumption.
model ExternalResponseRateLimitBucket {
  key             String   @id
  requestCount    Int      @default(0)
  windowStartedAt DateTime
  expiresAt       DateTime
  updatedAt       DateTime @updatedAt

  @@index([expiresAt])
}

model DesignIntentChange {
  id                  Int                    @id @default(autoincrement())
  meetingId           Int
  bidId               Int
  changeText          String
  priorIntent         String?
  affectedSpec        String?
  severity            String
  sourceQuote         String?
  speakerLabel        String?
  state               String                 @default("PROPOSED")
  extractedAt         DateTime               @default(now())
  confirmedBy         String?
  dismissedReason     String?
  linkedTrackedItemId Int?
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt
  meeting             Meeting                @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  bid                 Bid                    @relation(fields: [bidId], references: [id], onDelete: Cascade)
  linkedItem          TrackedItem?           @relation(fields: [linkedTrackedItemId], references: [id], onDelete: SetNull)
  registerEntries     MeetingRegisterEntry[]

  @@index([bidId, state])
  @@index([meetingId])
  @@index([linkedTrackedItemId])
}

model MeetingCommitment {
  id                 Int                    @id @default(autoincrement())
  meetingId          Int
  bidId              Int
  committedBy        String
  speakerLabel       String?
  commitmentText     String
  duePhrase          String?
  dueDate            DateTime?
  sourceQuote        String?
  status             String                 @default("PROPOSED")
  confirmedBy        String?
  fulfilledBy        String?
  dismissedReason    String?
  linkedActionItemId Int?
  extractedAt        DateTime               @default(now())
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt
  meeting            Meeting                @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  bid                Bid                    @relation(fields: [bidId], references: [id], onDelete: Cascade)
  linkedActionItem   MeetingActionItem?     @relation(fields: [linkedActionItemId], references: [id], onDelete: SetNull)
  registerEntries    MeetingRegisterEntry[]

  @@index([bidId, status, dueDate])
  @@index([meetingId])
}

// ──────────────────────────────────────────────────────────────────────────────
//  Module R2-B1 — Meeting Register Foundation.
//
//  Domain contract: docs/architecture/R2_MEETING_RESPONSE_CONTROL_LOOP.md.
//  Discipline mirrors OPS3/OPS4: status vocabularies are app-validated
//  strings (never Prisma enums); history is append-only; original source
//  material (raw transcript JSON, original segment text/attribution, raw
//  register wording) is FROZEN — corrections are overlays or appended
//  records, never rewrites. Meeting.rawTranscript remains the immutable
//  transcription record; segments below are a deterministic projection.
// ──────────────────────────────────────────────────────────────────────────────

// Materialized projection of Meeting.rawTranscript's segments (or, for
// manual transcripts, of "[HH:MM:SS] Speaker: text" lines). original*
// columns are written once at materialization and never updated; the
// current* columns are the correction overlay the UI renders. A split
// deactivates the original row (retained forever, still citable) and
// inserts replacements carrying splitFromSegmentId + fractional sortKey.
model MeetingTranscriptSegment {
  id                   Int      @id @default(autoincrement())
  meetingId            Int
  bidId                Int
  segmentIndex         Int // position in the original materialization order
  sortKey              Float // display order; fractional values only ever come from splits
  startSec             Float?
  endSec               Float?
  originalSpeakerLabel String? // frozen at materialization — never updated
  originalText         String // frozen at materialization — never updated
  currentSpeakerLabel  String? // correction overlay; starts equal to original
  currentText          String // correction overlay; starts equal to original
  isUnknownSpeaker     Boolean  @default(false)
  isActive             Boolean  @default(true) // false only when superseded by a split
  splitFromSegmentId   Int?
  participantId        Int? // resolved current speaker identity
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  meeting         Meeting                    @relation(fields: [meetingId], references: [id], onDelete: Restrict)
  bid             Bid                        @relation(fields: [bidId], references: [id], onDelete: Restrict)
  participant     MeetingParticipant?        @relation(fields: [participantId], references: [id], onDelete: SetNull)
  splitFrom       MeetingTranscriptSegment?  @relation("SegmentSplit", fields: [splitFromSegmentId], references: [id], onDelete: SetNull)
  splitInto       MeetingTranscriptSegment[] @relation("SegmentSplit")
  registerEntries MeetingRegisterEntry[]

  @@index([meetingId, sortKey])
  @@index([meetingId, currentSpeakerLabel])
  @@index([bidId])
}

// APPEND-ONLY correction audit log. No update or delete path exists at any
// layer (service exports create/read only; routes answer PATCH/PUT/DELETE
// with 405; lib/prisma.ts client extension rejects mutation-of-history).
// A wrong correction is corrected by appending another correction.
model MeetingTranscriptCorrection {
  id                   Int      @id @default(autoincrement())
  meetingId            Int
  bidId                Int
  // RENAME_SPEAKER | REASSIGN_SEGMENT | REASSIGN_ALL_MATCHING |
  // MERGE_SPEAKERS | SPLIT_SEGMENT | MARK_UNKNOWN | EDIT_TEXT
  correctionType       String
  segmentId            Int? // segment-scoped ops; null for label-scoped ops
  fromValue            String? // bounded before-value (label or ≤500-char text excerpt)
  toValue              String? // bounded after-value
  affectedSegmentCount Int      @default(0)
  // JSON: { registerEntryIds: number[], actionItemIds: number[],
  //         commitmentIds: number[], designChangeIds: number[] } — ids only,
  // computed at correction time: derived objects whose attribution/citation
  // overlapped the corrected span. Never contains text.
  affectedDerivedJson  String   @default("{}")
  reason               String?
  correctedBy          String // session actor — REQUIRED; an authorless correction must be impossible
  createdAt            DateTime @default(now())

  meeting Meeting @relation(fields: [meetingId], references: [id], onDelete: Restrict)
  bid     Bid     @relation(fields: [bidId], references: [id], onDelete: Restrict)

  @@index([meetingId, createdAt])
  @@index([bidId])
}

// The durable Meeting Register — one row per meaningful item of meeting
// content (R2 rule 1). Rows persist regardless of disposition or promotion
// (rules 2, 12). rawSourceText is FROZEN at creation; normalizedText is the
// human-editable wording (edits audited via MeetingRegisterEntryRevision).
// TrackedItem remains the Operations Register (rule 3) — linkedTrackedItemId
// lets many entries across meetings collect onto one item (rule 10).
model MeetingRegisterEntry {
  id                   Int       @id @default(autoincrement())
  meetingId            Int
  bidId                Int
  // DISCUSSION | DECISION | QUESTION | ACTION_ITEM | COMMITMENT |
  // DESIGN_CHANGE | RISK | CONSTRAINT | SCHEDULE_ITEM | PROCUREMENT_ITEM |
  // INFORMATIONAL
  entryType            String
  agendaTopic          String?
  rawSourceText        String // source wording as extracted/entered — FROZEN
  normalizedText       String // human-normalized wording
  speakerLabel         String?
  speakerName          String?
  startSec             Float?
  endSec               Float?
  sourceCitation       String? // human-readable locator, e.g. "[12:34] SPEAKER_2"
  segmentId            Int? // anchor transcript segment where known
  participantsJson     String    @default("[]") // JSON string[] of participant names
  responsibleParty     String?
  dueDate              DateTime?
  confidence           String? // HIGH | MEDIUM | LOW — extraction confidence; null for manual
  // ai_extraction | manual | action_item_bridge | commitment_bridge |
  // design_change_bridge — every producer writes this EXPLICITLY
  origin               String
  extractionRunId      Int?
  // PENDING | CONFIRMED | CORRECTED | MERGED | DUPLICATE |
  // DISMISSED_WITH_REASON | DISCUSSION_ONLY | INFORMATIONAL |
  // PROMOTED_TO_OPERATIONS | SUPERSEDED — service-enforced; manual entries
  // land CONFIRMED. SUPERSEDED is the machine lifecycle outcome of an
  // extraction rerun (never a human disposition): the row is retained
  // forever as history, with the replacing run/entry recorded below.
  reviewState          String    @default("PENDING")
  dispositionReason    String?
  dispositionBy        String?
  dispositionAt        DateTime?
  // ── rerun supersession (R2 remediation — reruns never delete) ──
  // Only PENDING machine-origin entries are ever superseded; dispositioned,
  // linked, or promoted entries are preserved untouched by every rerun.
  supersededByRunId    Int? // the extraction run whose apply superseded this entry
  supersededByEntryId  Int? // the replacement entry, where a deterministic match exists
  supersededAt         DateTime?
  mergedIntoEntryId    Int?
  relatedPriorEntryId  Int? // cross-meeting continuity: the prior meeting's entry this continues
  linkedActionItemId   Int? // bridge to the operational lifecycle rows — link, never mirror
  linkedCommitmentId   Int?
  linkedDesignChangeId Int?
  linkedTrackedItemId  Int? // Operations Register link (many entries → one item)
  createdBy            String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  meeting             Meeting                        @relation(fields: [meetingId], references: [id], onDelete: Restrict)
  bid                 Bid                            @relation(fields: [bidId], references: [id], onDelete: Restrict)
  segment             MeetingTranscriptSegment?      @relation(fields: [segmentId], references: [id], onDelete: SetNull)
  extractionRun       MeetingExtractionRun?          @relation(fields: [extractionRunId], references: [id], onDelete: SetNull)
  supersededByRun     MeetingExtractionRun?          @relation("RegisterEntrySupersededByRun", fields: [supersededByRunId], references: [id], onDelete: SetNull)
  supersededByEntry   MeetingRegisterEntry?          @relation("RegisterEntrySupersession", fields: [supersededByEntryId], references: [id], onDelete: SetNull)
  supersededEntries   MeetingRegisterEntry[]         @relation("RegisterEntrySupersession")
  mergedIntoEntry     MeetingRegisterEntry?          @relation("RegisterEntryMerge", fields: [mergedIntoEntryId], references: [id], onDelete: SetNull)
  mergedEntries       MeetingRegisterEntry[]         @relation("RegisterEntryMerge")
  relatedPriorEntry   MeetingRegisterEntry?          @relation("RegisterEntryContinuity", fields: [relatedPriorEntryId], references: [id], onDelete: SetNull)
  relatedLaterEntries MeetingRegisterEntry[]         @relation("RegisterEntryContinuity")
  linkedActionItem    MeetingActionItem?             @relation(fields: [linkedActionItemId], references: [id], onDelete: SetNull)
  linkedCommitment    MeetingCommitment?             @relation(fields: [linkedCommitmentId], references: [id], onDelete: SetNull)
  linkedDesignChange  DesignIntentChange?            @relation(fields: [linkedDesignChangeId], references: [id], onDelete: SetNull)
  linkedTrackedItem   TrackedItem?                   @relation("RegisterEntryOpsLink", fields: [linkedTrackedItemId], references: [id], onDelete: SetNull)
  originatedItem      TrackedItem?                   @relation("TrackedItemOriginatingRegisterEntry")
  revisions           MeetingRegisterEntryRevision[]

  @@index([meetingId, entryType])
  @@index([meetingId, reviewState])
  @@index([bidId, reviewState])
  @@index([linkedTrackedItemId])
}

// APPEND-ONLY revision history for register entries (dispositions, edits,
// links, promotions). Same no-mutation discipline as
// MeetingTranscriptCorrection / ConsultantDispositionRecord.
model MeetingRegisterEntryRevision {
  id              Int      @id @default(autoincrement())
  entryId         Int
  bidId           Int
  // CREATED | DISPOSITION | EDIT | LINK | PROMOTION | RERUN_SUPERSEDE
  changeType      String
  fromReviewState String?
  toReviewState   String?
  // bounded JSON: field names + ids only (e.g. {"normalizedText": true,
  // "trackedItemId": 12}) — never long text bodies
  detailJson      String   @default("{}")
  actor           String // REQUIRED session actor
  reason          String?
  createdAt       DateTime @default(now())

  entry MeetingRegisterEntry @relation(fields: [entryId], references: [id], onDelete: Restrict)
  bid   Bid                  @relation(fields: [bidId], references: [id], onDelete: Restrict)

  @@index([entryId, createdAt])
  @@index([bidId])
}

// One row per extraction (analysis→register projection) run. The FIRST run
// for a meeting applies immediately (initial population). Every later run
// lands PREVIEWED holding the parsed analysis JSON; a human applies or
// discards it (R2 rules 7–8). Apply NEVER deletes register entries: PENDING
// machine-origin entries that the new analysis no longer produces are marked
// SUPERSEDED (retained forever, supersededByRunId/-EntryId recorded);
// identical re-extractions leave the existing entry unchanged; dispositioned
// entries are NEVER touched (freeze discipline).
model MeetingExtractionRun {
  id              Int       @id @default(autoincrement())
  meetingId       Int
  bidId           Int
  analysisVersion Int // Meeting.analysisVersion this run's analysis produced
  // INITIAL | RERUN — recorded for the audit trail
  trigger         String
  // PREVIEWED | APPLIED | DISCARDED
  status          String    @default("PREVIEWED")
  // full parsed MeetingAnalysis JSON for PREVIEWED runs (needed to apply);
  // cleared to "{}" after apply/discard to avoid unbounded growth
  analysisJson    String    @default("{}")
  // bounded diff summary: {"toAdd": n, "unchanged": n, "toSupersede": n,
  // "merged": n, "preservedDispositioned": n} + per-type counts + a bounded
  // outcomes list ({outcome, entryId?, draftIndex?, entryType}) — ids/counts
  // only, never entry text
  previewJson     String    @default("{}")
  createdBy       String?
  createdAt       DateTime  @default(now())
  appliedBy       String?
  appliedAt       DateTime?

  meeting           Meeting                @relation(fields: [meetingId], references: [id], onDelete: Restrict)
  bid               Bid                    @relation(fields: [bidId], references: [id], onDelete: Restrict)
  entries           MeetingRegisterEntry[]
  supersededEntries MeetingRegisterEntry[] @relation("RegisterEntrySupersededByRun")

  @@index([meetingId, createdAt])
  @@index([bidId])
}

// Immutable published-minutes snapshot (R2 rule 9). Revision 0 is the first
// publication; an amendment appends revision n+1 with supersedesRevisionId
// set-once. NO update or delete path exists at any layer. Publication is
// gated: every extracted register entry must be dispositioned first.
model MeetingMinutesRevision {
  id                   Int      @id @default(autoincrement())
  meetingId            Int
  bidId                Int
  revisionIndex        Int      @default(0)
  // frozen snapshot: {summary, keyDecisions, openIssues, redFlags,
  // participants, registerEntries: [{id, entryType, reviewState,
  // normalizedText, sourceCitation, linkedTrackedItemId}],
  // correctionCount, analysisVersion}
  contentJson          String
  publishedBy          String // REQUIRED session actor
  publishedAt          DateTime @default(now())
  amendmentReason      String? // REQUIRED for revisionIndex > 0 (service-enforced)
  supersedesRevisionId Int?     @unique // self-FK, set-once, SetNull
  createdAt            DateTime @default(now())

  meeting            Meeting                 @relation(fields: [meetingId], references: [id], onDelete: Restrict)
  bid                Bid                     @relation(fields: [bidId], references: [id], onDelete: Restrict)
  supersedesRevision MeetingMinutesRevision? @relation("MinutesSupersedes", fields: [supersedesRevisionId], references: [id], onDelete: SetNull)
  supersededBy       MeetingMinutesRevision? @relation("MinutesSupersedes")

  @@unique([meetingId, revisionIndex])
  @@index([bidId])
}
