# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example
!.env.local.example
!sidecar/.env.example
!gpu-worker/.env.example
# Phase R2 — runtime/env/ tier templates (placeholders only, safe to commit)
!runtime/env/*.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/app/generated/prisma

# sqlite
*.db
*.db-journal

# uploaded files
/uploads/

# sidecar python
/sidecar/.venv/
/sidecar/__pycache__/
/sidecar/**/__pycache__/

# standalone Meeting Intelligence worker
/meeting-worker/**/__pycache__/
/meeting-worker/run/

# Claude Code: shared config (settings.json, rules/, skills/, agents/, hooks/)
# is committed; local-only state stays ignored.
.claude/settings.local.json
.claude/worktrees/

# Playwright e2e artifacts (e2e/ suite — see playwright.config.ts)
/test-results/
/playwright-report/
