# Placeholder values only. Never commit a real worker token.
MEETING_WORKER_BASE_URL=http://127.0.0.1:3000
MEETING_WORKER_TOKEN=replace-with-a-local-development-token
MEETING_WORKER_ID=meeting-python-fixture-local
MEETING_WORKER_PROCESSOR=deterministic_fixture

MEETING_WORKER_POLL_SECONDS=10
MEETING_WORKER_HEARTBEAT_SECONDS=240
MEETING_WORKER_REQUEST_TIMEOUT_SECONDS=30
MEETING_WORKER_REQUEST_ATTEMPTS=3
MEETING_WORKER_BACKOFF_INITIAL_SECONDS=1
MEETING_WORKER_BACKOFF_MAX_SECONDS=60
MEETING_WORKER_MAX_MEDIA_BYTES=2147483648
MEETING_WORKER_SCRATCH_DIR=run
MEETING_WORKER_LOG_LEVEL=INFO

