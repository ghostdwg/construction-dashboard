{# Module OPS6 (Phase 2) — cumulative consultant-stream report.
   US-Letter portrait. Rendered with autoescape=True: every field below is
   user-typed data and renders as text, never markup. Logic-free — totals
   are computed in consultant_stream_pdf.summarize_stream(). #}
<!DOCTYPE html>
<html>
<head>
<meta charset="utf-8">
<style>
  @page { size: Letter; margin: 0.75in 0.7in; @bottom-right { content: "Page " counter(page) " of " counter(pages); font-size: 8pt; color: #667; } }
  body { font-family: Helvetica, Arial, sans-serif; font-size: 9.5pt; color: #16202e; }
  h1 { font-size: 20pt; margin: 0 0 4pt; }
  h2 { font-size: 12pt; border-bottom: 1.5pt solid #16202e; padding-bottom: 2pt; margin: 14pt 0 6pt; }
  .cover { text-align: center; padding-top: 2.2in; page-break-after: always; }
  .cover .sub { color: #445; font-size: 11pt; margin-top: 6pt; }
  .cover .meta { color: #667; font-size: 9pt; margin-top: 22pt; line-height: 1.7; }
  .rpthead { background: #eef1f6; padding: 5pt 7pt; margin: 10pt 0 4pt; border-left: 3pt solid #2d4a7a; }
  .rpthead .vendor { font-weight: bold; font-size: 11pt; }
  .rpthead .cat { color: #445; font-size: 8.5pt; }
  .voided { color: #a02020; font-weight: bold; }
  table { width: 100%; border-collapse: collapse; margin: 4pt 0 8pt; }
  th { text-align: left; font-size: 8pt; text-transform: uppercase; color: #556; border-bottom: 1pt solid #99a; padding: 2pt 4pt; }
  td { vertical-align: top; border-bottom: 0.5pt solid #ccd; padding: 4pt; font-size: 9pt; }
  .state { font-size: 7.5pt; font-weight: bold; text-transform: uppercase; color: #2d4a7a; }
  .dates { color: #445; font-size: 8.5pt; }
  .resp { background: #f4f7fb; padding: 3pt 5pt; margin-top: 3pt; font-size: 8.5pt; }
  .resp .by { color: #667; font-size: 7.5pt; }
  .dispo { font-size: 8.5pt; color: #334; margin-top: 2pt; }
  .dispo .cur { font-weight: bold; }
  .summary td { border: none; padding: 3pt 6pt; }
  .footer { margin-top: 18pt; color: #778; font-size: 8pt; }
</style>
</head>
<body>

  {# ── Cover ─────────────────────────────────────────────────────────── #}
  <div class="cover">
    <h1>{{ payload.projectName }}</h1>
    <div class="sub">Consultant Stream Report</div>
    <div class="sub">{{ payload.rangeLabel }}</div>
    <div class="meta">
      Generated by {{ payload.generatedBy or "—" }} · {{ payload.generatedAt }}<br>
      {{ payload.reports | length }} consultant report{{ "s" if payload.reports | length != 1 else "" }} ·
      {{ totals.observations }} observation{{ "s" if totals.observations != 1 else "" }}<br>
      Filters: {{ payload.filterSummary }}
    </div>
  </div>

  {# ── Per-report sections, chronological ────────────────────────────── #}
  {% for report in payload.reports %}
  <div class="rpthead">
    <span class="vendor">{{ report.vendorName }}</span>
    {% if report.reportNumber %} {{ report.reportNumber }}{% endif %}
    {% if report.title %} — {{ report.title }}{% endif %}
    {% if report.status == "VOIDED" %} <span class="voided">VOIDED</span>{% endif %}
    <div class="cat">{{ report.categoryLabel }} · {{ report.reportDate | date_fmt }}{% if report.revisionCount > 1 %} · Rev {{ report.revisionCount - 1 }}{% endif %}</div>
  </div>

  <table>
    <thead><tr>
      <th style="width:44%">Observation</th>
      <th style="width:12%">Status</th>
      <th style="width:18%">Dates</th>
      <th style="width:26%">Register / Response / Disposition</th>
    </tr></thead>
    <tbody>
    {% for obs in report.observations %}
      <tr>
        <td>
          {{ obs.observationText }}
          {% if obs.sourcePage %}<div class="dates">{{ obs.sourcePage }}</div>{% endif %}
        </td>
        <td><span class="state">{{ obs.state | replace("_", " ") }}</span>
          {% if obs.dismissedReason %}<div class="dates">{{ obs.dismissedReason }}</div>{% endif %}
        </td>
        <td class="dates">
          Consultant target {{ obs.consultantTargetDate | date_fmt }}<br>
          Our due date {{ obs.registerItem.dueDate | date_fmt if obs.registerItem else "—" }}
        </td>
        <td>
          {% if obs.registerItem %}
            Item #{{ obs.registerItem.id }} — {{ obs.registerItem.title }}
            <span class="state">{{ obs.registerItem.status | replace("_", " ") }}</span>
            {% if obs.registerItem.responseRef %}
              <div class="resp">Response under Item #{{ obs.registerItem.id }} above.</div>
            {% elif obs.registerItem.formalResponse %}
              <div class="resp">{{ obs.registerItem.formalResponse }}
                <div class="by">Response by {{ obs.registerItem.formalResponseBy or "—" }} · {{ obs.registerItem.formalResponseAt | date_fmt }}</div>
              </div>
            {% endif %}
          {% else %}—{% endif %}
          {% for d in obs.dispositions %}
            <div class="dispo{% if loop.last %} cur{% endif %}">
              {{ d.dispositionType }}{% if loop.last %} (CURRENT){% endif %} —
              {{ d.disposedBy }} · {{ d.disposedAt | date_fmt }}
              {% if d.dispositionText %}<br>{{ d.dispositionText }}{% endif %}
            </div>
          {% endfor %}
        </td>
      </tr>
    {% endfor %}
    </tbody>
  </table>
  {% endfor %}

  {# ── Summary ───────────────────────────────────────────────────────── #}
  <h2>Summary</h2>
  <table class="summary">
    <tr><td>Observations total</td><td>{{ totals.observations }}</td>
        <td>Open (entered)</td><td>{{ totals.open }}</td></tr>
    <tr><td>Accepted — new items</td><td>{{ totals.acceptedNew }}</td>
        <td>Accepted — linked</td><td>{{ totals.acceptedLinked }}</td></tr>
    <tr><td>Dismissed (kept on record)</td><td>{{ totals.dismissed }}</td>
        <td>Items with a formal response</td><td>{{ totals.responded }}</td></tr>
    <tr><td>Disposed — approve</td><td>{{ totals.disposedApprove }}</td>
        <td>Disposed — reject</td><td>{{ totals.disposedReject }}</td></tr>
    <tr><td>Disposed — defer</td><td>{{ totals.disposedDefer }}</td>
        <td>Disposed — void</td><td>{{ totals.disposedVoid }}</td></tr>
  </table>

  <div class="footer">
    {{ payload.projectName }} · Consultant Stream Report · generated {{ payload.generatedAt }} ·
    filters: {{ payload.filterSummary }} · {{ totals.observations }} observations
  </div>

</body>
</html>
