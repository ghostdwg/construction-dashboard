# ── AI ───────────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ── Transcription ─────────────────────────────────────────────────────────────
# Legacy processing is disabled unless this exact gate is true in both app and sidecar.
LEGACY_TRANSCRIPTION_ENABLED=false
# Separate AssemblyAI break-glass permission. Never an automatic fallback.
LEGACY_TRANSCRIPTION_EXTERNAL_ENABLED=false
# AssemblyAI credential — inert unless both gates above permit external use.
ASSEMBLYAI_API_KEY=

# ── GPU Worker (WhisperX via Tailscale) ───────────────────────────────────────
# Tailscale IP of the GPU PC running whisperx_server.py
# Example: http://100.x.x.x:8002
WHISPERX_URL=
# Must match WHISPERX_API_KEY set when installing the GPU worker service
WHISPERX_API_KEY=

# ── Sidecar auth ──────────────────────────────────────────────────────────────
# Shared secret for X-API-Key header. Leave blank in dev (allows all requests).
# Must match SIDECAR_API_KEY in .env.local
SIDECAR_API_KEY=
