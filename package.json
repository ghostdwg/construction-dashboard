{
  "name": "construction-dashboard",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:sidecar": "cd sidecar && .venv\\Scripts\\uvicorn.exe main:app --host 127.0.0.1 --port 8001 --reload",
    "dev:all": "npx concurrently \"npm run dev\" \"npm run dev:sidecar\"",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "migrate:turso": "node scripts/apply-turso-migrations.mjs",
    "migrate:turso:status": "node scripts/apply-turso-migrations.mjs --dry-run",
    "validate:replay": "node scripts/replay-validation.mjs",
    "validate:staging": "node scripts/validate-staging.mjs",
    "lint:migrations": "node scripts/migration-lint.mjs",
    "lint:migrations:all": "node scripts/migration-lint.mjs --since=all",
    "guardrails:check": "GUARDRAILS_MODE=enforce governance/guardrails/run-p0-checks.sh",
    "run:cycle": "tsx scripts/run-cycle.ts",
    "run:cycle:list": "tsx scripts/run-cycle.ts --list",
    "seed:market-sources": "tsx scripts/seed-market-sources.ts",
    "seed:market-sources:dry-run": "tsx scripts/seed-market-sources.ts --dry-run",
    "verify:market-sources": "tsx scripts/verify-market-sources.ts",
    "verify:market-sources:dry-run": "tsx scripts/verify-market-sources.ts --dry-run",
    "activation:report": "tsx scripts/activation-report.ts",
    "activation:report:json": "tsx scripts/activation-report.ts --json",
    "forecast:gate-check": "tsx scripts/forecast-gate-check.ts",
    "forecast:gate-check:json": "tsx scripts/forecast-gate-check.ts --json",
    "backfill:entity-graph": "tsx scripts/backfill-entity-graph.ts",
    "backfill:entity-graph:dry-run": "tsx scripts/backfill-entity-graph.ts --dry-run",
    "backfill:entity-graph:report-only": "tsx scripts/backfill-entity-graph.ts --report-only",
    "backfill:entity-graph:rollback": "tsx scripts/rollback-entity-backfill.ts",
    "backfill:project-graph": "tsx scripts/backfill-project-graph.ts",
    "backfill:project-graph:dry-run": "tsx scripts/backfill-project-graph.ts --dry-run",
    "backfill:project-graph:report-only": "tsx scripts/backfill-project-graph.ts --report-only",
    "backfill:project-graph:rollback": "tsx scripts/rollback-project-backfill.ts",
    "storage:inventory": "tsx scripts/storage-inventory-backfill.ts",
    "storage:inventory:reverse": "tsx scripts/storage-inventory-backfill.ts --reverse"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.82.0",
    "@auth/prisma-adapter": "^2.11.1",
    "@libsql/client": "^0.17.2",
    "@prisma/adapter-libsql": "^7.6.0",
    "@prisma/client": "^7.6.0",
    "@react-email/components": "^1.0.12",
    "@tanstack/react-table": "^8.21.3",
    "@tanstack/react-virtual": "^3.13.23",
    "bcryptjs": "^3.0.3",
    "exceljs": "^4.4.0",
    "immer": "^11.1.4",
    "lucide-react": "^1.8.0",
    "mammoth": "^1.12.0",
    "next": "^16.2.4",
    "next-auth": "^5.0.0-beta.30",
    "nodemailer": "^7.0.7",
    "pdfjs-dist": "^5.6.205",
    "prisma": "^7.6.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-hotkeys-hook": "^5.2.4",
    "recharts": "^3.8.1",
    "resend": "^6.10.0",
    "xmlbuilder2": "^4.0.3",
    "zod": "^4.4.2",
    "zustand": "^5.0.12"
  },
  "prisma": {
    "seed": "ts-node --compiler-options {\"module\":\"CommonJS\"} prisma/seed.ts"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/ui": "^4.1.5",
    "concurrently": "^9",
    "eslint": "^9",
    "eslint-config-next": "16.2.2",
    "tailwindcss": "^4",
    "ts-node": "^10.9.2",
    "tsx": "^4.22.3",
    "typescript": "^5",
    "vite": "^6",
    "vitest": "^4.1.5"
  }
}
