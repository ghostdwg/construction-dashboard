# ── runtime/env/local.env.example ───────────────────────────────────────────
# Laptop development tier (APP_ENV=local).
#
# Usage:
#   Copy to construction-dashboard/.env.local (gitignored) and fill in.
#   Never commit the resulting .env.local.
#
# All values below are PLACEHOLDERS. Generate real values locally; never paste
# staging or production values into this tier.

# ── Tier discriminator ──────────────────────────────────────────────────────
APP_ENV=local
NODE_ENV=development

# ── Database ────────────────────────────────────────────────────────────────
# Local SQLite via PrismaLibSql adapter. Same adapter as Turso; no network DB.
DATABASE_URL=file:./dev.db
DATABASE_AUTH_TOKEN=

# ── Auth ────────────────────────────────────────────────────────────────────
# AUTH_DISABLED=true is PERMITTED in local tier only.
# When true, every request gets a fake admin session. Solo-dev escape hatch.
AUTH_DISABLED=true

# Generate locally: openssl rand -hex 32
AUTH_SECRET=<generate-with-openssl-rand-hex-32>

# Local Next.js dev server URL.
NEXTAUTH_URL=http://localhost:3000
APP_URL=http://localhost:3000

# ── Encryption keys ─────────────────────────────────────────────────────────
# Optional in local tier (plaintext settings allowed when AUTH_DISABLED=true).
# Generate locally if you want to exercise the encryption path:
#   openssl rand -hex 32
SETTINGS_ENCRYPTION_KEY=
CREDENTIAL_MASTER_KEY=

# ── Inter-service ───────────────────────────────────────────────────────────
# Laptop sidecar runs at 127.0.0.1:8001 via npm run dev:sidecar.
SIDECAR_URL=http://127.0.0.1:8001
# Empty = sidecar dev mode (permissive). Set a value to exercise the auth path.
SIDECAR_API_KEY=
SIDECAR_CALLBACK_TOKEN=

# Worker is typically OFF on the laptop. Leave empty.
WORKER_TOKEN=

# ── AI providers ────────────────────────────────────────────────────────────
# Use a low-spend-cap dev key from the GroundWorX-dev 1Password vault.
ANTHROPIC_API_KEY=sk-ant-<dev-low-limit-key>

# GPU OFF locally by default. Meeting routes degrade to "GPU disabled".
# Optionally point at thebeast over Tailscale for end-to-end smoke testing.
WHISPERX_URL=
WHISPERX_API_KEY=
OLLAMA_URL=
OLLAMA_MODEL=

# AssemblyAI cloud fallback. Leave empty in local tier.
ASSEMBLYAI_API_KEY=

# ── Stub-mode flags ─────────────────────────────────────────────────────────
# Useful when you want AI features to return stub content instead of calling
# Anthropic. Saves API spend during UI work.
ADDENDUM_STUB_MODE=false
BRIEF_STUB_MODE=false
GAP_STUB_MODE=false

# ── DB-overridable settings (canonical path: /settings UI) ──────────────────
# These env values act as fallback if the corresponding AppSetting row is not
# present. In local tier they are typically left empty and the operator sets
# them via the /settings UI when testing the corresponding feature.
#
# RESEND_API_KEY=
# RESEND_FROM_EMAIL=
# SMTP_HOST=
# SMTP_PORT=
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM_EMAIL=
# SMTP_FROM_NAME=
# ESTIMATOR_NAME=
# ESTIMATOR_EMAIL=
# PROCORE_CLIENT_ID=
# PROCORE_CLIENT_SECRET=
# PROCORE_COMPANY_ID=
# PROCORE_WEBHOOK_URL=
# PROCORE_WEBHOOK_SECRET=
