# ── runtime/env/production.env.example ──────────────────────────────────────
# Production tier (APP_ENV=production) on host `superglitch`.
#
# Usage:
#   The real /opt/neuroglitch/.env file on superglitch is the authority.
#   Source real values from the GroundWorX-prod 1Password vault.
#   NEVER copy this file with real values to the laptop.
#   NEVER edit /opt/neuroglitch/.env without recording the change in the
#   ops log AND rotating the affected secret if it is being replaced.
#
# All values below are PLACEHOLDERS.

# ── Tier discriminator ──────────────────────────────────────────────────────
APP_ENV=production
NODE_ENV=production

# ── Database ────────────────────────────────────────────────────────────────
# Production Turso DB. The Phase R5 Zod fence will require the DB name to
# match the production-prod pattern.
DATABASE_URL=libsql://<prod-db-name>.turso.io?authToken=<paste-from-1password>
DATABASE_AUTH_TOKEN=<paste-from-1password>

# ── Auth ────────────────────────────────────────────────────────────────────
# AUTH_DISABLED MUST be false in production. The Phase R5 fence refuses to
# start if AUTH_DISABLED=true when APP_ENV != local.
AUTH_DISABLED=false

# Generate annually: openssl rand -hex 32
# Rotation invalidates all sessions; document the rotation window in advance.
AUTH_SECRET=<production-only-secret>

# Canonical production hostname.
NEXTAUTH_URL=https://groundworx.neuroglitch.ai
APP_URL=https://groundworx.neuroglitch.ai

# ── Encryption keys ─────────────────────────────────────────────────────────
# CRITICAL keys. Losing SETTINGS_ENCRYPTION_KEY = all AppSetting credentials
# unrecoverable. Losing CREDENTIAL_MASTER_KEY = all IntegrationCredential
# rows unrecoverable. Back both up offline before deploy.
#
# Rotation: only on suspected compromise. Each rotation requires DB-wide
# re-encryption tooling (separate runbook). Treat as HSM root keys.
SETTINGS_ENCRYPTION_KEY=<production-only-32-hex-chars-NEVER-LEAVES-PROD-VAULT>
CREDENTIAL_MASTER_KEY=<production-only-32-hex-chars-NEVER-LEAVES-PROD-VAULT>

# ── Inter-service ───────────────────────────────────────────────────────────
# Sidecar reached via Compose internal DNS in the neuroglitch network.
SIDECAR_URL=http://sidecar:8001
SIDECAR_API_KEY=<production-only-shared-secret>
SIDECAR_CALLBACK_TOKEN=<production-only>

# Worker authenticates to the app.
WORKER_TOKEN=<production-only>

# ── AI providers ────────────────────────────────────────────────────────────
# Production Anthropic key. Watch token spend; cost gate via /settings.
ANTHROPIC_API_KEY=sk-ant-<production-key>

# GPU worker on thebeast over Tailscale. The IP is private (non-secret) but
# remains a placeholder here per the placeholders-only rule.
WHISPERX_URL=http://<gpu-node-tailscale-ip>:8002
WHISPERX_API_KEY=<production-only>

# Ollama on thebeast. No authentication on the tailnet today; flagged as a
# Phase F'+ hardening item.
OLLAMA_URL=http://<gpu-node-tailscale-ip>:11434
OLLAMA_MODEL=qwen2.5:14b

# AssemblyAI fallback. Set only if the operator deliberately enables the
# cloud-transcription fallback path.
ASSEMBLYAI_API_KEY=

# ── Stub-mode flags ─────────────────────────────────────────────────────────
# MUST be false in production.
ADDENDUM_STUB_MODE=false
BRIEF_STUB_MODE=false
GAP_STUB_MODE=false

# ── DB-overridable settings (canonical path: /settings UI) ──────────────────
# Production secrets for these are encrypted at rest in the AppSetting table.
# The env values below act as fallback only if the DB row is unset. The
# operator's canonical surface for changing them is the /settings UI.
#
# RESEND_API_KEY=<production-resend-key>
# RESEND_FROM_EMAIL=rfq@<your-domain>
# SMTP_HOST=
# SMTP_PORT=
# SMTP_USER=
# SMTP_PASSWORD=
# ESTIMATOR_NAME=
# ESTIMATOR_EMAIL=
# PROCORE_CLIENT_ID=<prod-tenant>
# PROCORE_CLIENT_SECRET=<prod-tenant-secret>
# PROCORE_COMPANY_ID=<prod-company-id>
# PROCORE_WEBHOOK_URL=https://groundworx.neuroglitch.ai/api/procore/webhook
# PROCORE_WEBHOOK_SECRET=<production-only>
