# ── runtime/env/staging.env.example ─────────────────────────────────────────
# Staging tier (APP_ENV=staging) on host `superglitch`.
#
# Usage:
#   Copy to /opt/neuroglitch/.env.staging on superglitch and fill in.
#   Never copy this file to the laptop with real values.
#   Source real values from the GroundWorX-staging 1Password vault.
#
# All values below are PLACEHOLDERS.

# ── Tier discriminator ──────────────────────────────────────────────────────
APP_ENV=staging
NODE_ENV=production

# ── Database ────────────────────────────────────────────────────────────────
# Isolated Turso DB for staging. NEVER reuse the prod DB.
# DB name must contain "staging" so the Phase R5 Zod fence accepts it.
DATABASE_URL=libsql://<staging-db-name>.turso.io?authToken=<paste-from-1password>
DATABASE_AUTH_TOKEN=<paste-from-1password>

# ── Auth ────────────────────────────────────────────────────────────────────
# AUTH_DISABLED MUST be false in staging. The Phase R5 fence refuses to start
# if AUTH_DISABLED=true when APP_ENV != local.
AUTH_DISABLED=false

# Generate per-tier: openssl rand -hex 32
# Staging AUTH_SECRET is separate from prod; no reuse.
AUTH_SECRET=<staging-only-secret>

# Canonical staging hostname.
NEXTAUTH_URL=https://staging.groundworx.neuroglitch.ai
APP_URL=https://staging.groundworx.neuroglitch.ai

# ── Encryption keys ─────────────────────────────────────────────────────────
# REQUIRED in staging. Both keys must be set to non-empty values >= 32 chars.
# Separate per tier; staging keys never travel to prod or laptop.
SETTINGS_ENCRYPTION_KEY=<staging-only-32-hex-chars>
CREDENTIAL_MASTER_KEY=<staging-only-32-hex-chars>

# ── Inter-service ───────────────────────────────────────────────────────────
# Sidecar reached via Compose internal DNS. Container name resolves over the
# neuroglitch-staging_default network.
SIDECAR_URL=http://sidecar:8001
SIDECAR_API_KEY=<staging-only-shared-secret>
SIDECAR_CALLBACK_TOKEN=<staging-only>

# Worker authenticates to the app with this token.
WORKER_TOKEN=<staging-only>

# ── AI providers ────────────────────────────────────────────────────────────
# Staging Anthropic key (use a low-limit key from GroundWorX-staging vault).
ANTHROPIC_API_KEY=sk-ant-<staging-key>

# GPU worker on thebeast over Tailscale. The IP is private (non-secret) but
# remains a placeholder here per the placeholders-only rule.
WHISPERX_URL=http://<gpu-node-tailscale-ip>:8002
WHISPERX_API_KEY=<staging-or-shared-with-prod-via-Tailscale-ACL>

# Ollama on thebeast. Currently has NO authentication on the tailnet.
OLLAMA_URL=http://<gpu-node-tailscale-ip>:11434
OLLAMA_MODEL=qwen2.5:14b

# AssemblyAI fallback (optional). Leave empty to disable fallback.
ASSEMBLYAI_API_KEY=

# ── Stub-mode flags ─────────────────────────────────────────────────────────
# Should be FALSE in staging so AI behavior matches production.
ADDENDUM_STUB_MODE=false
BRIEF_STUB_MODE=false
GAP_STUB_MODE=false

# ── DB-overridable settings (canonical path: /settings UI) ──────────────────
# Operator may set these via the /settings UI after first deploy. The env
# fallback is documented but UI is the preferred surface.
#
# RESEND_API_KEY=<staging-resend-key>
# RESEND_FROM_EMAIL=rfq-staging@<your-domain>
# SMTP_HOST=
# SMTP_PORT=
# SMTP_USER=
# SMTP_PASSWORD=
# ESTIMATOR_NAME=
# ESTIMATOR_EMAIL=
# PROCORE_CLIENT_ID=<sandbox-tenant>
# PROCORE_CLIENT_SECRET=<sandbox-tenant-secret>
# PROCORE_COMPANY_ID=<sandbox-company-id>
# PROCORE_WEBHOOK_URL=https://staging.groundworx.neuroglitch.ai/api/procore/webhook
# PROCORE_WEBHOOK_SECRET=<staging-only>
