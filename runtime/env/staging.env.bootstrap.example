# ──────────────────────────────────────────────────────────────────────────────
#  runtime/env/staging.env.bootstrap.example
#  First-activation env template for the staging tier. Phase R6.
# ──────────────────────────────────────────────────────────────────────────────
#
#  Usage:
#    Copy this template to /opt/neuroglitch/.env.staging on host `superglitch`
#    and fill in real values from the GroundWorX-staging 1Password vault.
#
#    chmod 600 /opt/neuroglitch/.env.staging
#    chown root:root /opt/neuroglitch/.env.staging
#
#  All values below are PLACEHOLDERS. NEVER commit this file with real values.
#
#  This is the BOOTSTRAP variant of runtime/env/staging.env.example. It
#  documents safer defaults for the first staging activation — outbound
#  email disabled, AssemblyAI fallback disabled, Procore pointing at a
#  sandbox tenant (or empty). Once staging is stable, the operator can
#  enable additional features.
#
#  PRE-FILL CHECKLIST (operator does these BEFORE populating values):
#    [ ] Phase R5 deployed to production successfully (APP_ENV enforced).
#    [ ] GroundWorX-staging 1Password vault provisioned.
#    [ ] groundworx-staging-ghostdwg.turso.io DB created via Turso CLI.
#    [ ] Per-tier secrets generated:
#          AUTH_SECRET, SETTINGS_ENCRYPTION_KEY, CREDENTIAL_MASTER_KEY,
#          SIDECAR_API_KEY, SIDECAR_CALLBACK_TOKEN, WORKER_TOKEN.
#          NONE of these should equal the production value.
#    [ ] Each secret stored in the GroundWorX-staging vault.
#    [ ] Anthropic key with a low spend cap (separate from prod).
#    [ ] /opt/neuroglitch/storage-staging exists on host with correct perms.
#
#  See runtime/runbooks/staging-first-activation.md for the full procedure.
#
# ──────────────────────────────────────────────────────────────────────────────


# ── Tier discriminator ──────────────────────────────────────────────────────
# REQUIRED. Phase R5 Zod schema refuses to start if missing or wrong.
APP_ENV=staging
NODE_ENV=production


# ── Database ────────────────────────────────────────────────────────────────
# Staging-only Turso DB. NEVER reuse the production DATABASE_URL.
# Token in 1Password: GroundWorX-staging → Turso Staging Token.
DATABASE_URL=libsql://<staging-db-name>.turso.io?authToken=<paste-from-1password>
DATABASE_AUTH_TOKEN=<paste-from-1password>


# ── Auth ────────────────────────────────────────────────────────────────────
# AUTH_DISABLED=false ENFORCED for staging (per Phase R5 governance, not yet
# code-enforced; operator hygiene until tier-fence lands).
AUTH_DISABLED=false

# Generate freshly for staging: openssl rand -hex 32
# MUST be different from production AUTH_SECRET.
AUTH_SECRET=<staging-only-32-byte-hex-secret>

# Canonical staging hostname. Phase R5 instrumentation banner shows this.
# Phase 6.b Caddy route directs staging.groundworx.neuroglitch.ai here.
NEXTAUTH_URL=https://staging.groundworx.neuroglitch.ai
APP_URL=https://staging.groundworx.neuroglitch.ai


# ── Encryption keys (CRITICAL — per-tier, no sharing) ───────────────────────
# Losing SETTINGS_ENCRYPTION_KEY = all staging AppSetting credentials lost.
# Losing CREDENTIAL_MASTER_KEY    = all staging IntegrationCredential rows lost.
# Both kept in GroundWorX-staging 1Password vault. NEVER copy prod's values.
SETTINGS_ENCRYPTION_KEY=<staging-only-32-byte-hex-secret>
CREDENTIAL_MASTER_KEY=<staging-only-32-byte-hex-secret>


# ── Inter-service auth (per-tier, no sharing) ───────────────────────────────
# Sidecar in staging reached at http://sidecar:8001 (Compose internal DNS
# within neuroglitch-staging_neuroglitch network).
SIDECAR_URL=http://sidecar:8001
SIDECAR_API_KEY=<staging-only-shared-secret>
SIDECAR_CALLBACK_TOKEN=<staging-only-shared-secret>

# Worker authenticates to staging app with this token. MUST be distinct from
# production WORKER_TOKEN — otherwise a misrouted request could authenticate
# at the wrong tier.
WORKER_TOKEN=<staging-only-shared-secret>


# ── AI providers ────────────────────────────────────────────────────────────
# Anthropic: separate staging key (low spend cap recommended) to prevent
# prod budget pressure from staging experimentation.
ANTHROPIC_API_KEY=sk-ant-<staging-low-limit-key>

# GPU plane on thebeast (shared between tiers — single physical GPU node).
# Tailscale IP. WHISPERX_API_KEY may be shared with production or
# per-tier-tagged depending on the GPU worker's accept policy.
WHISPERX_URL=http://<gpu-node-tailscale-ip>:8002
WHISPERX_API_KEY=<staging-or-shared-via-Tailscale-ACL>

# Ollama on thebeast. Currently NO authentication on the tailnet (flagged
# as Phase F'+ hardening item per production runtime assessment).
OLLAMA_URL=http://<gpu-node-tailscale-ip>:11434
OLLAMA_MODEL=qwen2.5:14b


# ── Safe-by-default disables (bootstrap mode) ───────────────────────────────
# AssemblyAI cloud transcription fallback. EMPTY in first activation so the
# staging stack doesn't silently fall back to a paid cloud service if GPU
# transcription fails. Operator enables explicitly when ready.
ASSEMBLYAI_API_KEY=

# Outbound RFQ emails via Resend. EMPTY in first activation — staging must
# NEVER email real subcontractors. Once Resend sandbox mode is configured
# (or a staging-only sender domain is set up), this can be populated.
RESEND_API_KEY=

# Procore integration. EMPTY in first activation — points at no Procore
# tenant. When ready, configure a Procore SANDBOX tenant separate from prod.
PROCORE_CLIENT_ID=
PROCORE_CLIENT_SECRET=
PROCORE_COMPANY_ID=
PROCORE_WEBHOOK_URL=https://staging.groundworx.neuroglitch.ai/api/procore/webhook
PROCORE_WEBHOOK_SECRET=


# ── Stub-mode flags (set true initially for safer first-activation smoke) ───
# When TRUE, the corresponding AI feature returns canned content instead of
# calling Anthropic. Useful for first activation to validate the platform
# wiring without burning Anthropic tokens or risking prompt regressions.
# Operator flips to FALSE after baseline smoke passes.
ADDENDUM_STUB_MODE=true
BRIEF_STUB_MODE=true
GAP_STUB_MODE=true


# ── DB-overridable settings (canonical path: /settings UI after first boot) ─
# These DB-backed settings have env fallback. For first activation, leave
# empty and configure via /settings UI once staging is accessible. Examples:
# RESEND_FROM_EMAIL, ESTIMATOR_NAME, ESTIMATOR_EMAIL, SMTP_*.
